---
import Boton from "@components/Boton.astro";
import Layout from "@layouts/Layout.astro";
import LayoutMenu from "@layouts/LayoutMenu.astro";
---

<LayoutMenu title="Pàgina no encontrada | IES Calvià Voley Tournament">
    <section class="max-w-6xl h-auto grid grid-cols-2 grid-rows-1 gap-5 place-items-center m-auto">
        <img src="img/404.png" alt="error 404"/>
        <div class="flex flex-col items-center justify-center">
            <h4 class="text-accent text-4xl text-center">PÁGINA NO ENCONTRADA</h4>
            <p class="text-2xl text-center text-blanco">¡Hola! Lo sentimos, pero no pudimos encontrar lo que buscabas. Verifica que la dirección URL sea correcta.</p>
            <Boton href="/"> Volver al inicio</Boton>
        </div>
    </section>
</Layout>

