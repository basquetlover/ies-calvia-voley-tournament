---
import CrearEdicion from "@components/panel/edicions/CrearEdicion";
import EditEdicion from "@components/panel/edicions/EditEdicion";
import PreviewEdicion from "@components/panel/edicions/PreviewEdicion";
import LayoutPanel from "@layouts/LayoutPanel.astro";

const url = new URL(Astro.request.url);
const torneoID = url.searchParams.get('torneoID');
const equipoID = url.searchParams.get('equipoID');
const accion = url.searchParams.get('accio');

let title = "Informació Edició"

if(accion === "editar"){
    title = "Modificar Edició"
}

console.log("Configuración página", torneoID, equipoID, accion)
---

<LayoutPanel title={title}>
    {
        accion === "ver" && (
            <PreviewEdicion torneoID={torneoID} client:load />
        )
    }
    {   
        accion === "editar" && (
            <EditEdicion torneoID={torneoID} client:load />
        )
    }
    {
        accion === "crear" && (
            <CrearEdicion torneoID={torneoID} client:load/>
        )
    }
</LayoutPanel>