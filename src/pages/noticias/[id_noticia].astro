---
import { supabaseAdmin } from "../../lib/supabase";



import LayoutMenu from "@layouts/LayoutMenu.astro";
// Tipo explícito para las propiedades esperadas en `Astro.props`

// Tipo explícito para las propiedades esperadas en `Astro.props`
type AdministradorProps = {
    id_noticia: string;
    titulo: string;
    
};



// Genera rutas dinámicas
export async function getStaticPaths() {
  // Consulta a la base de datos para obtener user_email y rango
  const { data, error } = await supabaseAdmin
    .from('Noticias')
    .select('id_noticia');

  if (error) {
    console.error('Error fetching administradores:', error.message);
    return { paths: [] };
  }

  // Genera las rutas dinámicas con datos adicionales
  const paths = data.map((equipo) => ({
    params: { id_noticia: equipo.id_noticia },
     // Pasamos rango como parte de los props
  }));

  return { paths };
}
const id_noticia = Astro.url.pathname.split('/').pop();

let titulo = 'Sin Nombre';
let fecha = "";
let category = "";
let cuerpo = "";
let id = "";
let imagen_noticia = "";

try {
  // Buscar el rango correspondiente al email en la tabla Administradores
  const { data: equipoData, error } = await supabaseAdmin
    .from('Noticias')
    .select('titulo, id, category, fecha, imagen_noticia, contenido')
    .eq('id_noticia', id_noticia)
    .single();

  if (error) {
    console.error(`Error al buscar nombre_equipo para ${id_noticia}:`, error.message);
  } else if (equipoData) {
    titulo = equipoData.titulo;
    fecha = equipoData.fecha
    category = equipoData.category;
    cuerpo = equipoData.contenido;
    imagen_noticia = equipoData.imagen_noticia;
    id = equipoData.id;
  }

  

} catch (err) {
  console.error('Error al obtener rango:', err);
}
---
<script>
  // Asegúrate de que el contenido de 'cuerpo' esté disponible aquí
  const textarea = document.getElementById("contenido-noticia") as HTMLInputElement;
  const contenido = textarea.value;
  // Selecciona el div con id 'output'
  
  const outputDiv = document.getElementById('output');

  // Asigna el contenido de 'cuerpo' al div
  if (outputDiv) {
      outputDiv.innerHTML = contenido;
  }
</script>

<LayoutMenu title=`${titulo} | IES Calvià Voley Tournament` descripcion="Noticia">
