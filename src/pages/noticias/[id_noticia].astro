---
import VerNoticia from "@components/panel/noticies/VerNoticia";
import { supabaseAdmin } from "../../lib/supabase";



import LayoutMenu from "@layouts/LayoutMenu.astro";
// Tipo explícito para las propiedades esperadas en `Astro.props`

// Tipo explícito para las propiedades esperadas en `Astro.props`
type AdministradorProps = {
    id_noticia: string;
    titulo: string;
    
};



// Genera rutas dinámicas

const id_noticia = Astro.url.pathname.split('/').pop();

let titulo = 'Sin Nombre';

let noticiaData = [];
try {
  // Buscar el rango correspondiente al email en la tabla Administradores
  const { data: noticiaDataDB, error } = await supabaseAdmin
    .from('Noticis')
    .select('*')
    .eq('slug', id_noticia)
    .single();

  if (error) {
    console.error(`Error al buscar nombre_noticia para ${id_noticia}:`, error.message);
  } else if (noticiaDataDB) {
    titulo = noticiaDataDB.titular;
    noticiaData = noticiaDataDB
  }

  

} catch (err) {
  console.error('Error al obtener rango:', err);
}
---


<LayoutMenu title=`${titulo} | IES Calvià Voley Tournament` descripcion="Noticia">
  {
    noticiaData && (
      <VerNoticia noticiaData={noticiaData} client:load />
    )
  }
  
</LayoutMenu>
