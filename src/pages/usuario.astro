                </svg>
            </span>
            <p>{usuario.email}</p>
    </div>
        {/* Contraseña */}
    <a href="/usuario/modificar-contrasena" class="w-full px-3 h-auto  flex flex-row gap-2 text-blanco items-center group cursor-pointer">
