                </svg>
            </span>
            <p class="text-5xl">············</p>
            <p class="text-gray-400 opacity-0 flex flex-row items-center place-content-center group-hover:opacity-100 transition-all duration-300">
                Modificar
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-gray-400" viewBox="0 -960 960 960">
                    <path d="m321-80-71-71 329-329-329-329 71-71 400 400L321-80Z"/>
                </svg>
            </p>
    </a>
        {/* Curso */}
    <div class="w-full px-3 h-auto rounded-lg text-base flex flex-row gap-2 text-blanco items-center">
            <span class="w-5 h-5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 -960 960 960">
                    <path fill="#E8EAED" d="M480-120 200-272v-240L40-600l440-240 440 240v320h-80v-276l-80 44v240L480-120Zm0-332 274-148-274-148-274 148 274 148Zm0 241 200-108v-151L480-360 280-470v151l200 108Zm0-241Zm0 90Zm0 0Z"/>
                </svg>

            </span>
            <p>{usuario.curso}</p>
    </div>

        {/* Equipo */}
     <div class="w-full px-3 h-auto rounded-lg text-base flex flex-row mt-2 gap-2 text-blanco items-center">
            <span class="w-5 h-5 rounded-full">
                <img src={escudo} alt="logo equipo" class="w-full h-full" />
            </span>
