---
import ControlAcces from "@components/ControlAcces.astro";

import LayoutUsuarioMenu from "@layouts/LayoutUsuarioMenu.astro";
import { supabaseAdmin } from "src/lib/supabase";
import { verificarSesion } from "src/lib/session";
import UserLogo from "@components/UserLogo.astro";

const usuario = await verificarSesion(Astro.request);
let equipo = "Sense Equip"
let escudo = "/img/escudos/sin-escudo-blanco.png"
let inscripcion = true;
let admin = false;
let profesor = false;
if(usuario){
    const usuario_nombre = usuario.nombre;
    const usuario_email = usuario.email;
    let acceso_inscripcion = false;
    
    let { data: AccesoInscripcion, error } = await supabaseAdmin
        .from('AccesoUsuarios')
        .select('acceso')
        .eq('pagina', '/usuario/inscripcion')
        .single();
    if(AccesoInscripcion){
        acceso_inscripcion = AccesoInscripcion.acceso;
        if( acceso_inscripcion === true ){
        inscripcion = false
        }
    }
    let { data: JugadorCurso, error: errorJC } = await supabaseAdmin
    .from('Usuarios')
    .select('curso')
    .eq('email', usuario_email)
    .single();

    if(JugadorCurso){
        
        if(JugadorCurso.curso === "Professor"){
            
            profesor = true;
        }
    }
    

    let { data: Jugador, error: errorJ } = await supabaseAdmin
    .from('JugadoresSS')
    .select('pertenece_equipo')
    .eq('email', usuario_email)
    .single(); // Use .single() to get a single record

    if (errorJ) {
    // console.error('Jugador sin equipo', errorJ.message);
    // Handle the error appropriately
    }
    
    if (!Jugador) {
        // console.error('Jugador no encontrado');
        let { data: Administradores, error } = await supabaseAdmin
        .from('Administradores')
        .select('rango')
        .eq('user_email', usuario_email)
        .single();

    if(!Administradores){
            // console.error("Este usuario no es Staff");
        } else{
            admin = true;
            equipo = "IES Calvià Voley Team";
            escudo = "/web-app-manifest-192x192.png";
        }
    } else {
    let { data: Equipos, error: errorE } = await supabaseAdmin
        .from('EquiposSS')
        .select('nombre_equipo, escudo')
        .eq('id', Jugador.pertenece_equipo)
        .single(); // Use .single() to get a single record

    if (errorE) {
        // console.error('Error fetching Equipos:', errorE);
        // Handle the error appropriately
    }
    if(Equipos){
        let { data: Administradores, error } = await supabaseAdmin
        .from('Administradores')
        .select('rango')
        .eq('user_email', usuario_email)
        .single();

    if(!Administradores){
            // console.error("Este usuario no es Staff");
        } else{
            admin = true;
        }
        equipo = Equipos.nombre_equipo
        escudo = Equipos.escudo
        inscripcion = true;
        
    }
    }

}
