---
import Loading from "@components/Loading.astro";
import LayoutMenuSinLoader from "@layouts/LayoutMenuSinLoader.astro";
import Pistas from "@sections/administracion/Pistas.astro";
import ClasificacionSS from "@sections/clasificacion/ClasificacionSS.astro";
import Consolacion from "@sections/clasificacion/Consolacion.astro";

import Eliminatoria from "@sections/clasificacion/Eliminatoria.astro";
import PartidosSS from '@sections/clasificacion/PartidosSS.tsx';
import Partidos from '@sections/clasificacion/Partidos.astro';
import SistemaClass from "@sections/clasificacion/SistemaClass.astro";
---
<script>
     //SubMenu desktop
     const btn_eliminatoria = document.getElementById('btn-eliminatoria')!;
     const eliminatoria = document.getElementById('eliminatoria')!;
     const btn_consolacion = document.getElementById('btn-consolacion')!;
     const consolacion = document.getElementById('consolacion')!;
     const btn_pistas = document.getElementById('btn-pistas')!;
     const pistas = document.getElementById('pistas')!;
     
     btn_eliminatoria.addEventListener('click', function() {
         if (eliminatoria.classList.contains('desactivado')) {
             consolacion.classList.add('desactivado');
             consolacion.classList.remove('activado');
             pistas.classList.remove('activado');
             pistas.classList.add('desactivado');
             eliminatoria.classList.remove('desactivado');
             eliminatoria.classList.add('activado');
             btn_consolacion.classList.remove('seleccionado');
             btn_pistas.classList.remove('seleccionado');
             btn_eliminatoria.classList.add('seleccionado');
         } 
     });
 
     btn_consolacion.addEventListener('click', function() {
         if (consolacion.classList.contains('desactivado')) {
             consolacion.classList.add('activado');
             consolacion.classList.remove('desactivado');
             pistas.classList.remove('activado');
             pistas.classList.add('desactivado');
             eliminatoria.classList.add('desactivado');
             eliminatoria.classList.remove('activado');
             btn_consolacion.classList.add('seleccionado');
             btn_pistas.classList.remove('seleccionado');
             btn_eliminatoria.classList.remove('seleccionado');
         } 
     });

     btn_pistas.addEventListener('click', function() {
         if (pistas.classList.contains('desactivado')) {
             consolacion.classList.add('desactivado');
             consolacion.classList.remove('activado');
             pistas.classList.remove('desactivado');
             pistas.classList.add('activado');
             eliminatoria.classList.add('desactivado');
             eliminatoria.classList.remove('activado');
             btn_consolacion.classList.remove('seleccionado');
             btn_eliminatoria.classList.remove('seleccionado');
             btn_pistas.classList.add('seleccionado');
         } 
     });
     
 </script>

