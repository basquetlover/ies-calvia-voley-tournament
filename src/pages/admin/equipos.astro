---


import EquiposList from "@sections/administracion/EquiposList.astro";
import EquiposListSS from "@sections/administracion/EquipoListSS.astro";
import LayoutAll from "@layouts/LayoutAll.astro";

import { supabaseAdmin } from "../../lib/supabase";

import RolSecurity from "@components/admin/RolSecurity.astro";



let equiposSS = 0;
let equipossTotal = 0;
const { data: equipos, error } = await supabaseAdmin
  .from('EquiposSS')
  .select('id')
  .order('id', { ascending: true });


if (error) {
  console.error('Error al obtener los equipos:', error);
} else if (!equipos || equipos.length === 0) {
  console.log('No se encontraron equipos');
} else {
    equipossTotal = equipos.length;
  console.log(`Se encontraron ${equipos.length} equipos`);
}

const { data: equiposNumero, error: errorNumero } = await supabaseAdmin
  .from('EquiposSS')
  .select('id')
  .eq('aceptado', 'Inscrit')
  .order('id', { ascending: true });

  if(equiposNumero){
    equiposSS = equiposNumero.length;
  }
---
<LayoutAll title="Gestionar Equipos">
    

    <RolSecurity>
        <div class="max-w-4xl w-full h-auto p-10 mx-auto my-auto mt-10 flex flex-wrap  gap-10 items-center place-content-center">
            <a href="/admin/anadir-equipos" class="w-72 h-16 bg-accent rounded-xl flex flex-row items-center place-content-center gap-4 text-xl text-amarillo font-bold hover:scale-105 duration-300 transform">
                Añadir Equipo
                <svg xmlns="http://www.w3.org/2000/svg" class="fill-amarillo w-10 h-10" viewBox="0 0 58 30">
                    <path fill="#FFC700" d="M13 17H0v-4h13V0h4v13h13v4H17v13h-4V17Z"/>
                </svg>
            </a>
        </div>
        <h2 class="text-center text-accent font-bold text-5xl">
          Equipos inscritos 
        </h2> 
        {/* <h2 class="ml-10 text-accent font-bold text-5xl">
          Equipos Semana Santa <span class="text-amarillo">{equiposSS} <span class="text-3xl">/ {equipossTotal}</span></span>
        </h2> */}
        <EquiposListSS />
        <h2 class="ml-10 text-accent font-bold text-5xl">
          Equipos Navidad
        </h2>
        <EquiposList />
      </RolSecurity>

</LayoutAll>