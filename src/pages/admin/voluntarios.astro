---

import LayoutAll from "@layouts/LayoutAll.astro";

import { supabaseAdmin } from "../../lib/supabase";

import VoluntariosListSS from "@sections/administracion/VoluntariosListSS.astro";
import RolSecurity from "@components/admin/RolSecurity.astro";



let voluntariosSS = 0;

const { data: voluntarios, error } = await supabaseAdmin
  .from('Voluntarios')
  .select('id')
  .order('id', { ascending: true });


if (error) {
  console.error('Error al obtener los voluntarios:', error);
} else if (!voluntarios || voluntarios.length === 0) {
  console.log('No se encontraron voluntarios');
} else {
    voluntariosSS = voluntarios.length;
  console.log(`Se encontraron ${voluntarios.length} voluntarios`);
}
---
<LayoutAll title="Gestionar voluntarios">
    

    <RolSecurity>
        
        <h2 class="text-center text-accent font-bold text-5xl mt-10">
          Voluntarios inscritos 
        </h2> 
        <h2 class="ml-10 text-accent font-bold text-5xl mt-4">
          Voluntarios Semana Santa <span class="text-amarillo">{voluntariosSS}</span>
        </h2>
        <VoluntariosListSS />
        
      </RolSecurity>

</LayoutAll>