---
import LayoutAll from "@layouts/LayoutAll.astro";
import SinPermisos from "@components/admin/SinPermisos.astro"

import { supabaseAdmin } from "../../lib/supabase";
import WinBraket from "@sections/administracion/WinBraket.astro";
import Consolacion from "@sections/administracion/Consolacion.astro";


// Verifica si hay un usuario autenticado
const user = Astro.locals.StaffUser;
const pathname = Astro.url.pathname;
let userWithRango = {
    email: user?.email || "Desconocido",
    rango: "Sin rango"
};

try {
    // Obtén el rango del usuario autenticado
    if (user?.email) {
        const { data: adminData, error } = await supabaseAdmin
            .from("Administradores")
            .select("rango")
            .eq("user_email", user.email)
            .single(); // Obtiene un único registro

        if (error) {
            console.error("Error al obtener rango:", error.message);
        } else if (adminData) {
            userWithRango.rango = adminData.rango || "Sin rango";
        }
    }
} catch (err) {
    console.error("Error al obtener datos del usuario:", err);
}

let accessibleBlocks = [];

try {
    const { data: pageAccess, error } = await supabaseAdmin
        .from('Whitlist')
        .select('*')
        .or(`nombre.eq.${userWithRango.email},role.eq.${userWithRango.rango}`); // Verifica acceso por email o rol

    if (pageAccess) {
        accessibleBlocks = pageAccess.map(item => item.pagina); // Extrae las páginas a las que tiene acceso
    }
} catch (err) {
    console.error("Error al obtener acceso:", err);
}

const userHasAccess = accessibleBlocks.includes(pathname);
---
<script>
    //SubMenu desktop
    const btn_eliminatoria = document.getElementById('btn-eliminatoria')!;
    const eliminatoria = document.getElementById('eliminatoria')!;
    const btn_consolacion = document.getElementById('btn-consolacion')!;
    const consolacion = document.getElementById('consolacion')!;
    
    btn_eliminatoria.addEventListener('click', function() {
        if (consolacion.classList.contains('activado')) {
            consolacion.classList.add('desactivado');
            consolacion.classList.remove('activado');
            eliminatoria.classList.remove('desactivado');
            eliminatoria.classList.add('activado');
            btn_consolacion.classList.remove('seleccionado');
            btn_eliminatoria.classList.add('seleccionado');
        } 
    });

    btn_consolacion.addEventListener('click', function() {
        if (eliminatoria.classList.contains('activado')) {
            consolacion.classList.add('activado');
            consolacion.classList.remove('desactivado');
            eliminatoria.classList.add('desactivado');
            eliminatoria.classList.remove('activado');
            btn_consolacion.classList.add('seleccionado');
            btn_eliminatoria.classList.remove('seleccionado');
        } 
    });
    
</script>
<LayoutAll title="Insertar Resultados">
    {userHasAccess ? (
    <>
    <div class="w-max ml-5 h-auto flex flex-row gap-x-2 px-4 pt-2 mt-5 rounded-tr-md rounded-tl-md bg-azul">
        <div id="btn-eliminatoria" class="text-center py-2 px-3 rounded-tr-md rounded-tl-md text-amarillo text-2xl cursor-pointer seleccionado">Eliminatoria</div>
        <div id="btn-consolacion" class="text-center py-2 px-3 rounded-tr-md rounded-tl-md text-amarillo text-2xl cursor-pointer">Consolación</div>
    </div>
    <div id="eliminatoria" class="activado">
      <WinBraket />
    </div>
    <div id="consolacion" class="desactivado">
      <Consolacion />
    </div>

    </>
) : (
    <SinPermisos /> // Renderiza el componente NoAccess si no tiene acceso
)}
</LayoutAll>

<style>
    .seleccionado{
        background-color: #313131;
    }
    .activado{
        display: block;
    }
    .desactivado{
        display: none;
    }
</style>