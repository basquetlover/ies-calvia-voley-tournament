        <button id="comprobacion" type="submit" class="px-3 py-2 cursor-pointer text-blanco font-semibold bg-aceptar rounded-full text-xl hover:scale-110 duration-300 transition-all transform">Acta Digital</button>
    </div>

    <div id="errorbox" class="text-red-500"></div>
