import DesignacionesDinamicas from "@components/admin/DesignacionesDinamicas";
import LayoutAll from "@layouts/LayoutAll.astro";
import { verificarSesion } from "src/lib/session";
import { supabaseAdmin } from "src/lib/supabase";

const usuario = await verificarSesion(Astro.request);
const { data: ConfTorneo, error: ConfError } = await supabaseAdmin
  .from('Configuracion')
  .select('id_torneo, nombre')
  .eq('estado', 'Actual')
  .single();

  let TablaPartidos = `Partidos${ConfTorneo?.id_torneo}`;
  let TablaEquipos = `Equipos${ConfTorneo?.id_torneo}`;
if(usuario){
	console.log("Usuario:", usuario.email, usuario.nombre, usuario.curso )
}

interface Equipo {
  nombre_equipo: string;
  escudo: string;
}

interface Partido {
  equipo_local: string;
  equipo_visitante: string;
  arbitro: string;
  oficial_1: string;
  oficial_2: string;
  pista: string;
  id_partido: string;
  estado: string;
}

let partidos_designados: Partido[] = [];
let escudosMappartidos_designados: Record<string, string> = {}; // Mapa para guardar escudos por nombre de equipo

let { data: Administradores, error } = await supabaseAdmin
  .from('Administradores')
  .select('nombre')
  .or(`user_email.eq.${usuario.email},user_email.eq.${usuario.email_microsoft}`)
  .single();

try {
  // Obtener partidos de la pista 1
  const { data, error } = await supabaseAdmin
    .from(TablaPartidos)
    .select('equipo_local, equipo_visitante, pista, id_partido, arbitro, oficial_1, oficial_2, estado')
    .or(`arbitro.eq.${Administradores?.nombre},oficial_1.eq.${Administradores?.nombre},oficial_2.eq.${Administradores?.nombre}`)
    .order('id', { ascending: true });

  if (error) {
    console.error(`Error al buscar partido 1`, error.message);
  } else {
    partidos_designados = data || []; // Asignar data a partidos_designados
  }

  // Obtener todos los nombres de los equipos
  const equiposNombres = [...new Set(partidos_designados.flatMap(partido => [partido.equipo_local, partido.equipo_visitante]))];

  // Obtener escudos de los equipos
  const { data: equipos, error: errorEquipos } = await supabaseAdmin
    .from(TablaEquipos)
    .select('nombre_equipo, escudo')
    .in('nombre_equipo', equiposNombres);

  if (errorEquipos) {
    console.error(`Error al buscar escudos de equipos`, errorEquipos.message);
  } else {
    // Crear un mapa de escudos
    escudosMappartidos_designados = equipos.reduce((acc: Record<string, string>, equipo: Equipo) => {
      acc[equipo.nombre_equipo] = equipo.escudo;
      return acc;
    }, {});
  }
} catch (err) {
  console.error('Error al obtener rango:', err);
}


