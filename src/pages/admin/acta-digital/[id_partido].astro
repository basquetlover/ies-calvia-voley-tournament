    // Función para agregar eventos a un div
    function addEventListenersToDiv(div: HTMLDivElement) {
        div.addEventListener('click', (event: MouseEvent) => {
            if (!isLongPress) {
                MarcarJugada(event);
            }
            isLongPress = false;
        });
    
        div.addEventListener('mousedown', () => {
            isLongPress = false;
            pulsando = window.setTimeout(() => {
                isLongPress = true;
                handleDivClick(div.id); // Ejecuta
            }, 500);
        });
    
        div.addEventListener('mouseup', () => {
            if (pulsando !== null) {
                clearTimeout(pulsando);
                pulsando = null;
            }
        });
    
        div.addEventListener('mouseleave', () => {
            if (pulsando !== null) {
                clearTimeout(pulsando);
