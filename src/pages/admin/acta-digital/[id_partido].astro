                                        <path d="M234-276q51-39 114-61t132-23q69 0 132 23t114 61q35-41 55-93t19-111q0-133-93-226t-227-94q-133 0-226 94t-94 226q0 59 20 111t54 93Zm246-164q-59 0-99-40t-41-100q0-59 41-99t99-41q59 0 100 41t40 99q0 59-40 100t-100 40Zm0 360q-83 0-156-31t-127-86q-54-54-85-127T80-480q0-83 32-156t85-127q54-54 127-85t156-32q83 0 156 32t127 85q54 54 86 127t31 156q0 83-31 156t-86 127q-54 54-127 86T480-80Zm0-80q53 0 100-15t86-45q-39-29-86-44t-100-16q-53 0-100 16t-86 44q39 29 86 45t100 15Zm0-360q26 0 43-17t17-43q0-26-17-43t-43-17q-26 0-43 17t-17 43q0 26 17 43t43 17Zm0-60Zm0 360Z"/>
                                    </svg> */}
                                    <img src={jugador.img} class="w-20 h-20"/>
                                </div>
                                <input id={`local_nombre_${index}`} class="w-full bg-transparent text-center text-blanco select-none" value={`${jugador.nombre}`} disabled/>
                            </div>
                        )
                    )}
                    <div class="w-full h-auto rounded-md mx-3 bg-gris-claro grid grid-cols-[max-content_1fr] grid-rows-1">
                        <div>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20 fill-blanco" viewBox="0 -960 960 960">
                                        <path d="M234-276q51-39 114-61t132-23q69 0 132 23t114 61q35-41 55-93t19-111q0-133-93-226t-227-94q-133 0-226 94t-94 226q0 59 20 111t54 93Zm246-164q-59 0-99-40t-41-100q0-59 41-99t99-41q59 0 100 41t40 99q0 59-40 100t-100 40Zm0 360q-83 0-156-31t-127-86q-54-54-85-127T80-480q0-83 32-156t85-127q54-54 127-85t156-32q83 0 156 32t127 85q54 54 86 127t31 156q0 83-31 156t-86 127q-54 54-127 86T480-80Zm0-80q53 0 100-15t86-45q-39-29-86-44t-100-16q-53 0-100 16t-86 44q39 29 86 45t100 15Zm0-360q26 0 43-17t17-43q0-26-17-43t-43-17q-26 0-43 17t-17 43q0 26 17 43t43 17Zm0-60Zm0 360Z"/>
                                    </svg>
                                </div>
                                <p class="my-auto text-blanco">Entrenador</p>
                    </div>
                </div>
            </div>

             {/* Datos equipo Generales */}
             <div class="w-full h-full bg-gris-claro flex flex-col items-center pt-4 gap-y-2">
                {/* Datos generales */}
                <div class="w-full flex flex-wrap gap-1 ocultar">
                    <input class="w-24" id="nombre-jugador" name="nombre-jugador" type="text" />
                    <input class="w-24" id="id-equipo" name="id-equipo" type="text" />
                    <input class="w-24" id="tipo-punto" name="tipo-punto" type="text" />
                    <input class="w-24" id="tiempo" name="tiempo" type="text" />
                    <input class="w-24" id="orden" name="orden" type="text" />
                    <input class="w-24" name="id_partido" id="id_partido" type="text"  value={id_partido}/>
                    <input name="FormLocPuntos" id="FormLocPuntos" type="text" />
                    <input name="FormLocSet" id="FormLocSet" type="text" />
                    <input name="FormVisPuntos" id="FormVisPuntos" type="text" />
                    <input name="FormVisSet" id="FormVisSet" type="text" />
                    <input name="FormAction" id="FormAction" type="text" />
                </div>

                {/* Marcador */}
                <div id="marcador" class="w-[90%] h-auto grid grid-rows-1 grid-cols-[max-content_max-content_1fr_max-content_max-content]  gap-x-1">
                    {/* Puntos */}
                    <span data-LocPuntos class="text-blanco text-7xl font-semibold">0</span>
                    {/* Sets */}
                    <span data-LocSets class="text-blanco text-4xl font-semibold flex flex-col place-content-end">0</span>
                    {/* Pista */}
                    <span class="text-blanco text-2xl flex flex-col place-content-center items-center">{pista}</span>
                    {/* Sets */}
                    <span data-VisSets class="text-blanco text-4xl font-semibold flex flex-col place-content-end">0</span>
                    {/* Puntos */}
                    <span data-VisPuntos class="text-blanco text-7xl font-semibold">0</span>
                </div>

                {/* Reloj */}
                <div id="reloj" class="w-52 h-auto text-azul-suave flex flex-row gap-2 place-content-center items-center cursor-pointer select-none">
                    <span data-minutos class="text-5xl font-semibold ">00</span>
                    <span class="text-5xl font-semibold ">:</span>
                    <span data-segundos class="text-5xl font-semibold ">00</span>
                    
                </div>

                {/* Arbitros */}
                <div class="w-52 h-16 mb-1  flex flex-wrap gap-2 place-content-center items-center">
                    <p class="text-blanco font-medium text-base"><span class="font-bold">Arbitro:</span> {arbitro}</p>
                    <p class="text-blanco font-medium text-base"><span class="font-bold">Oficial 1:</span> {oficial_1}</p>
                    <p class="text-blanco font-medium text-base"><span class="font-bold">Oficial 2:</span> {oficial_2}</p>
                </div>

                {/* Tipos de puntos */}
                <div class="w-52 h-auto  flex flex-wrap gap-2 place-content-center items-center">
                    {/* Directo */}
                    <div id="directo" class="bg-gris w-20 h-20 rounded-md flex flex-col items-center place-content-center">
