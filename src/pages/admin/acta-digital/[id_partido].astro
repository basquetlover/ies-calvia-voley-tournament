        function asignarOrden() {
            
            let ordenBase = parseInt(String(totalMilisegundos), 10); // Convertir a número entero
    
            // Asegurarse de que el orden base es un número válido
            if (isNaN(ordenBase) || ordenBase < 0) {
                alert("Por favor, introduce un número de milisegundos válido.");
                return;
            }
    
            // Formatear el número de orden a 4 dígitos
            let ordenFormateado = ordenBase.toString().padStart(4, '0');
    
            // Verificar si el orden ya existe y sumar 1 si es necesario
            while (ordenes.includes(ordenFormateado)) {
                ordenBase++;
                ordenFormateado = ordenBase.toString().padStart(4, '0');
            }
    
            // Agregar el nuevo número de orden al array
            ordenes.push(ordenFormateado);
    
            // Asignar el número de orden al input correspondiente
            orden.value = ordenFormateado;
            //console.log(`Número de orden asignado: ${ordenFormateado}`);
        }
    
     async   function eliminarJugada(nombreArray: string) {
        const modificar_reference = document.getElementById("modificar_reference") as HTMLInputElement;
        const jugadasExistentes = localStorage.getItem(nombreArray) ? JSON.parse(localStorage.getItem(nombreArray)!) : [];

        const FormLocPuntos = document.getElementById('FormLocPuntos') as HTMLInputElement;
        const FormLocSet = document.getElementById('FormLocSet') as HTMLInputElement;
        const FormVisPuntos = document.getElementById('FormVisPuntos') as HTMLInputElement;
        const FormVisSet = document.getElementById('FormVisSet') as HTMLInputElement;

        const FormAction = document.getElementById('FormAction') as HTMLInputElement;
    
        // Obtener el número de referencia de la jugada a eliminar
        const referencia = modificar_reference.value;
      //  if(Number(referencia) < ModificarHasta){
            // Buscar la jugada en el array usando el valor de referencia
        const index = jugadasExistentes.findIndex((jugada: { orden: string; }) => jugada.orden === referencia);
           // console.log(index)
        // Verificar si la referencia es válida
        if (index !== -1) {
            // Obtener la jugada que se va a eliminar
            const jugadaAEliminar = jugadasExistentes[index];
    
            // Verificar que la jugada existe
            if (jugadaAEliminar) {
                
                // Determinar si se debe restar un punto al equipo local o visitante
                if (jugadaAEliminar.tipoPunto === 'Error') {
                    // Si es un error, restar al equipo contrario
                    if (jugadaAEliminar.idEquipo === 'equipo-local') {
                        if(VisPuntos > 0){
                                VisPuntos = VisPuntos - 1;
                               
                            }
                        
                    } else {
                        if(LocPuntos > 0){
                               
                                LocPuntos = LocPuntos - 1;
                            }
                        
                    }
                } else {
                    // Si no es un error, restar al equipo correspondiente
                    if (jugadaAEliminar.idEquipo === 'equipo-local') {
                        if(LocPuntos > 0){
                               
                                LocPuntos = LocPuntos - 1;
                            }
                    } else {
                        if(VisPuntos > 0){
                                VisPuntos = VisPuntos - 1;
                                
                            }
                       
                    }
                }
    
                if(jugadaAEliminar.tipoPunto === "FinSet"){
                    LocPuntos = Number(jugadaAEliminar.locPuntos);
                    VisPuntos = Number(jugadaAEliminar.visPuntos);
                    ModificarHasta = -10000;
                    if(Number(jugadaAEliminar.locPuntos) < Number(jugadaAEliminar.visPuntos)){
                        VisSets = VisSets -1;
                    } else{
                        LocSets = LocSets -1;
                    }
                }
    
                // Eliminar la jugada del array
                jugadasExistentes.splice(index, 1);
                if(jugadaAEliminar.tipoPunto === "FinSet"){
                    let PuntoFinSet = index -1;
                    const PuntoFinSet_orden = jugadasExistentes[PuntoFinSet].orden;
                   // console.log(PuntoFinSet_orden);
                    jugadasExistentes.splice(PuntoFinSet, 1);
                    const divJugada = document.getElementById(`jugada_${PuntoFinSet_orden}`);
                    if (divJugada) {
                        divJugada.remove(); // Elimina el elemento del DOM si existes
                    }
    
                    let ActualizarMarcador = index -2;
                    const PuntosLoc = jugadasExistentes[ActualizarMarcador].locPuntos;
                    const PuntosVis = jugadasExistentes[ActualizarMarcador].visPuntos;
                    LocPuntos = Number(PuntosLoc);
                    VisPuntos = Number(PuntosVis);
                }
    
                // Actualizar el localStorage
                localStorage.setItem(nombreArray, JSON.stringify(jugadasExistentes));
    
                // Actualizar las jugadas restantes
                for (let i = index; i < jugadasExistentes.length; i++) {
                    // Restar un punto a cada jugada posterior
                    if (jugadaAEliminar.tipoPunto === 'Error') {
                        if (jugadaAEliminar.idEquipo === "equipo-local") {
                        //    console.log("Ejecutado 1")
                            if(jugadasExistentes[i].visPuntos > 0){
                                jugadasExistentes[i].visPuntos =  jugadasExistentes[i].visPuntos - 1;
                            }
                            
                        } else {
                          //  console.log("Ejecutado 2")
                            if(jugadasExistentes[i].locPuntos > 0){
                                jugadasExistentes[i].locPuntos =  jugadasExistentes[i].locPuntos - 1;
                            }
                            
                        }
                    } else {
                        if (jugadaAEliminar.idEquipo === "equipo-local") {
                           // console.log("Ejecutado 3")
                            if(jugadasExistentes[i].locPuntos > 0){
                                jugadasExistentes[i].locPuntos =  jugadasExistentes[i].locPuntos - 1;
                            }
                            
                            
                        } 
                        if (jugadaAEliminar.idEquipo === "equipo-visitante"){
                           // console.log("Ejecutado 4")
                            if(jugadasExistentes[i].visPuntos > 0){
                             jugadasExistentes[i].visPuntos =  jugadasExistentes[i].visPuntos - 1;
                            }
                            
                        }
                    }
                    
                }
    
                // Guardar los cambios en el localStorage
                localStorage.setItem(nombreArray, JSON.stringify(jugadasExistentes));
    
                // Eliminar el div correspondiente
                const divJugada = document.getElementById(`jugada_${modificar_reference.value}`);
                if (divJugada) {
                    divJugada.remove();
                }
    
                // Actualizar los inputs de las jugadas restantes
                actualizarJugadasRestantes(jugadasExistentes);
    
                // Actualizar el marcador en el DOM
                actualizarMarcador();
                FormAction.value = "EliminarJugada";

            try {
                await enviarDatosAPi(); // Espera a que se complete la función
                console.log("El código continúa después de recibir la respuesta.");
            } catch (error) {
                console.error("Ocurrió un error al enviar los datos:", error);
            }
            } else {
                console.error("La jugada a eliminar no existe.");
            }
        } else {
            console.error("Referencia no válida");
        }
     
    
    //}
        
    }
    
