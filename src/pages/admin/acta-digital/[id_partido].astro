    function obtenerHoraActual() {
        const fecha = new Date(); // Crear un nuevo objeto Date con la fecha y hora actuales
        const horas = String(fecha.getHours()).padStart(2, '0'); // Obtener las horas y formatear a 2 dígitos
        const minutos = String(fecha.getMinutes()).padStart(2, '0'); // Obtener los minutos y formatear a 2 dígitos
        const segundos = String(fecha.getSeconds()).padStart(2, '0'); // Obtener los segundos y formatear a 2 dígitos
    
        return `${horas}:${minutos}:${segundos}`; // Devolver la hora en formato HH:MM:SS
    }
    
    
