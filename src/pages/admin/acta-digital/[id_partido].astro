    // Función para enviar datos a la API
async function enviarDatosAPi() {
        const FormAction = document.getElementById('FormAction') as HTMLInputElement;
    const form = document.getElementById('formulario') as HTMLFormElement; // Asegúrate de que este ID coincida con tu formulario
    if (!form) {
        console.error("Formulario no encontrado");
        return; // Salir si el formulario no se encuentra
    }

    const formData = new FormData(form); // Ahora TypeScript sabe que 'form' es un HTMLFormElement

    const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
    });

    const contentType = response.headers.get("Content-Type");
    if (contentType && contentType.includes("text/html")) {
        const html = await response.text();
        // Manejo de HTML
    } else if (contentType && contentType.includes("application/json")) {
        const jsonResponse = await response.json();
        if (jsonResponse.success) {
            console.log("Código de la API finalizado");
