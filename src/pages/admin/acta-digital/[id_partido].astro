    //Guardar Configuracion Local Storage
    function guardarConf(nombreArray: string) {
        const conf_puntos_form = document.getElementById('conf-puntos') as HTMLInputElement;
    const conf_dif_puntos_form = document.getElementById('conf-dif-puntos') as HTMLInputElement;
    const conf_puntos_extra_form = document.getElementById('conf-puntos-extra') as HTMLInputElement;
    const conf_dif_puntos_extra_form = document.getElementById('conf-dif-puntos-extra') as HTMLInputElement;
    
    // Crear un objeto con la información del jugador
    const Configuracion = {
        conf_puntos: Number(conf_puntos_form.value),
        conf_dif_puntos: Number(conf_dif_puntos_form.value),
        conf_puntos_extra: Number(conf_puntos_extra_form.value),
        conf_dif_puntos_extra: Number(conf_dif_puntos_extra_form.value),
    };
    
    // Recuperar el array existente de configuraciones del localStorage
    //const nombreArray = 'nombreDeTuArray'; // Asegúrate de definir el nombre del array
    const configuracionesExistentes = localStorage.getItem(nombreArray) ? JSON.parse(localStorage.getItem(nombreArray)!) : [];
    
    // Buscar si ya existe una configuración para actualizar
    const index = configuracionesExistentes.findIndex((item: any) => item.conf_puntos === Configuracion.conf_puntos);
    
    if (index !== -1) {
        // Si existe, actualiza los valores
        configuracionesExistentes[index] = Configuracion;
    } else {
        // Si no existe, añade la nueva configuración
        configuracionesExistentes.push(Configuracion);
    }
    
    // Guardar el array actualizado en localStorage
    localStorage.setItem(nombreArray, JSON.stringify(configuracionesExistentes));
    }
    
