<LayoutAllSinMenu title={`Acta | ${id_partido}`}>
<div class="h-screen flex items-center place-content-center">    
    <form id="formulario" method="POST" action="/api/usuario/ActaDigital" class="h-[700px] w-[1100px] my-auto bg-red-400 overflow-auto mx-auto no-scrollbar relative">
        <div id="box_principal" class="w-full h-full border-2 border-accent bg-gris grid grid-rows-1 grid-cols-3 select-none">

            {/* Datos equipo 1 */}
            <div class="w-full h-full bg-transparent">
                {/* Nombre e Imagen Equipo */}
                <div class="w-full h-auto grid grid-cols-[max-content_1fr] grid-rows-1 p-2">
                    <div class="w-max h-max">
                        <img src={escudo_equipo_local} class="w-16 h-16" />
                    </div>
                    <div class="flex items-center place-content-center">
                        <input type="hidden" id="id_equipo_local" disabled value={`equipo-local`}/>
                        <input type="hidden" name="referencia_equipo_local" value={referencia_EL} />
                        <input type="hidden" id="local_total_play" disabled value={jugadoresLocal.length} />
                        <p class="text-2xl text-accent font-semibold">{nombre_equipo_local}</p>
                    </div>
                </div>

                {/* Lista jugadores */}
                <div class="w-full mt-4 h-auto flex flex-wrap gap-2 items-center place-content-center">
                    {
                        jugadoresLocal.map((jugador, index) => (
                            <div id={`local_play_${index}`} class="w-[105px] h-[105px] rounded-md bg-gris-claro flex flex-col items-center place-content-center cursor-pointer">
                                <div>
