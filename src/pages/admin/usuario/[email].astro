}
// Genera rutas dinámicas
export async function getStaticPaths() {
  // Consulta a la base de datos para obtener user_email y rango
  const { data, error } = await supabaseAdmin
    .from('Usuarios')
    .select('email');

  if (error) {
    console.error('Error fetching administradores:', error.message);
    return { paths: [] };
  }

  // Genera las rutas dinámicas con datos adicionales
  const paths = data.map((admin) => ({
    params: { uemail: admin.email },
    //props: { rango: admin.rango }, // Pasamos rango como parte de los props
  }));

  return { paths };
}
function formatearFecha(fechaISO: string): string {
  const fecha = new Date(fechaISO); // Convertir string → Date

  const dia = String(fecha.getDate()).padStart(2, "0");
  const mes = String(fecha.getMonth() + 1).padStart(2, "0");
  const anio = fecha.getFullYear();

  const horas = String(fecha.getHours()).padStart(2, "0");
  const minutos = String(fecha.getMinutes()).padStart(2, "0");
  const segundos = String(fecha.getSeconds()).padStart(2, "0");

  return `${dia}/${mes}/${anio} ${horas}:${minutos}:${segundos}`;
}

const user_email = Astro.url.pathname.split('/').pop();

let nombre = '';
let nombre_real = '';
let apellidos = '';
let curso = '';
let staff = ''
let id = '';
let usuario_img ='';
let anyo = '';
let estado = '';
let creacion = '';
let iniciada = '';
let cerrar_sesion = false



let torneos: Torneo[] = [];
let sanciones: Sancion[] = [];

const { data: Conftorneos, error: errorTorneos } = await supabaseAdmin
  .from('Configuracion')
  .select('id_torneo, nombre, fecha')
  .order('id', {ascending: false});

try {
  // Buscar el rango correspondiente al email en la tabla Administradores
  const { data: usuario, error } = await supabaseAdmin
    .from('Usuarios')
    .select('*')
    .eq('email', user_email)
    .single();

  if (error) {
    console.error(`Error al buscar rango para ${user_email}:`, error.message);
  } else if (usuario) {
    nombre = usuario.nombre;
    curso = usuario.curso;
    id = usuario.id;
    nombre_real = usuario.nombre_real;
    apellidos = usuario.apellidos;
    staff = usuario.staff;
    anyo = usuario.anyo;
    estado = usuario.estado;
    creacion = formatearFecha(usuario.created_at);
    iniciada = usuario.session_id;

  }
} catch (err) {
  console.error('Error al obtener rango:', err);
}

if(iniciada !== ''){
    cerrar_sesion = true
}

  // Buscar el rango correspondiente al email en la tabla Administradores
  const { data: UserData, error } = await supabaseAdmin
    .from('Jugadores')
    .select('pertenece_equipo')
    .eq('email', user_email)
    .single();

  if (error) {
    //console.error(`Error al buscar rango para ${user_email}:`, error.message);
  } else if (UserData) {
    const { data: UserEquip, error } = await supabaseAdmin
    .from('Equipos')
    .select('nombre_equipo')
    .eq('id', UserData.pertenece_equipo)
    .single();
    if(UserEquip){
        torneos.push({
            nombre: "Torneig Nadal",
            equipo: UserEquip.nombre_equipo,
            licencia: "jugador",
            fecha: "20-12-2024"

        });
    } 
  }

  if (Conftorneos) {
  for (const torneo of Conftorneos) {
    const tablaJugadores = `Jugadores${torneo.id_torneo}`;
    const tablaEquipos = `Equipos${torneo.id_torneo}`;
    const { data: UserData, error: errorEquipos } = await supabaseAdmin
      .from(tablaJugadores)
      .select('pertenece_equipo, img, ficha')
      .eq('email', user_email)
      .single();

    if (UserData) {
        const { data: UserEquip, error } = await supabaseAdmin
        .from(tablaEquipos)
        .select('nombre_equipo')
        .eq('id', UserData.pertenece_equipo)
        .single();
        if(UserEquip){
            torneos.push({
                nombre: torneo.nombre,
                equipo: UserEquip.nombre_equipo,
                licencia: UserData.ficha,
                fecha: torneo.fecha

            });
        } else if(error){
            console.log(error)
        }

        usuario_img = UserData.img;
    }
  }
}

if (Conftorneos) {
  for (const torneo of Conftorneos) {
    const tablaVoluntarios = `Voluntarios${torneo.id_torneo}`;
    
    const { data: UserData, error: errorEquipos } = await supabaseAdmin
      .from(tablaVoluntarios)
      .select('tipo, img')
      .eq('email', user_email)
      .single();

    if (UserData) {
        const { data: UserEquip, error } = await supabaseAdmin
        .from('Administradores')
        .select('rango')
        .eq('user_email', user_email)
        .single();
        
        if(UserEquip){
            torneos.push({
                nombre: torneo.nombre,
                equipo: UserEquip.rango,
                licencia: UserData.tipo,
                fecha: torneo.fecha

            });
        }
            
        

        usuario_img = UserData.img;
    }
  }
}

const { data: UserBanned, error: ErrorBlacklist } = await supabaseAdmin
    .from('Blacklist')
    .select('torneo, motivo, sancion')
    .eq('email', user_email)
    .order('id', {ascending: false});
if(UserBanned){
    for (const Baneos of UserBanned) {
        sanciones.push({
                motivo: Baneos.motivo,
                torneo: Baneos.torneo,
                sancion: Baneos.sancion,

            });
    }
}
    

