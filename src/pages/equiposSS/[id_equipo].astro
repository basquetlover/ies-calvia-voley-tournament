---

<LayoutMenu title={ `${nombre_equipo} | IES Calvià Voley Tournament`} descripcion={`Conoce los participantes del equipo ${nombre_equipo} `}>
    <section class="max-w-6xl h-auto p-2 m-auto my-10">
        <a href="/equipos#inscritos" class="inline-flex items-center gap-2 px-4 py-2 bg-amarillo text-gray-800 rounded-full hover:scale-110 transition-all duration-300" aria-label="Volver a la página de equipos">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 -960 960 960" class="fill-current">
            <path d="M313-440l224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/>
          </svg>
          Tornar a equips
        </a>
      </section>
      
            {/* <!-- Sección jugadores --> */}
            <section class="max-w-[1600px] h-auto m-auto my-10">
              <h1 class="text-accent text-6xl font-bold text-center" translate="no">{nombre_equipo}</h1>
              
              {escudo && escudo.trim() !== "" ?  (
                      <img transition:name="equipo-escudo" src={escudo} alt={`${nombre_equipo} escudo`} class="w-72 h-72 mx-auto my-10 rounded-lg" />
                    ) : (
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-72 h-72 mx-auto my-10" fill="none" viewBox="0 0 650 650">
                          <circle cx="325" cy="325" r="315" stroke="#313131" stroke-width="20"/>
                          <rect width="450" height="20" x="100" y="315" fill="#313131" rx="10"/>
                      </svg>
              )}
              
              
            </section>
            
            <section class="max-w-6xl h-auto m-auto my-10">
              <p class=" text-xl text-blanco font-medium"><span class="text-amarillo font-bold">Capità</span> {capitan}</p>
              <p class=" text-xl text-blanco font-medium"><span class="text-amarillo font-bold">Entrenador        </span> {entrenador}</p>
      
              <div class="w-full h-[2px] flex flex-col my-4 rounded-full bg-accent"></div>
      
              <h2 class=" text-xl text-amarillo font-bold">Jugadors</h2>
              <table class="text-xl text-blanco font-normal max-w-3xl w-full h-auto my-2 border-spacing-y-8">
                  <tr><td><h4 class="text-accent font-bold">Nom</h4></td>    <td><h4 class="text-accent font-bold">Curs</h4></td></tr>
                  {
                      jugadores.map((jugador) => (
                          <tr><td translate="no">{jugador.nombre} {jugador._1r_apellido}</td>   <td>{jugador.curso}</td></tr>
                      ))
                  }
              </table>
              {profesor_nombre === null || profesor_nombre === "" ? (
                <></>
                ):(<>
                <h2 class=" text-xl text-amarillo font-bold">Professor Jugador</h2>
                <table class="text-xl text-blanco font-normal max-w-3xl w-full h-auto my-2 border-spacing-y-8">
                    <tr><td><h4 class="text-accent font-bold">Nom</h4></td>    <td><h4 class="text-accent font-bold">Curs</h4></td></tr>
                    
                            <tr><td translate="no">{profesor_nombre} {profesor_1r_apellido}</td>   <td>{profesor_curso}</td></tr>
                        
                </table>
                </>)}
              {staff === null || staff.length <=0 ? (
              <></>
              ):(<>
              <h2 class=" text-xl text-amarillo font-bold">Tècnics d'equip</h2>
              <table class="text-xl text-blanco font-normal max-w-3xl w-full h-auto my-2 border-spacing-y-8">
                  <tr><td><h4 class="text-accent font-bold">Nom</h4></td>    <td><h4 class="text-accent font-bold">Curs</h4></td></tr>
                  {
                      staff.map((jugador) => (
                          <tr><td translate="no">{jugador.nombre} {jugador._1r_apellido}</td>   <td>{jugador.curso}</td></tr>
                      ))
                  }
              </table>
              </>)}
              <h3 class="text-4xl text-amarillo mt-5 font-semibold">Partits {nombre_equipo}</h3>
              <div class="w-full mx-auto flex h-auto flex-wrap place-content-around gap-4 mb-5">
    {partidos_perdedores.map((p, idx) => (
  <div class="w-max flex flex-col gap-2 bg-gris-claro rounded-lg p-2">
    {/* <!-- Cabecera --> */}
    <div class="grid grid-cols-3 place-items-center text-blanco">
      <h4 class="text-sm">{p.numero}</h4>
      <h5 class={`text-gray-500 text-xs ${p.estado === "En Directe" ? "text-red-600 flex flex-row items-center place-content-center" : ""}`}>
        {p.estado}
      </h5>
      <h4 class="text-sm">{p.pista}</h4>
    </div>

    {/* <!-- Equipo 1 --> */}
    <EquipoBox>
      <div>
        {p.escudo1 && p.escudo1.trim() !== "" ? (
          <img src={p.escudo1} class="w-10 h-10 rounded-sm" alt={p.equipo1} />
        ) : (
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 rounded-sm" fill="none" viewBox="0 0 650 650">
            <circle cx="325" cy="325" r="315" stroke="#fff" stroke-width="20" />
            <rect width="450" height="20" x="100" y="315" fill="#fff" rx="10" />
          </svg>
        )}
      </div>
      <p class="text-blanco text-base text-center">{p.equipo1}</p>
      <div>
        <input name={`partido${idx}_ra`} class="text-blanco text-2xl w-4 text-center bg-transparent border-none" value={p.resultadoA} placeholder="0" />
      </div>
    </EquipoBox>

    {/* <!-- Equipo 2 --> */}
    <EquipoBox>
      <div>
        {p.escudo2 && p.escudo2.trim() !== "" ? (
          <img src={p.escudo2} class="w-10 h-10 rounded-sm" alt={p.equipo2} />
        ) : (
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 rounded-sm" fill="none" viewBox="0 0 650 650">
            <circle cx="325" cy="325" r="315" stroke="#fff" stroke-width="20" />
            <rect width="450" height="20" x="100" y="315" fill="#fff" rx="10" />
          </svg>
        )}
      </div>
      <p class="text-blanco text-base text-center">{p.equipo2}</p>
      <div>
        <input name={`partido${idx}_rb`} class="text-blanco text-2xl w-4 text-center bg-transparent border-none" value={p.resultadoB} placeholder="0" />
      </div>
    </EquipoBox>
  </div>
))}

</div>
            </section>
          </>
</LayoutMenu>