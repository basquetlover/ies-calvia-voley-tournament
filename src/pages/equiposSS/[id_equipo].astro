              <table class="text-xl text-blanco font-normal max-w-3xl w-full h-auto my-2 border-spacing-y-8">
                  <tr><td><h4 class="text-accent font-bold">Nom</h4></td>    <td><h4 class="text-accent font-bold">Curs</h4></td></tr>
                  {
                      staff.map((jugador) => (
                          <tr><td translate="no">{jugador.nombre} {jugador._1r_apellido}</td>   <td>{jugador.curso}</td></tr>
                      ))
