                    <tr><td><h4 class="text-accent font-bold">Nom</h4></td>    <td><h4 class="text-accent font-bold">Curs</h4></td></tr>
                    
                            <tr><td translate="no">{profesor_nombre} {profesor_1r_apellido}</td>   <td>{profesor_curso}</td></tr>
                        
                </table>
                </>)}
              {staff === null || staff.length <=0 ? (
