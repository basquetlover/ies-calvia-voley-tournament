---
import { supabaseAdmin } from "../../lib/supabase";
import EquipoBox from "@components/admin/EquipoBoxIzq.astro";

const { searchParams } = new URL(Astro.request.url);
let torneoID = searchParams.get('torneoID');

if (torneoID) {
  // Eliminar comillas si las hubiera
  torneoID = torneoID.replace(/^"(.*)"$/, '$1');
  //console.log('Torneo ID:', torneoID); // Aparece en consola del servidor
} else{
  torneoID = "SS"
}

import LayoutMenu from "@layouts/LayoutMenu.astro";
// Tipo explícito para las propiedades esperadas en `Astro.props`

// Tipo explícito para las propiedades esperadas en `Astro.props`
type AdministradorProps = {
    id_equipo: string;
    nombre_equipo: string;
};

// Genera rutas dinámicas
export async function getStaticPaths() {
  // Consulta a la base de datos para obtener user_email y rango
  const { data, error } = await supabaseAdmin
    .from('Equipos')
    .select('id_equipo, nombre_equipo');

  if (error) {
    console.error('Error fetching administradores:', error.message);
    return { paths: [] };
  }

  // Genera las rutas dinámicas con datos adicionales
  const paths = data.map((equipo) => ({
    params: { id_equipo: equipo.id_equipo },
    props: { nombre_equipo: equipo.nombre_equipo }, // Pasamos rango como parte de los props
  }));

  return { paths };
}
const id_equipo = Astro.url.pathname.split('/').pop();

let nombre_equipo = 'Sin Nombre';
let escudo = "";
let capitan = "";
let entrenador = "";
let id = "";

let profesor_nombre = "";
let profesor_1r_apellido = "";
let profesor_curso = "";
interface Jugador {
  nombre: string;
  pertenece_equipo: string;
  curso: string;
  id:string;
  checkboxChecked?: boolean;
  _1r_apellido: string;
}
interface Staff {
  nombre: string;
  pertenece_equipo: string;
  curso: string;
  id:string;
  checkboxChecked?: boolean;
  _1r_apellido: string;
}

let jugadores: Jugador[] = [];
let staff: Staff[] = [];
let camposVacios: Jugador[] = [];

try {
  // Buscar el rango correspondiente al email en la tabla Administradores
  const { data: equipoData, error } = await supabaseAdmin
    .from(`Equipos${torneoID}`)
    .select('nombre_equipo, id, capitan, entrenador, escudo')
    .eq('id_equipo', id_equipo)
    .single();

  if (error) {
    console.error(`Error al buscar nombre_equipo para ${id_equipo}:`, error.message);
  } else if (equipoData) {
    nombre_equipo = equipoData.nombre_equipo;
    escudo = equipoData.escudo;
    capitan = equipoData.capitan;
    entrenador = equipoData.entrenador;
    id = equipoData.id;
  }

  const {data: jugadoresData, error: jugadorError} = await supabaseAdmin
    .from(`Jugadores${torneoID}`)
    .select('nombre, pertenece_equipo, curso, id, _1r_apellido')
    .eq('pertenece_equipo', id)
    .eq('ficha', 'jugador')
    .order('id', {ascending: true});

  if(jugadorError){
    console.error(`Error al buscar jugadores`, error?.message);
  } else if(jugadoresData){
    jugadores = jugadoresData;
    const totalJugadores = 10; // Número total de jugadores permitidos
    const jugadoresFaltantes = totalJugadores - jugadores.length;
    camposVacios = Array.from({ length: Math.max(0, jugadoresFaltantes) });
  }

  const {data: staffData, error: staffError} = await supabaseAdmin
    .from(`Jugadores${torneoID}`)
    .select('nombre, pertenece_equipo, curso, id, _1r_apellido')
    .eq('pertenece_equipo', id)
    .eq('ficha', 'cuerpo_tecnico')
    .order('id', {ascending: true});

  if(staffError){
    console.error(`Error al buscar jugadores`, error?.message);
  } else if(staffData){
    staff = staffData;
    // const totalJugadores = 10; // Número total de jugadores permitidos
    // const jugadoresFaltantes = totalJugadores - jugadores.length;
    // camposVacios = Array.from({ length: Math.max(0, jugadoresFaltantes) });
  }

  const {data: ProfesorData, error: ProfesorError} = await supabaseAdmin
    .from(`Jugadores${torneoID}`)
    .select('nombre, pertenece_equipo, curso, id, _1r_apellido')
    .eq('pertenece_equipo', id)
    .eq('ficha', 'profesor')
    .single();

  if(ProfesorError){
    // console.error(`Error al buscar jugadores`, error?.message);
  } else if(ProfesorData){
   profesor_nombre = ProfesorData.nombre;
   profesor_1r_apellido = ProfesorData._1r_apellido;
   profesor_curso = ProfesorData.curso;
  }
  

} catch (err) {
  console.error('Error al obtener rango:', err);
}
const partidos_perdedores = [];
const TablaPartidos = `Partidos${torneoID}`;
const TablaEquipos = `Equipos${torneoID}`;


function traducirPartido(str: string) {
  // Busca el primer bloque de números en el string
  const match = str.match(/\d+$/);
  const numero = match ? match[0] : "";
  return `Partit ${numero}`;
}

try {
  const { data, error } = await supabaseAdmin
    .from(TablaPartidos)
    .select("pista, equipo_local, equipo_visitante, LocGlobal, VisGlobal, estado, id_partido")
    .or(`equipo_local.eq.${nombre_equipo},equipo_visitante.eq.${nombre_equipo}`)
    ; // o el bracket que quieras

  if (!error && data) {
    for (const fila of data) {
      let pista   = fila.pista ?? "Sin Pista";
      let equipo1 = fila.equipo_local ?? "";
      let escudo1 = "";
      let equipo2 = fila.equipo_visitante ?? "";
      let escudo2 = "";
      let resA    = fila.LocGlobal ?? "-";
      let resB    = fila.VisGlobal ?? "-";
      let estado  = fila.estado ?? "Por Jugar";
      let numero  = traducirPartido(fila.id_partido);

      // Escudo equipo 1
      if (equipo1) {
        const { data: e1, error: err1 } = await supabaseAdmin
          .from(TablaEquipos)
          .select("escudo")
          .eq("nombre_equipo", equipo1)
          .single();
        if (!err1 && e1) escudo1 = e1.escudo;
      }

      // Escudo equipo 2
      if (equipo2) {
        const { data: e2, error: err2 } = await supabaseAdmin
          .from(TablaEquipos)
          .select("escudo")
          .eq("nombre_equipo", equipo2)
          .single();
        if (!err2 && e2) escudo2 = e2.escudo;
      }

      partidos_perdedores.push({
        pista,
        equipo1,
        escudo1,
        equipo2,
        escudo2,
        resultadoA: resA,
        resultadoB: resB,
        estado,
        numero
      });
    }
  }
} catch (err) {
  console.error("Error al obtener partidos perdedores:", err);
}
//console.log(partidos_perdedores);

