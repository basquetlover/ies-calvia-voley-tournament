---
import LayoutMenu from "@layouts/LayoutMenu.astro";
import { EQUIPOS_INSCRITOS } from "@const/equipos-inscritos";
import Equipo404 from "@sections/errores/Equipo404.astro";


const { id } = Astro.params;
const equipo = EQUIPOS_INSCRITOS.find((team) => team.id === id);

---

<LayoutMenu title={equipo ? `${equipo.nombre} | IES Calvià Voley Tournament` : 'Equipo no encontrado | IES Calvià Voley Tournament'}>
  {equipo ? (
    <>
    <section class="max-w-6xl h-auto p-2 m-auto my-10">
  <a href="/equipos#inscritos" class="inline-flex items-center gap-2 px-4 py-2 bg-amarillo text-gray-800 rounded-full hover:scale-110 transition-all duration-300" aria-label="Volver a la página de equipos">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 -960 960 960" class="fill-current">
      <path d="M313-440l224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/>
    </svg>
    Volver a equipos
  </a>
</section>

      {/* <!-- Sección jugadores --> */}
      <section class="max-w-[1600px] h-auto m-auto my-10">
        <h1 class="text-accent text-6xl font-bold text-center">{equipo.nombre}</h1>
        
        {equipo.escudo && equipo.escudo.trim() !== "" ?  (
                <img transition:name="equipo-escudo" src={`/img/escudos/${equipo.escudo}`} alt={`${equipo.nombre} escudo`} class="w-72 h-72 mx-auto my-10" />
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-72 h-72 mx-auto my-10" fill="none" viewBox="0 0 650 650">
                    <circle cx="325" cy="325" r="315" stroke="#313131" stroke-width="20"/>
                    <rect width="450" height="20" x="100" y="315" fill="#313131" rx="10"/>
                </svg>
        )}
        
        
      </section>
      
      <section class="max-w-6xl h-auto m-auto my-10">
        <p class=" text-xl text-blanco font-medium"><span class="text-amarillo font-bold">Capitán</span> {equipo.capitan}</p>
        <p class=" text-xl text-blanco font-medium"><span class="text-amarillo font-bold">Entrenador</span> {equipo.entrenador}</p>

        <div class="w-full h-[2px] my-4 rounded-full bg-accent"></div>

        <h2 class=" text-xl text-amarillo font-bold">Jugadores</h2>
        <table class="text-xl text-blanco font-normal max-w-3xl w-full h-auto my-2">
            <tr><td><h4 class="text-accent font-bold">Nombre</h4></td>    <td><h4 class="text-accent font-bold">Curso</h4></td></tr>
            {
                equipo.jugadores.map((jugador) => (
                    <tr><td>{jugador.nombre}</td>   <td>{jugador.curso}</td></tr>
                ))
            }
        </table>
        
      </section>
    </>
  ) : (
    <Equipo404 /> 
  )}
</LayoutMenu>



