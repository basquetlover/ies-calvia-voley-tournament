---

import Signin from "@components/admin/signin.astro";
import Layout from "@layouts/Layout.astro";


---

<Layout title="Panel de Administración">
    <div class="w-full h-screen flex items-center place-content-center">
        <section class="max-w-2xl w-full h-max p-10 mx-auto my-auto">
            <h2 class=" w-full text-center text-accent font-bold text-5xl">PANEL DE ADMINISTRACIÓN</h2>
            <p class="text-amarillo text-xl text-center mt-10">Has iniciado sesión correctamente</p>
            <p class="text-blanco text-xl text-center my-2">Ahora puedes acceder a todas tus funcionalidades y servicios disponibles. Si tienes alguna pregunta o necesitas ayuda, no dudes en contactarnos.</p>
            <form action="/api/auth/signout" class="w-max mx-auto my-5">
                <button class="px-3 py-2 mx-auto text-azul font-semibold bg-amarillo rounded-full text-xl hover:scale-110 duration-300 transition-all transform flex flex-row items-center place-content-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 30 31">
                        <path class="fill-azul"  d="m27 1 2 1 1 2v24l-1 2-2 1H15v-3h12V4H15V1h12ZM8 8l3 2-5 4h14v4H6l5 4-3 2-8-8 8-8Z"/>
                    </svg>
                    Cerrar Sesión
                </button>
            </form>
        </section>
    </div>
</Layout>