---
import { supabaseAdmin } from "../../../../lib/supabase";
import LayoutOwner from '@layouts/LayoutOwner.astro';
import { CURSOS } from "@const/rangos";
import LayoutStaff from "@layouts/LayoutStaff.astro";
import LayoutUsuarioMenu from "@layouts/LayoutUsuarioMenu.astro";
import ControlStaff from "@components/ControlStaff.astro";
// Tipo explícito para las propiedades esperadas en `Astro.props`

// Tipo explícito para las propiedades esperadas en `Astro.props`
const { data: StaffData, error: fetchOwnerError } = await supabaseAdmin
        .from("Administradores")
        .select(" user_email, nombre, curso, _1r_apellido, _2n_apellido, img")
        .in('rango', ['Owner', 'Co-Owner', 'Staff'])
        .neq('curso', 'Professor')
        .order('id', {ascending: true});

const { data: VoluntariosData, error: fetchVoluntariosError } = await supabaseAdmin
        .from("Administradores")
        .select(" user_email, nombre, curso, _1r_apellido, _2n_apellido, img")
        .in('rango', ['Arbitro', 'Oficial de Mesa'])
        .neq('curso', 'Professor')
        .order('id', {ascending: true});
---
<ControlStaff>
<LayoutUsuarioMenu title=`Equip Voley Tournament Team` descripcion=`Llista de l'equip Equip Voley Tournament Team`>
    <section class="max-w-4xl h-auto p-2 m-auto my-10">
        <a href="/usuario/staff/equipos" class="inline-flex items-center gap-2 px-4 py-2 bg-amarillo text-gray-800 rounded-full hover:scale-110 transition-all duration-300" aria-label="Volver a la página de equipos">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 -960 960 960" class="fill-current">
            <path d="M313-440l224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/>
          </svg>
          Tornar a equips
        </a>
      </section>
    <div class="max-w-4xl mx-auto my-10">
     
      

        <form class="space-y-4" id="equipo-form">

       
          <div class="mx-auto w-max relative mt-4">
            
            <h3 class="mx-auto text-4xl xs:text-3xl sm:text-3xl md:text-4xl text-center border-none bg-transparent rounded text-accent py-2 px-3 w-auto">Equip Voley Tournament Team</h3>
            
            
          </div>
      
          <!--Imagen Escudo -->
          <div class="w-60 h-60 p-4  rounded-xl  relative mx-auto">
            
                <img src="/img/logo_torneo.png" class="w-full h-full" alt={`Logo Equip Voley Tournament Team`} />
                
            
            
          </div>
          
          
          

          <!-- Capitan
          <div class="flex flex-row items-center ml-2">
            <label for="capitan" class="block text-amarillo text-2xl font-medium">Capità</label>
            <p class="border-none ml-2 text-lg text-blanco bg-transparent rounded py-2 px-3 w-auto">{capitan}</p>
             
          </div> -->
        

          


          <div class="w-max flex flex-row gap-2">
            <div class="px-3 py-2 w-96 h-12  text-4xl text-amarillo border-none"><h4>Staff</h4></div>
          </div>
          
          
    {StaffData?.map((jugador, index) => (
