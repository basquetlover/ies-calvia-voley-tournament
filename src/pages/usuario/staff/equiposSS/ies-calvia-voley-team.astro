                  <p class="px-2 py-1 w-72 overflow-hidden h-12 bg-gris-claro flex flex-row items-center rounded-full text-base text-blanco border-none">{jugador.user_email}</p>
              
              </div>
             
              
             </div>
            
          
            </div>    
    ))}


<div class="w-max flex flex-row gap-2">
