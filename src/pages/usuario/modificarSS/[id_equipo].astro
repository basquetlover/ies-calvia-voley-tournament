    .eq('pertenece_equipo', id)
    .eq('ficha', 'jugador')
    .order('id', { ascending: true });

  if(jugadorError){
    console.error(`Error al buscar jugadores`, error?.message);
  } else if(jugadoresData){
    jugadores = jugadoresData;

     // Número total de jugadores permitidos
    const jugadoresFaltantes = totalJugadores - jugadores.length;
    jugadores_extra = Array.from({ length: Math.max(0, jugadoresFaltantes) });
 
