const getCurrentDateInCatalan = () => {
  const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
  const date = new Date();
  return new Intl.DateTimeFormat('ca-ES', options).format(date);
};

const currentDate = getCurrentDateInCatalan();

const handleCheckboxChange = (index: number) => {
    jugadores = jugadores.map((jugador, i) => {
        if (i === index) {
            return {
                ...jugador,
                checkboxChecked: !jugador.checkboxChecked, // Cambia el estado del checkbox
            };
        }
        return jugador;
    });
};


