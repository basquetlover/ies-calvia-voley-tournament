    capitan_email = equipoData.email_capitan;
    capitan_edit= equipoData.capitan_edit;
    probl_tit_logo = equipoData.probl_tit_logo;
  }

  const { data: UsuarioInscripcion } = await supabaseAdmin
    .from('Usuarios')
    .select('nombre, email_microsoft, curso')
    .eq('id', inscrito)
    .single();
    if(UsuarioInscripcion){
