---
import ControlAcces from "@components/ControlAcces.astro";
import LayoutMenu from "@layouts/LayoutMenu.astro";
import LayoutUsuario from "@layouts/LayoutUsuario.astro";
import { supabaseAdmin } from "src/lib/supabase";
import CrearEquipoUser from "@sections/usuarios/CrearEquipoUser.astro";
import { verificarSesion } from "src/lib/session";

const { data: torneo, error: errorTorneos } = await supabaseAdmin
  .from('Configuracion')
  .select('in_inicio, in_fin')
  .eq('estado', 'Actual')
  .single();

// const fechaInicio = new Date('2025-3-10'); // Cambia esta fecha según tus necesidades
// const fechaFin = new Date('2025-3-31'); //


const pathname = Astro.url.pathname;
let accessibleBlocks = [];
let RangoFechas = false;
let YaInscrito = false;
// Obtén las páginas a las que el usuario tiene acceso
try {
    const { data: pageAccess, error } = await supabaseAdmin
        .from('AccesoUsuarios')
        .select('pagina, acceso');

    if (error) {
        console.error("Error al obtener acceso:", error);
    } else if (pageAccess) {
        // Filtra las páginas a las que el usuario tiene acceso
        accessibleBlocks = pageAccess
            .filter(page => page.acceso === true) // Solo páginas con acceso true
            .map(page => page.pagina); // Obtiene solo las páginas
        // console.log(accessibleBlocks);
    }

    
} catch (err) {
    console.error("Error al obtener acceso:", err);
}
// Verifica si el usuario tiene acceso a la página actual
let userHasAccess = accessibleBlocks.includes(pathname);

if(userHasAccess){
   

const fechaActual = new Date();

console.log(fechaActual, torneo?.in_inicio)
// Compara la fecha actual con las fechas de inicio y fin
const fechaInicio = new Date(torneo?.in_inicio);
const fechaFin = new Date(torneo?.in_fin);

const formatoFecha = (fecha: Date) => {
  const dia = fecha.getDate().toString().padStart(2, '0');
  const mes = (fecha.getMonth() + 1).toString().padStart(2, '0'); // enero es 0
  const año = fecha.getFullYear();
  const hora = fecha.getHours().toString().padStart(2, '0');
  const minutos = fecha.getMinutes().toString().padStart(2, '0');

  return `${dia}/${mes}/${año} a les ${hora}:${minutos}`;
};

const fechaInicioTexto = formatoFecha(fechaInicio);
const fechaFinTexto = formatoFecha(fechaFin);

if (fechaActual < fechaInicio) {
  RangoFechas = false;
  console.log("Fuera del rango: antes de la fecha de inicio");
} else if (fechaActual > fechaFin) {
  RangoFechas = false;
  console.log("Fuera del rango: después de la fecha de fin");
} else {
  RangoFechas = true;
  console.log("Dentro del rango de fechas");
}
    
}
const usuario = await verificarSesion(Astro.request);
let { data: Usuarios, error } = await supabaseAdmin
    .from('JugadoresV')
    .select('email')
if (Usuarios) {
  

if(usuario){
    console.log("Usuario de inscripcion: ", usuario.email, usuario.curso, usuario.nombre);
    const { data: adminData, error } = await supabaseAdmin
            .from("Administradores")
            .select("rango, user_email")
            .eq("user_email", usuario.email)
            .single();
if(error){
    console.log(
        "Usuario sin cuenta de admin"
    )
}
// adminData?.rango === "Owner" || 
if(adminData?.rango === "Owner" || adminData?.rango === "Co-Owner" || adminData?.rango === "Staff"){
    RangoFechas = true;

    const { data: adminAccess } = await supabaseAdmin
        .from('AccesoUsuarios')
        .select('acceso')
        .eq('pagina', 'AdminMode')
        .single();
        if(adminAccess){
            if(adminAccess.acceso === true)
            RangoFechas = true;
        }
}

  // Verificar si ya existe un usuario con el mismo email
  const userExistsByEmail = Usuarios.some(jugador => jugador.email === usuario.email);
  
  if (userExistsByEmail) {
    YaInscrito = true;
  }
}
    

}
---
<ControlAcces>
    {YaInscrito === false ? (
        <>
        {RangoFechas === true ? (
            <LayoutUsuario title="Inscripció Torneig Setmana Santa | IES Calvià Voley Tournament" descripcion="" >
                <CrearEquipoUser />
            </LayoutUsuario>
            ) : (
                <LayoutMenu title="No Disnponible | IES Calvià Voley Tournament" descripcion="Registret per poder aprofitar de totes les ventatges de formar part de la familia IES Calvià Voley Tournament">
                    
    <div class="w-full h-auto flex items-center place-content-center">
        <section class="max-w-2xl w-full h-max p-10 mx-auto my-auto">
            <h2 class=" w-full text-center text-accent font-bold text-5xl">Inscripcions Tancades</h2>
            
            <p class="text-blanco text-xl text-center my-2">
                Actualment aquest apartat no es troba disponible. Si creus que es tracta d'un error, posa't en <a href="/contacto" class="hover:text-amarillo transition-all duration-300">contacte amb el Staff</a>.
            </p>
            <p class="text-amarillo text-xl text-center my-2">
                Terme d'inscripcions: {fechaInicioTexto} fins a {fechaFinTexto}
            </p>
            
                <a href="/" class="px-3 py-2 w-max mx-auto my-5 text-azul font-semibold bg-amarillo rounded-full text-xl hover:scale-110 duration-300 transition-all transform flex flex-row items-center place-content-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 -960 960 960" class="fill-current">
                        <path d="M313-440l224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/>
                    </svg>
                    Tornar enrere
                </a>
            </section>
    </div>
                </LayoutMenu>
        )}
        </>
        ) : (
        <LayoutMenu title="No Disnponible | IES Calvià Voley Tournament" descripcion="Registret per poder aprofitar de totes les ventatges de formar part de la familia IES Calvià Voley Tournament">
            
            <div class="w-full h-auto flex items-center place-content-center">
            <section class="max-w-2xl w-full h-max p-10 mx-auto my-auto">
                <h2 class=" w-full text-center text-accent font-bold text-5xl uppercase">Ja estàs inscrit</h2>
                
                <p class="text-blanco text-xl text-center my-2">
                   Ja formes part d'un equip. Si creus que es tracta d'un error, posa't en <a href="/contacto" class="hover:text-amarillo transition-all duration-300">contacte amb el Staff</a>.
                </p>

                
                    <a href="/usuario" class="px-3 py-2 w-max mx-auto my-5 text-azul font-semibold bg-amarillo rounded-full text-xl hover:scale-110 duration-300 transition-all transform flex flex-row items-center place-content-center gap-1">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 -960 960 960" class="fill-current">
                            <path d="M313-440l224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z"/>
                        </svg>
                        Modificar Equip
                    </a>
                </section>
            </div>
        </LayoutMenu>
)}

</ControlAcces>


    
   