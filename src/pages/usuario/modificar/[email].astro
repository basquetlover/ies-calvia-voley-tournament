import LayoutUsuario from "@layouts/LayoutUsuario.astro";

import {CURSO_3E, CURSO_4E, CURSO_1B, CURSO_2B, CURSO_FP, CURSO_P } from "@const/registrarse";
// export const jugadores = Array.from({ length: 6 }, () => ({ nombre: "", curso: "" }));

//export const staff = Array.from({ length: 5 }, () => ({ nombre: "", curso: "" }));
import FormSend from "@components/FormSend.astro";



import { supabaseAdmin } from "src/lib/supabase";

import __AstroComponent_ from "src/pages/404.astro";
import ControlAccesVoluntarios from "@components/ControlAccesVoluntarios.astro";
const pathname = "/usuario/modificar";
let accessibleBlocks = [];

type AdministradorProps = {
    id_equipo: string;
    nombre_equipo: string;
};

// Genera rutas dinámicas
export async function getStaticPaths() {
  // Consulta a la base de datos para obtener user_email y rango
  const { data, error } = await supabaseAdmin
    .from('Voluntarios')
    .select('email, nombre');

  if (error) {
    console.error('Error fetching administradores:', error.message);
    return { paths: [] };
  }

  // Genera las rutas dinámicas con datos adicionales
  const paths = data.map((equipo) => ({
    params: { email: equipo.email },
    props: { nombre_equipo: equipo.nombre }, // Pasamos rango como parte de los props
  }));

  return { paths };
}
const email = Astro.url.pathname.split('/').pop();

let nombre = "";
let _1r_apellido = "";
let _2n_apellido = "";
let curso = "";
let genero = "";
let tipo = "";
let descripcion = "";
let estado = "";
let fecha_inscripcion = "";
let observacion = "";
let voluntario_id = "";


const { data, error } = await supabaseAdmin
    .from('Voluntarios')
    .select('id, email, nombre, _1r_apellido,genero,  _2n_apellido, curso, tipo, descripcion, estado, fecha_inscripcion, observacion ')
    .eq('email', email)
    .single();

    if(data){
         nombre = data.nombre;
         _1r_apellido = data._1r_apellido;
         _2n_apellido = data._2n_apellido;
         curso = data.curso;
         genero = data.genero;
         tipo = data.tipo;
         descripcion = data.descripcion;
         estado = data.estado;
         fecha_inscripcion = data.fecha_inscripcion;
         observacion = data.observacion;
         voluntario_id = data.id;
    }

const getCurrentDateInCatalan = () => {
  const options: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
  const date = new Date();
  return new Intl.DateTimeFormat('ca-ES', options).format(date);
};

const currentDate = getCurrentDateInCatalan();

