---
import ControlAcces from "@components/ControlAcces.astro";
import SignInGoogle from "@components/Google/SignInGoogle";
import SignUp from "@components/Google/SignUp.astro";
import {CURSO_1E, CURSO_2E, CURSO_3E, CURSO_4E, CURSO_1B, CURSO_2B, CURSO_FP, CURSO_P } from "@const/registrarse";
import LayoutMenu from "@layouts/LayoutMenu.astro";

const { searchParams } = new URL(Astro.request.url);
let credential = searchParams.get('credential');
let nombre_real = "";
let apellidos = "";
let email_google = "";
if (credential) {
  // Eliminar comillas si las hubiera
  credential = credential.replace(/^"(.*)"$/, '$1');
  const payload = JSON.parse(atob(credential.split('.')[1]));
    // const { name, email } = payload;
    const { email, given_name, family_name } = payload;

    nombre_real = given_name;
    apellidos = family_name;
    email_google = email;
    
}


    
