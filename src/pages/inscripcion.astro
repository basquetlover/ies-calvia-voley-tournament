---
import LayoutMenu from "@layouts/LayoutMenu.astro";

import InscripcionDescripcion from "@sections/inscripcion/InscripcionDescripcion.astro";
import RequisitosInscripcion from "@sections/inscripcion/RequisitosInscripcion.astro";
import CountdownInscripcion from "@sections/inscripcion/CountdownInscripcion.astro";

import DescripcionSection from "@components/DescripcionSection.astro";
import Boton from "@components/Boton.astro";
---

<LayoutMenu title="Inscripció | IES Calvià Voley Tournament" descripcion="Inscríbete ahora al Torneo de Voleibol del IES Calvià - Edición Navidad y asegura tu lugar en la competencia.">
    <InscripcionDescripcion />
    <CountdownInscripcion />
    <RequisitosInscripcion />

    <section class="max-w-4xl h-auto m-auto my-10  cursor-pointer">
        <a href="https://forms.gle/PVbwWs238qP9F3Y98" target="_blank" class="w-full h-auto flex relative">
            <img class="w-full h-auto rounded-xl sombra " src="/img/formulario_inscripcion.png" alt="Imagen Formulario inscripción"/>
            <!--
            <div class="centrar w-full h-full opacidad"></div>
        -->
            <div class="centrar">
                <p class=" text-6xl text-girs-claro xs:text-4xl sm:text-4xl md:text-5xl font-bold">ALUMNES</p>
            </div>
            
        </a>
    </section>
    <div class="mt-3 w-[95%] mx-auto h-[2px] bg-accent"></div>
    <section class="max-w-4xl h-auto m-auto my-10  cursor-pointer">
        <a href="https://forms.gle/kyPUM2hj4nmiNmee6" target="_blank" class="w-full h-auto flex relative">
            <img class="w-full h-auto rounded-xl sombra " src="/img/formulario_inscripcion_profesores.png" alt="Imagen Formulario inscripción"/>
            <!--
            <div class="centrar w-full h-full opacidad"></div>
            -->
            <div class="centrar">
                <p class=" text-6xl text-gris-claro xs:text-4xl sm:text-4xl md:text-5xl font-bold">PROFESSORS</p>
            </div>
            
        </a>
    </section>

    
    <div class="w-max h-max m-auto ">
        <a href="/contacto" class="h-max w-max py-2 px-4 mx-auto mt-10  text-2xl xs:text-xl sm:text-xl md:text-2xl bg-amarillo rounded-full text-azul font-medium text-center transform hover:scale-110 duration-300 transition-transform ">
            ¿Tienes Dudas sobre la Inscripción?
        </a>
    </div>
     
     
    
    
</LayoutMenu>

<style>
    .sombra {
        mask-image: linear-gradient(#000 95%, transparent);
    }

    .centrar {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .opacidad {
        background-color: rgba(27, 29, 32, 0.4);
        color: #1B1D20;
    }

    .texto-rotado {
        transform: rotate(-25deg);
        transform-origin: center;
    }
</style>
