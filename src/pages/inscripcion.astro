---
import LayoutMenu from "@layouts/LayoutMenu.astro";

import InscripcionDescripcion from "@sections/inscripcion/InscripcionDescripcion.astro";
import RequisitosInscripcion from "@sections/inscripcion/RequisitosInscripcion.astro";
import CountdownInscripcion from "@sections/inscripcion/CountdownInscripcion.astro";

import DescripcionSection from "@components/DescripcionSection.astro";
import Boton from "@components/Boton.astro";
import { verificarSesion } from "src/lib/session";

const fechaInicio = new Date('2025-3-10'); // Cambia esta fecha según tus necesidades
const fechaFin = new Date('2025-3-31'); // Cambia esta fecha según tus necesidades

let RangoFechas = false;

const fechaActual = new Date();

const usuario = await verificarSesion(Astro.request);
if(usuario){
    console.log("Usuario de inscripcion: ", usuario.email, usuario.curso, usuario.nombre)
}

// Compara la fecha actual con las fechas de inicio y fin
if (fechaActual < fechaInicio) {
    RangoFechas = false;
    console.log("Fuera del rango: antes de la fecha de inicio");
} else if (fechaActual > fechaFin) {
    RangoFechas = false;
    console.log("Fuera del rango: después de la fecha de fin");
} else {
    RangoFechas = true;
    console.log("Dentro del rango de fechas");
}
---

<LayoutMenu title="Inscripció | IES Calvià Voley Tournament" descripcion="Inscríbete ahora al Torneo de Voleibol del IES Calvià - Edición Navidad y asegura tu lugar en la competencia.">
    <InscripcionDescripcion />
    <CountdownInscripcion />
    <RequisitosInscripcion />
    {RangoFechas === true ? (<>
    <section class="max-w-4xl h-auto m-auto my-10  cursor-pointer">
        <a href="/usuario/inscripcion" target="_blank" class="w-full h-auto flex relative ">
            <img class="w-full h-auto rounded-xl sombra " src="/img/formulario_inscripcion.png" alt="Imagen Formulario inscripción"/>
            
            {/* <div class="centrar w-full h-full opacidad"></div>
             <div class="centrar">
                <p class=" text-5xl text-amarillo xs:text-2xl sm:text-2xl md:text-5xl font-bold">TANCADA</p>
            </div> */}
       
            <div class="esquina bg-azul w-max h-auto p-2 flex items-center place-content-center">
                <p class=" text-2xl text-amarillo xs:text-lg sm:text-lg md:text-xl font-bold">ALUMNES</p>
            </div>
            
        </a>
    </section>
    </>):(<>
    <section class="max-w-4xl h-auto m-auto my-10  cursor-not-allowed">
        <a href="/usuario/inscripcion" target="_blank" class="w-full h-auto flex relative pointer-events-none">
            <img class="w-full h-auto rounded-xl sombra " src="/img/formulario_inscripcion.png" alt="Imagen Formulario inscripción"/>
            
            <div class="centrar w-full h-full opacidad"></div>
             <div class="centrar">
                <p class=" text-5xl text-amarillo xs:text-2xl sm:text-2xl md:text-5xl font-bold">TANCADA</p>
            </div>
       
            <div class="esquina bg-azul w-max h-auto p-2 flex items-center place-content-center">
                <p class=" text-2xl text-amarillo xs:text-lg sm:text-lg md:text-xl font-bold">ALUMNES</p>
            </div>
            
        </a>
    </section>
    </>)}

    
    <!-- <div class="mt-3 w-[95%] mx-auto h-[2px] bg-accent"></div>
    <section class="max-w-4xl h-auto m-auto my-10  cursor-pointer">
        <a href="https://forms.gle/kyPUM2hj4nmiNmee6" target="_blank" class="w-full h-auto flex relative">
            <img class="w-full h-auto rounded-xl sombra " src="/img/formulario_inscripcion_profesores.png" alt="Imagen Formulario inscripción"/>
           
            <div class="esquina bg-azul w-max h-auto p-2 flex items-center place-content-center">
                <p class=" text-2xl text-amarillo xs:text-lg sm:text-lg md:text-xl font-bold">PROFESSORS</p>
            </div>
            
        </a>
    </section> -->
    <p class="text-base text-blanco max-w-[1600px] h-auto m-auto my-10">
        El torneig IES Calvià Voley Tournament és una gran oportunitat per a tots els estudiants de la comunitat educativa per competir, gaudir del voleibol i fomentar l'esperit esportiu. A través d'aquest apartat d'inscripció, volem fer que el procés sigui el més fàcil i accessible possible. Si tens qualsevol dubte, no dubtis en contactar-nos. Estem aquí per ajudar-te a completar la inscripció i a preparar-te per a una experiència inoblidable.
    </p>


    
    <div class="w-max h-max m-auto ">
        <a href="/contacto" class="h-max w-max py-2 px-4 mx-auto mt-10  text-2xl xs:text-xl sm:text-xl md:text-2xl bg-amarillo rounded-full text-azul font-medium text-center transform hover:scale-110 duration-300 transition-transform ">
            Tens Dubtes sobre la Inscripció?
        </a>
    </div>
     
     
    
    
</LayoutMenu>

<style>
    .sombra {
        mask-image: linear-gradient(#000 95%, transparent);
    }

    .esquina {
        position: absolute;
        top: 0%;
        left: 0%;
        border-radius: 10px 0 10px 0 ;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .centrar {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        border-radius: 10px 0 10px 0 ;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .opacidad {
        background-color: rgba(27, 29, 32, 0.4);
        color: #1B1D20;
    }

    .texto-rotado {
        transform: rotate(-25deg);
        transform-origin: center;
    }
</style>
