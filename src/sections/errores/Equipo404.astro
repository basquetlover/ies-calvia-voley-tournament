---
import Boton from "@components/Boton.astro";

---
<section class="max-w-6xl h-auto grid grid-cols-2 grid-rows-1 gap-5 place-items-center m-auto">
    <img src="/img/404.png" alt="error 404"/>
    <div class="flex flex-col items-center justify-center">
        <h4 class="text-accent text-4xl text-center">EQUIPO NO ENCONTRADO</h4>
        <p class="text-2xl text-center text-blanco">¡Hola! Lo sentimos, pero no pudimos encontrar el equipo que buscabas. Verifica que la dirección URL sea correcta.</p>
        <Boton href="/equipos"> Volver a todos los equipos</Boton>
    </div>
</section>