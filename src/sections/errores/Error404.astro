---
import Boton from "@components/Boton.astro";

---
<section class="max-w-6xl h-auto grid grid-cols-2 grid-rows-1 xs:grid-cols-1 xs:grid-rows-2 sm:grid-cols-1 sm:grid-rows-2 md:grid-cols-2 md:grid-rows-1 gap-5 place-items-center m-auto">
    <img src="/img/404.png" alt="error 404"/>
    <div class="flex flex-col items-center justify-center">
        <h4 class="text-accent text-4xl text-center">PÀGINA NO TROBADA</h4>
        <p class="text-2xl text-center text-blanco">Hola! Ho sentim, però no vam poder trobar el que buscaves. Verifica que l'adreça URL sigui correcta.</p>
        <Boton href="/"> Tornar a l'inici</Boton>
    </div>
</section>