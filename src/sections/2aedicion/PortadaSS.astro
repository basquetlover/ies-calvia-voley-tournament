---
import DescripcionSection from "@components/DescripcionSection.astro";
---

<DescripcionSection>
<div class="max-w-7xl w-auto mx-auto h-auto relative">
    <img src="/img/galeria/general-1.webp" alt="Imatge general pabelló" class="w-full h-auto min-h-96 object-cover rounded-md"/>
    <div class="bg-azul bg-opacity-80 flex flex-col items-center gap-2 w-max py-4 px-10  rounded-lg alinear xs:scale-50 sm:scale-50 md:scale-100 transform">
        <h2 class="text-3xl text-accent font-semibold underline xs:text-xl sm:text-xl md:text-3xl">SEGONA EDICIÓ</h4>
        <h1 class="text-5xl text-amarillo font-bold xs:text-3xl sm:text-3xl md:text-5xl">TORNEIG DE SETMANA SANTA</h1>
        <h2 class="text-4xl text-accent font-semibold xs:text-2xl sm:text-2xl md:text-4xl">16 / 04 / 2025 </h2>
    </div>
</div>
</DescripcionSection>

<style>
    .alinear{
        position: absolute;
        top: 30px;
        left: 50%;
        transform: translateX( -50%);
}
</style>