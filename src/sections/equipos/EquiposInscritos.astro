---
import { EQUIPOS_INSCRITOS } from "@const/equipos-inscritos"
---
<section class="max-w-[1600px] h-auto m-auto my-10 ">
    <h3 class="text-accent text-4xl font-bold ">Equipos Inscritos</h3>
   
    <div class="max-w-[1400px] h-auto grid grid-cols-3 grid-rows-1 gap-3 mt-6 place-items-center xs:grid-cols-1 xs:grid-rows-1 sm:grid-cols-1 sm:grid-rows-1 md:grid-cols-3 md:grid-rows-1 ">
        {
            EQUIPOS_INSCRITOS.map(({id, nombre, escudo, capitan}) => (
                <a href={`equipos/${id}`}  class=" w-64 h-w-64 p-4 rounded-lg bg-amarillo grid grid-cols-1 grid-rows-[auto_1fr_auto] hover:scale-105 transition-all duration-300">
                    <p class="text-azul text-2xl font-semibold">{nombre}</p>
                    <div class="flex place-content-center justify-center w-full h-full ">
                        <img class="w-40 h-40" src={`img/escudos/${escudo}`} alt={`escudo equipo ${nombre}`} />
                    </div>
                    <p class="text-azul text-xl"><span class="font-semibold">Capitan:</span> {capitan}</p>
                </a>
            ))
        }
    </div>
    
</section>