---
import { EQUIPOS_INSCRITOS } from "@const/equipos-inscritos"
---
<section class="max-w-[1600px] h-auto m-auto my-10 " id="inscritos">
    <h3 class="text-accent text-4xl font-bold ">Equips Inscrits</h3>
   
    <div class="max-w-[1600px] h-auto grid grid-cols-4 grid-rows-1 gap-10 mt-6 place-items-center xs:grid-cols-1 xs:grid-rows-1 sm:grid-cols-2 sm:grid-rows-1 md:grid-cols-3 md:grid-rows-1 ">
        {
            EQUIPOS_INSCRITOS.map(({id, nombre, escudo, capitan}) => (
                <a href={`equipos/${id}`}  class=" w-72 h-72 p-4 rounded-lg bg-amarillo grid grid-cols-1 grid-rows-[auto_1fr_auto] hover:scale-105 transition-all duration-300">
                    <p class="text-azul text-2xl font-semibold" translate="no">{nombre}</p>
                    <div class="flex place-content-center justify-center w-full h-full ">
                        {escudo && escudo.trim() !== "" ?  (
                            <img transition:name="equipo-escudo" class="w-40 h-40 rounded-lg" src={`/img/escudos/${escudo}`} alt={`escudo equipo ${nombre}`} />
                            ) : (
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-40 h-w-40" fill="none" viewBox="0 0 650 650">
                                    <circle cx="325" cy="325" r="315" stroke="#313131" stroke-width="20"/>
                                    <rect width="450" height="20" x="100" y="315" fill="#313131" rx="10"/>
                                </svg>
                        )}
                        
                    </div>
                    <p class="text-azul text-xl"><span class="font-semibold">Capità:</span> {capitan}</p>
                </a>
            ))
        }
    </div>
     
    
</section>
