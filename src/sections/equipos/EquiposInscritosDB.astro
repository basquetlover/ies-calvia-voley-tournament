---

import { supabaseAdmin } from '../../lib/supabase';
interface Equipo {
  id_equipo: string;
  nombre_equipo: string;
  capitan: string;
  entrenador: string;
  ganador: string;
  escudo: string | null; // o string dependiendo de si puede ser nulo
}
// Obtener los equipos de la base de datos
const { data: equipos, error } = await supabaseAdmin
  .from('Equipos')
  .select('id_equipo, nombre_equipo, capitan, entrenador, escudo, ganador')
  .order('id', { ascending: true });


if (error) {
  console.error('Error al obtener los equipos:', error);
} else if (!equipos || equipos.length === 0) {
  console.log('No se encontraron equipos');
} else {
  console.log(`Se encontraron ${equipos.length} equipos`);
}
const equipo = {
  ganador: "Ejemplo" // Cambia esto según tu lógica
};
---
{!equipos || equipos.length === 0  && (
  <>
  <div class="w-full h-auto mt-10 flex items-center place-content-center">
  <section class="max-w-2xl w-full h-max p-0 mx-auto my-auto">
      <h2 class=" w-full text-center text-amarillo uppercase font-bold text-4xl">No se encontraron equipos</h2>
      
      <p class="text-blanco text-xl text-center my-2">
      Aun no hay equipos inscritos.
      </p>
      
          
  
      </section>
  </div>
  </>
  )}
<section class="max-w-[1600px] h-auto m-auto my-10 " id="inscritos">
    <h3 class="text-accent text-4xl font-bold ">Equips Inscrits</h3>
    <div class="max-w-[1600px] h-auto grid grid-cols-4 grid-rows-1 gap-20 mt-6 place-items-center xs:grid-cols-1 xs:grid-rows-1 sm:grid-cols-2 sm:grid-rows-1 md:grid-cols-3 md:grid-rows-1 ">
        {equipos && equipos.map((equipo) => (
        <a href={`/equipos/${equipo.id_equipo}`} class={`w-72 h-72 p-4 relative rounded-lg  hover:scale-105 transition-all duration-300 ${equipo.ganador && equipo.ganador.trim() !== "" ? 'bg-azul text-amarillo' : 'bg-amarillo text-azul'}`}>
          {equipo.ganador && equipo.ganador.trim() !== "" ? (
            <div class="corona w-[190px] h-[60px] flex items-center place-content-center mx-auto">
              <svg xmlns="http://www.w3.org/2000/svg" class="scale-y-50 scale-x-75" fill="none" viewBox="0 0 250 120">
                <path class="fill-gold" d="M38 121 22 54h-3c-5 0-10-1-14-3-3-3-5-6-5-9 0-4 2-6 5-9 4-2 9-4 14-4s9 2 13 4c4 3 6 5 6 9l-1 3-1 2 39 11 39-35-6-4-2-6c0-4 2-6 6-9 3-2 8-3 13-3s10 1 13 3c4 3 6 5 6 9l-2 6-6 4 39 35 39-11-1-2v-3c0-4 1-6 5-9 4-2 8-4 13-4s10 2 14 4c3 3 5 5 5 9 0 3-2 6-5 9a24 24 0 0 1-17 3l-15 67H38Zm6-8h160l14-57-46 12-47-41-48 41-45-12 12 57Z"/>
              </svg>
            </div>
            ):(
              <></>
            )}
          
            <div class="w-full h-full  grid grid-cols-1 grid-rows-[auto_1fr_auto]">
            <p class=" text-2xl font-semibold" translate="no">{equipo.nombre_equipo}</p>
            <div class="flex items-center justify-center w-full h-full">
                {equipo.escudo && equipo.escudo.trim() !== "" ? (
                <img 
                    transition:name="equipo-escudo" 
                    class="w-40 h-40 rounded-lg" 
                    src={equipo.escudo} 
                    alt={`escudo equipo ${equipo.nombre_equipo}`} 
                />
                ) : (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-40 h-w-40" fill="none" viewBox="0 0 650 650">
                    <circle cx="325" cy="325" r="315" stroke="#313131" stroke-width="20"/>
                    <rect width="450" height="20" x="100" y="315" fill="#313131" rx="10"/>
                </svg>
                )}
            </div>
            <p class=" text-xl"><span class="font-semibold">Capità:</span> {equipo.capitan}</p>
            </div>
            
        </a>
        ))}
 
    </div>
</section>

<style>
  .corona{
    z-index: 1000000;
    position: absolute;
    top: -65px;
    left: 50%;
    transform: translateX(-50%);
  }
</style>