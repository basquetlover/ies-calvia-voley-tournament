---
import { CONTACTO } from "@const/contacto";
---

<section class="max-w-5xl h-auto m-auto my-10 flex flex-wrap items-stretch gap-6 place-content-center">
    {
        CONTACTO.map(({nombre, tooltip, cargo, email, descripcion}) => (
            <article class="max-w-[400px] w-full  p-3 flex flex-col bg-amarillo flex-grow rounded-xl">
                {/* Nombre */}
                <h4 class="text-accent font-semibold text-2xl m-1" translate="no">{nombre}</h4>
                {/* Cargo */}
                <h5 class="text-azul font-semibold text-2xl m-2">{cargo}</h5>
                {/* Contacto */}
                <a href={`https://mail.google.com/mail/?view=cm&fs=1&to=${email}`} target="_blank"  class="flex flex-row content-center m-2 relative">
                    <svg class="fill-azul w-[30px] h-auto"  viewBox="0 -960 960 960">
                        <path d="M160-160q-33 0-56-23t-24-57v-480q0-33 24-56t56-24h640q33 0 57 24t23 56v480q0 33-23 57t-57 23H160Zm320-280L160-640v400h640v-400L480-440Zm0-80 320-200H160l320 200ZM160-640v-80 480-400Z"/>
                    </svg>
                    <p class="text-azul font-medium text-base ">{email}</p>
                    
                    <div class="tooltip">Enviar email a {tooltip}</div>
                </a>
                {/* Descripcion cargo */}
                <p class="text-azul text-base">{descripcion}</p>
            </article>
        ))
    }
</section>




<style>
    .tooltip {
  position: absolute;
  top: -30px;
  left: 50%;
  transform: translateX(-50%);
  background-color: #313131; /* White background */
  color: #1666FF; /* Black text */
  padding: 6px 10px;
  border-radius: 5px;
  opacity: 0;
  visibility: hidden;
  font-size: 14px;
  transition: all 0.3s ease;
  font-weight: normal; /* Made bolder */
}
    a:hover .tooltip {
  opacity: 1;
  visibility: visible;
  top: -50px;
}
</style>