---
import { supabaseAdmin } from '../../lib/supabase';

interface Noticia {
  id: number;
  slug: string;
  titular: string;
  categoria: string;
  publication_date: string;
  cover_image: string | null;
}

// Obtener las noticias de la base de datos
const { data: equipos, error } = await supabaseAdmin
  .from('Noticis')
  .select('titular, categoria, publication_date, slug, id, cover_image ')
  .order('publication_date', { ascending: false }); // Ordenar de mayor a menor

if (error) {
  console.error('Error al obtener las noticias:', error);
}

const topNoticias = equipos && equipos.length > 0 ? equipos.slice(0, 3) : [];

const mesosCatala = ['gen.', 'febr.', 'març', 'abr.', 'maig', 'juny', 'jul.', 'ag.', 'set.', 'oct.', 'nov.', 'des.'];

function formatDataCatalaFromISO(isoString?: string): string {
  if (!isoString) {
    return "Data inválida";
  }

  const date = new Date(isoString);
  
  if (isNaN(date.getTime())) {
    return "Data inválida";
  }

  const dia = date.getDate();
  const mes = mesosCatala[date.getMonth()];
  const any = date.getFullYear();

  return `${dia} ${mes} ${any}`;
}
---

<div class="flex justify-center mt-10">
  <div class="grid grid-cols-3 gap-4 place-items-center xs:grid-cols-1 sm:grid-cols-1 md:grid-cols-3">
    {topNoticias.length === 0 ? (
      <div class="text-center col-span-3">
        <h2 class="text-amarillo uppercase font-bold text-4xl">No se encontraron noticias</h2>
        <p class="text-blanco text-xl my-2">Aún no hay noticias introducidas en la base de datos.</p>
      </div>
    ) : (
      topNoticias.map((noticia, index) => {
        const isCenter = index === 0; // El primer elemento es el de mayor ID
        const sizeClass = isCenter ? 'scale-100 z-10 bg-gris-claro hover:scale-105' : 'scale-90 grid xs:hidden sm:hidden md:grid hover:scale-95';
        
        return (
          <article 
            class={`w-80 h-96 relative rounded-lg  pointer group  transition-all  duration-300 ${sizeClass}`}
            style={isCenter ? 'grid-column: 2; grid-row: 1;' : (index === 1 ? 'grid-column: 1; grid-row: 1; -z-10' : 'grid-column: 3; grid-row: 1; -z-10')}
          >
          <a 
            href={`/noticias/${noticia.slug}`}
            class={`w-80 h-96 relative rounded-lg bg-gris-claro pointer group  transition-all  duration-300 ${sizeClass}`}
            style={isCenter ? 'grid-column: 2; grid-row: 1;' : (index === 1 ? 'grid-column: 1; grid-row: 1; -z-10' : 'grid-column: 3; grid-row: 1; -z-10')}
          >
            <div class="flex flex-col h-full">
              <div class="flex items-center justify-center w-full h-auto max-h-44 overflow-hidden">
                {noticia.cover_image ? (
                  <img 
                    class="w-full h-full rounded-lg" 
                    src={noticia.cover_image} 
                    loading="lazy"
                    alt={`escudo noticia ${noticia.titular}`} 
                  />
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-40 h-40" fill="none" viewBox="0 0 650 650">
                    <circle cx="325" cy="325" r="315" stroke="#313131" stroke-width="20"/>
                    <rect width="450" height="20" x="100" y="315" fill="#313131" rx="10"/>
                  </svg>
                )}
              </div>
              <div class="flex flex-row items-center px-3 my-2 justify-between">
                <p class="text-accent text-xl underline max-w-[50%] w-full">{noticia.categoria}</p>
                <p class="text-amarillo  text-xl max-w-[50%] w-full">{formatDataCatalaFromISO(noticia.publication_date)}</p>
              </div>
              <p class="text-accent text-4xl puntos font-semibold px-2" translate="no">{noticia.titular}</p>
            </div>
          </a>
        </article>
        )
      })
    )}
  </div>
 
</div>

  <div class="w-full flex justify-center mt-5">
  <a href="/noticias" class="mx-auto w-max h-auto px-4 py-3 rounded bg-accent text-blanco font-semibold text-2xl transition-all duration-300 hover:scale-105 hover:text-amarillo">
      Més  Notícies...
    </a>
  </div>
 
  

<style>
  .puntos{
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
</style>
