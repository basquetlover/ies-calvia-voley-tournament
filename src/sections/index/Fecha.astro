---
import DescripcionSection from "@components/DescripcionSection.astro";

import { supabaseAdmin } from "src/lib/supabase";
const { data: torneo, error: errorTorneos } = await supabaseAdmin
  .from('Configuracion')
  .select('in_inicio, in_fin, fecha')
  .eq('estado', 'Actual')
  .single();

  function formatarDataCatalan(dataStr: string | number | Date) {
  const date = new Date(dataStr);
  const formatterDay = new Intl.DateTimeFormat('ca-ES', { day: 'numeric' });
  const formatterMonth = new Intl.DateTimeFormat('ca-ES', { month: 'long' });

  const dia = formatterDay.format(date);
  const mes = formatterMonth.format(date);

  // Meses en catalán van en minúscula y la preposición "de" se incluye manualmente
  return `${dia} de ${mes}`;
}

const inicioFormateado = formatarDataCatalan(torneo?.in_inicio);
const finFormateado = formatarDataCatalan(torneo?.in_fin);
const fechaFormateada = formatarDataCatalan(torneo?.fecha);
---

<DescripcionSection>
 <h3 class="text-center text-blanco uppercase font-semibold text-5xl xs:text-3xl sm:text-4xl md:text-5xl">{fechaFormateada}</h3>
    <a href="https://maps.app.goo.gl/VTPP4ENdYY8xfinr8" target="_blank" class="text-blanco   hover:text-amarillo duration-300 w-max my-2 group text-3xl xs:text-xl sm:text-xl md:text-3xl mx-auto text-center flex content-center items-center">
        <span class="w-5 h-5">
            <svg class="w-5 h-5 xs:w-4 xs:h-4 sm:w-4 sm:h-4 md:w-5 md:h-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 32 46">
                <path class="fill-blanco group-hover:fill-amarillo duration-300" d="M13 0 4 5c-3 4-5 9-3 14 1 5 4 12 10 20l5 6 4-6c6-8 9-14 11-19 1-3 0-7-1-11-3-6-10-10-17-9Zm5 10 3 4c1 3 0 5-3 7h-5c-2-1-3-3-3-5l2-4c1-2 4-2 6-2Z"/>
              </svg>
        </span>
        POLIESPORTIU GALATZO
    </a>
    <h1 class="text-center text-amarillo uppercase font-semibold text-5xl xs:text-3xl sm:text-4xl md:text-5xl">IES Calvià Voley Tournament</h1>
    <h2 class="text-accent  w-max my-2 group text-5xl xs:text-2xl sm:text-3xl md:text-5xl mx-auto text-center">Més que un simple torneig</h2>
</DescripcionSection>