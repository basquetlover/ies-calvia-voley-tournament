        href: "/equipos",
        img: "equipos",
    },
    {
        name: "informació",
        href: "/informacion",
        img: "información",
    },
    {
        name: "bases de competició",
        href: "/bases-de-competicion",
        img: "bases-de-competición",
    },
    {
        name: "Clasificació",
        href: "/clasificacion",
        img: "clasificacion"
    }
]
---

