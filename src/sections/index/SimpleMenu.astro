---
export const ENLAZES_IMPORTANTE = [
    {
        name: "equipos",
        href: "/equipos",
    },
    {
        name: "instalación",
        href: "",
    },
    {
        name: "bases de competición",
        href: "/bases-de-competicion",
    },
    {
        name: "inscripción",
        href: "/inscripcion",
    }
]
---

<section class="max-w-xl  h-[600px] xs:h-[350px] s:h-[500px] sm:h-[500px] md:h-[650px]  m-auto my-10 grid grid-cols-2 grid-rows-2 place-items-center justify-center gap-6 xs:gap-2  s:gap-2  sm:gap-3  md:gap-4  overflow-hidden">

    {ENLAZES_IMPORTANTE.map(({ name, href }) => (

        <a href={href} class={`w-[300px] h-[300px] grid grid-rows-[1fr_40px] grid-cols-1fr place-items-center justify-center rounded-xl bg-amarillo p-4 m-0 group cursor-pointer  transform transition-transform duration-300 ease-in-out scale-100 xs:scale-50 sm:scale-75 md:scale-90   ${href && href.trim() !== "" ? 'hover:scale-105 xs:hover:scale-[.6] sm:hover:scale-[.8] md:hover:scale-95' : 'hover:cursor-not-allowed'} `}>
           
            <img src={`img/icons/${name}.png`} alt={`icono de ${name}`} class="w-[120px] h-auto m-0" /> 
           
            <div class="flex-col justify-center items-center text-center m-0 "> 
               
                <p class="text-azul uppercase font-bold text-xl">{name}</p>

                {href && href.trim() !== "" ? (
                    ' '
                ) : (
                    <p class="text-azul text-lg font-medium">Próximamente</p>
                )}
           
            </div>
        </a>

))}
</section>
<!-- 
transform transition-transform duration-300 ease-in-out scale-100 xs:scale-50 sm:scale-75 md:scale-90 
 xs:grid-cols-1 xs:grid-rows-4 xs:gap-2 s:grid-cols-1 s:grid-rows-4 s:gap-2 sm:grid-cols-2 sm:grid-rows-2 sm:gap-3 md:grid-cols-2  md:grid-rows-2 md:gap-4
-->