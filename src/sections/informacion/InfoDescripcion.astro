---
import DescripcionSection from "@components/DescripcionSection.astro";
const FINCONTADOR = 1734681600000
---

<section class="max-w-5xl h-auto m-auto my-10">
    <h2 class="text-accent text-center font-bold text-6xl">INFORMACIÓ</h2>
    <div class="w-full grid grid-cols-[2fr_1fr] grid-rows-1 md:grid-rows-1 xs:grid-rows-2 xs:grid-cols-1 sm:grid-rows-2 sm:grid-cols-1 md:grid-cols-[2fr_1fr] place-items-center">
        <p class="text-blanco text-xl my-4">
            L'IES Calvià Voley Tournament és un torneig de voleibol organitzat per i per a estudiants de l'Institut IES Calvià. Equips formats per alumnes de diferents cursos s'enfronten en un ambient esportiu i competitiu, fomentant la companyonia i l'esperit d'equip. Aquest esdeveniment és una oportunitat perquè els alumnes del centre mostrin les seves habilitats en la pista, gaudeixin de l'esport i comparteixin una experiència inoblidable amb els seus companys. Un dia ple d'emoció i voleibol en el cor de l'institut!
        </p>
        <div class="relative flex items-center justify-center  transform transition-transform duration-300 ease-in-out scale-100 xs:scale-[.7] sm:scale-[.8] md:scale-90 ">
            <svg class=" max-w-xl w-full h-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 581 573">
                <path fill="#1666FF" d="M211 3c-39 11-76 33-105 61-44 43-71 103-81 176l-1 13-4-8c-4-9-9-26-11-37-1-6-1-5-1 7 2 34 11 59 30 78 10 9 14 12 25 18 19 9 36 14 64 16a411 411 0 0 0 155-24c2-1 5 1 12 6a584 584 0 0 1 78 78l-39 21c-86 40-163 52-223 35-15-4-40-17-53-26-20-15-38-37-52-63-7-12-7-10 0 6 10 24 28 50 46 66 69 60 176 58 311-6l23-11c2 0 4 2 8 11 12 23 16 39 15 60 0 23 1 21-20 32a363 363 0 0 1-187 40c-39-5-73-18-101-39l-7-5 7 6c15 15 45 32 70 40 27 8 48 11 82 10 27-1 42-3 68-9a476 476 0 0 0 75-26 145 145 0 0 1-31 36c-11 8-12 9-5 5 32-18 53-42 61-69 4-13 5-35 1-51-8-39-32-81-76-129a436 436 0 0 0-32-32l-8-8 2-15c5-32 13-68 22-91l3-9 7 5a616 616 0 0 1 119 104c26 34 43 67 51 101 3 16 3 51 0 66a204 204 0 0 1-23 61c1 0 13-20 18-31 31-64 23-134-21-201a583 583 0 0 0-137-131l6-11c8-12 26-30 36-37 8-5 25-13 29-13a396 396 0 0 1 108 92 235 235 0 0 1 50 176l5-25a241 241 0 0 0-23-125c-22-44-54-80-107-119-2-2-2-2 4-2 9 1 24 5 34 9 12 4 9 2-6-5-74-33-134 0-175 97-10 24-25 72-27 92l-1 6-10 3c-39 14-91 27-108 27h-5v-10c0-28 6-72 14-106 15-58 38-102 71-133 29-28 62-43 105-46l15-2h-26c-27 3-49 9-72 21-65 33-106 103-123 206-3 18-7 50-7 64l-1 7h-12c-27-1-53-10-73-26-7-5-7-6-7-12 0-17 7-57 14-82C80 96 136 33 215 4c14-5 12-5-4-1Z"/>
            </svg>
    
            <!--Contador -->
    
             <div data-date={FINCONTADOR} class="centrar bg-gris w-full h-auto py-5 grid grid-cols-4 grid-rows-1 gap-16 place-content-center text-lg font-semibold text-amarillo ">
                <!-- <h4 class="text-3xl">INSCRIPCIONS TANCADES</h4> -->
                <div class="flex flex-col content-center justify-center place-items-center  w-10">
                    <span data-dias class="text-4xl">00</span>
                    <span>Dies</span>
                </div>
                
                <div  class="flex flex-col content-center justify-center place-items-center  w-10">
                    <span data-horas class="text-4xl">00</span>
                    <span>Hores</span>
                </div>
    
                <div  class="flex flex-col content-center justify-center place-items-center  w-10">
                    <span data-minutos class="text-4xl">00</span>
                    <span>Minuts</span>
                </div>
    
                <div  class="flex flex-col content-center justify-center place-items-center  w-10">
                    <span data-segundos class="text-4xl">00</span>
                    <span>Segons</span>
                </div>
            </div>
        </div> 
    </div>
</section>
<style>

    .centrar {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .opacidad {
        background-color: rgba(27, 29, 32, 0.918);
        
    }

    .texto-rotado {
        transform: rotate(-25deg);
        transform-origin: center;
    }
</style>
<script>
    const SEGUNDO = 1000
    const MINUT0 = SEGUNDO * 60
    const HORA = MINUT0 * 60
    const DIA = HORA * 24

    function init() {
        const $countdown = document.querySelector('[data-date]')
        if (!$countdown) return

        const $dias = $countdown.querySelector('[data-dias]')
        const $horas = $countdown.querySelector('[data-horas]')
        const $minutos = $countdown.querySelector('[data-minutos]')
        const $segundos = $countdown.querySelector('[data-segundos]')

        const timestamp = $countdown.getAttribute('data-date')
        if (!timestamp) return

        const fecha = new Date(+timestamp).getTime()

        function actualizarCountdown() {
            const ahora = Date.now()

            const diff = fecha - ahora

            if ($dias instanceof HTMLElement){
                $dias.innerText = Math.floor(diff / DIA).toString()
            }
            if ($horas instanceof HTMLElement){
                $horas.innerText =Math.floor((diff % DIA) / HORA).toString()
            }
            if ($minutos instanceof HTMLElement){
                $minutos.innerText = Math.floor((diff % HORA) / MINUT0).toString()
            }
            if ($segundos instanceof HTMLElement){
                $segundos.innerText = Math.floor((diff % MINUT0) / SEGUNDO).toString()
            }
        }

        setInterval( actualizarCountdown , SEGUNDO)
    }
    init()
</script>