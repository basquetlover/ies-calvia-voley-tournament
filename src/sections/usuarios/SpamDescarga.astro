<div id="fondo" class="w-full h-screen desactivado fixed top-0 left-0 bg-gris-claro bg-opacity-55 z-50">
    <div class="centrar bg-gris max-w-lg w-auto h-96 xs:h-72 sm:h-72 md:h-96 p-4 px-5 rounded-lg grid grid-cols-1 grid-rows-[max-content_1fr_max-content] place-items-center">
        <h2 class="text-center text-3xl xs:text-lg sm:text-lg md:text-3xl text-amarillo">Vols descarregar alguna imatge?</h2>
        <img src="/img/descargar-img.png" alt="Descarregar Imatge" class="rounded-lg" />
        <a href="https://mail.google.com/mail/?view=cm&fs=1&to=p_alemanyt@a.iescalvia.com&su=Descarregar%20Imatges%20|%20IES%20Calvià%20Voley%20Tournament" target="_blank" class=" bg-amarillo text-azul text-center font-bold w-auto h-auto mx-auto px-3 py-2 rounded-full  text-xl xs:text-xs sm:text-xs md:text-lg hover:scale-105 transition-all duration-300">
            Posa't en contacte amb el Staff
        </a>
        <div id="btn_cerrar" class="close w-14 h-14 xs:w-10 xs:h-10 sm:w-10 sm:h-10 md:w-14 md:h-14 bg-cancelar flex items-center absolute cursor-pointer -top-7 -right-7 place-content-center text-5xl xs:text-2xl sm:text-2xl md:text-4xl rounded-full ">
            X
        </div>
    </div>
    
</div>
<script>
    
    const btn_cerrar = document.getElementById("btn_cerrar");
    const fondo = document.getElementById("fondo");

    btn_cerrar?.addEventListener('click', function(){
        fondo?.classList.remove("activado");
        fondo?.classList.add("desactivado");
    })
    function temporizador() {
            fondo?.classList.remove('desactivado');
            fondo?.classList.add('activado');
        }

        // Temporizador de 3 minutos (180000 milisegundos)
        setTimeout(temporizador, 60000);
    
</script>
<style>
    .placeholder{
  opacity: 0;
  
  position: absolute;
  top: 0;
  left: 0;
}
.activado{
    display: block;
}
.desactivado{
    display: none;
}

    .centrar{
        position: absolute;
