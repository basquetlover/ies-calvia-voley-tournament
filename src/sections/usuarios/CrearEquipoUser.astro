<!-- Seleccionar Capitan -->
<script>
window.addEventListener('load', function(){
    console.log("Script cargado")
    const input_capitan = document.getElementById(`input_capitan`) as HTMLInputElement;
    const input_capitan_form = document.getElementById(`input_capitan_form`) as HTMLInputElement;
    let currentCapitanIndex: number | null = null; // Declarar el tipo explícitamente

    // Función para agregar el evento de clic a los capitanes
    function agregarEventoCapitan(index: number, capitanId: string, nombreId: string, apellidoId: string) {
        const capitan = document.getElementById(capitanId)!;
        const nombre = document.getElementById(nombreId) as HTMLInputElement;
        const _1r_apellido = document.getElementById(apellidoId) as HTMLInputElement;

        if (nombre || _1r_apellido) {
            // Usar una función de cierre para capturar el valor de index
            (function(index) {
                capitan.addEventListener('click', function() {
                    // Si ya hay un capitán seleccionado, desactivar su botón
                    if (currentCapitanIndex !== null) {
                        const previousCapitan = document.getElementById(`capitan_${currentCapitanIndex}`) || document.getElementById(`extra_capitan_${currentCapitanIndex}`);
                        if (previousCapitan) {
                            console.log("Desactivando capitán anterior:", currentCapitanIndex);
                            previousCapitan.classList.remove('active-c'); // Cambia esto según tu lógica de estilos
                        }
                    }

                    // Actualizar el índice del capitán actual
                    currentCapitanIndex = index;

                    // Cambiar el valor del input del capitán
                    const valor_apellido = _1r_apellido.value;
                    input_capitan.value = nombre.value + " " + valor_apellido; // Obtiene el valor del input del nuevo capitán
                    input_capitan_form.value = nombre.value + " " + valor_apellido;
                    
                    console.log("Capitán seleccionado:", nombre.value, valor_apellido, currentCapitanIndex);

                    // Activar el botón del nuevo capitán (opcional, si necesitas algún estilo)
                    capitan.classList.add('active-c'); // Cambia esto según tu lógica de estilos
                });
            })(index); // Llamar a la función con el valor actual de index
        }
    }

    // Manejar jugadores normales
    let index = 0;
    while (document.getElementById(`capitan_${index}`)) {
        agregarEventoCapitan(index, `capitan_${index}`, `player_${index}_name`, `player_${index}_1r_apellido`);
        index++;
    }

    // Manejar jugadores extra
    index = 0;
    while (document.getElementById(`extra_capitan_${index}`)) {
        agregarEventoCapitan(index, `extra_capitan_${index}`, `extra_player_${index}_name`, `extra_player_${index}_1r_apellido`);
        index++;
    }
})
</script>



