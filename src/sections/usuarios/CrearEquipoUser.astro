                ${mensaje}
            </div>`;
    }

    async function procesarRespuesta(response: Response, paso: string) {
        const contentType = response.headers.get("Content-Type");

        if (contentType?.includes("text/html")) {
            const html = await response.text();
            document.getElementById('errorbox')!.innerHTML = html;
            document.getElementById('errorbox')?.scrollIntoView({ behavior: 'smooth' });
            const elementos = document.querySelectorAll<HTMLElement>('[id^="espera"]');

            elementos.forEach(el => {
              if (el.classList.contains("fijo")) {
                el.classList.remove("fijo");
                el.classList.add("oculto");
              }
            });

            return false;
        } 
        else if (contentType?.includes("application/json")) {
            const jsonResponse = await response.json();
            if (!jsonResponse.success) {
                mostrarError(`Error en ${paso}`);
                return false;
            }
        } 
        else {
            mostrarError(`Respuesta inesperada en ${paso}`);
            return false;
        }
        return true;
    }
});
</script>

