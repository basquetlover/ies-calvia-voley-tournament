import {CURSO_2E, CURSO_3E, CURSO_4E, CURSO_1B, CURSO_2B, CURSO_FP, CURSO_P } from "@const/registrarse";
import { supabaseAdmin } from "src/lib/supabase";
let jugadores: { nombre: string | number | string[] | null | undefined; curso: string | number | string[] | null | undefined; }[] = [];
let jugadores_extra: { nombre: string | number | string[] | null | undefined; curso: string | number | string[] | null | undefined; }[] = [];
let staff: { nombre: string | number | string[] | null | undefined; curso: string | number | string[] | null | undefined; }[] = [];
let foto = false;
const { data: ConfTorneo, error } = await supabaseAdmin
  .from('Configuracion')
  .select('min_jugadores, max_jugadores, max_staff, entrenador, profesor, foto')
  .eq('estado', 'Actual')
  .single();

if (ConfTorneo) {
  const min_jugadores = ConfTorneo.min_jugadores;
  const max_jugadores = ConfTorneo.max_jugadores;
  const max_staff = ConfTorneo.max_staff;
  if(ConfTorneo.foto === "Permitido"){
    foto = true
  } 
  jugadores = Array.from({ length: min_jugadores }, () => ({ nombre: "", curso: "" }));
  jugadores_extra = Array.from({ length: max_jugadores - min_jugadores }, () => ({ nombre: "", curso: "" }));
  staff = Array.from({ length: max_staff }, () => ({ nombre: "", curso: "" }));
}

// Exportar solo después de asegurar que están definidos
export { jugadores, jugadores_extra, staff };
import { verificarSesion } from "src/lib/session";
import PoliticaInscripcion from "@components/PoliticaInscripcion.astro";
import FormSend from "@components/FormSend.astro";


const usuario = await verificarSesion(Astro.request);
interface Jugador {
  nombre: string;
  curso: string;
}

