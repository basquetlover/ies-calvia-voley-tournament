<script>
window.addEventListener('load', function(){
    console.log("Script Selec Genero cargado")
    const hombre = document.getElementById(`hombre_voluntario`)!;
    const mujer = document.getElementById(`mujer_voluntario`)!;
    
    const genero = document.getElementById(`genero_voluntario`)! as HTMLInputElement;
    hombre.addEventListener('click',  function(){
        
            genero.value = "hombre";
            hombre.classList.add("hombre");
            hombre.classList.remove("desactivado");
            mujer.classList.remove("mujer");
            mujer.classList.add("desactivado");
    });
    mujer.addEventListener('click',  function(){
        
        genero.value = "mujer";
        mujer.classList.add("mujer");
        mujer.classList.remove("desactivado");
        hombre.classList.remove("hombre");
        hombre.classList.add("desactivado");
});
})
</script>

