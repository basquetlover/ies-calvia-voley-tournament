try {
  const { data, error } = await supabaseAdmin
    .from(TablaPartidos)
    .select("pista, equipo_local, equipo_visitante, LocGlobal, VisGlobal, estado, id_partido")
    .eq("bracket", "perdedores"); // o el bracket que quieras

  if (!error && data) {
    for (const fila of data) {
      let pista   = fila.pista ?? "Sin Pista";
      let equipo1 = fila.equipo_local ?? "";
      let escudo1 = "";
      let equipo2 = fila.equipo_visitante ?? "";
      let escudo2 = "";
      let resA    = fila.LocGlobal ?? "-";
      let resB    = fila.VisGlobal ?? "-";
      let estado  = fila.estado ?? "Por Jugar";
      let numero  = traducirPartido(fila.id_partido);

      // Escudo equipo 1
      if (equipo1) {
        const { data: e1, error: err1 } = await supabaseAdmin
          .from(TablaEquipos)
          .select("escudo")
          .eq("nombre_equipo", equipo1)
          .single();
        if (!err1 && e1) escudo1 = e1.escudo;
      }

      // Escudo equipo 2
      if (equipo2) {
        const { data: e2, error: err2 } = await supabaseAdmin
          .from(TablaEquipos)
          .select("escudo")
          .eq("nombre_equipo", equipo2)
          .single();
        if (!err2 && e2) escudo2 = e2.escudo;
      }

      partidos_perdedores.push({
        pista,
        equipo1,
        escudo1,
        equipo2,
        escudo2,
        resultadoA: resA,
        resultadoB: resB,
        estado,
        numero
      });
    }
  }
} catch (err) {
  console.error("Error al obtener partidos perdedores:", err);
}

}
