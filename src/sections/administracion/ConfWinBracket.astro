import EquipoBox from "@components/admin/EquipoBoxIzq.astro";
import { supabaseAdmin } from '../../lib/supabase';

const PISTAS = [
    {
        pista: "Pista 1",
    },
    {
        pista: "Pista 2",
    },
]

let equipos: {  nombre_equipo: string; escudo: string }[] = []; // Especifica el tipo

// Obtener los equipos de la base de datos
const { data, error } = await supabaseAdmin
  .from('Equipos')
  .select(' nombre_equipo, capitan, entrenador, escudo')
  .order('id', { ascending: true });

if (error) {
  console.error('Error al obtener los equipos:', error);
} else if (!data || data.length === 0) {
  console.log('No se encontraron equipos');
} else {
  equipos = data; // Asignar los datos a la variable global
  console.log(`Se encontraron ${equipos.length} equipos`);
}
