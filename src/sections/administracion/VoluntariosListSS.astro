---

import { supabaseAdmin } from '../../lib/supabase';
interface Equipo {
  id_equipo: string;
  nombre_equipo: string;
  capitan: string;
  entrenador: string;
  escudo: string | null; // o string dependiendo de si puede ser nulo
  inscrito: number;
  estado: string | null;
  aceptado: string | null;
}
// Obtener los equipos de la base de datos
const { data: voluntarios, error } = await supabaseAdmin
  .from('Voluntarios')
  .select('nombre, _1r_apellido, _2n_apellido, curso, tipo, email, estado, fecha_inscripcion, img, descripcion, id, observacion, validar_img ')
  .order('id', { ascending: true });


if (error) {
  console.error('Error al obtener los voluntarios:', error);
} else if (!voluntarios || voluntarios.length === 0) {
  console.log('No se encontraron voluntarios');
} else {
  console.log(`Se encontraron ${voluntarios.length} voluntarios`);
}

---
{!voluntarios || voluntarios.length === 0  && (
  <>
  <div class="w-full h-auto mt-10 flex items-center place-content-center">
  <section class="max-w-2xl w-full h-max p-0 mx-auto my-auto">
      <h2 class=" w-full text-center text-amarillo uppercase font-bold text-4xl">No se encontraron voluntarios</h2>
      
      <p class="text-blanco text-xl text-center my-2">
      Aun no hay voluntarios introducidos en la base de datos.
      </p>
      
          
  
      </section>
