                  </svg>
                  )}
            </div>
            <div>
                <p class="text-blanco text-lg font-semibold" translate="no">{voluntario.nombre} {voluntario._1r_apellido} {voluntario._2n_apellido}</p>
                <p class="text-blanco text-base"><span class="font-semibold">Email:</span> {voluntario.email}</p>
