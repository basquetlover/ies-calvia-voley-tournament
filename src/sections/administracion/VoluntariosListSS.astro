        <div id={`evaluar_${index}`} class="w-full ocultar h-auto  rounded-md mt-5 p-2 bg-gris">
            <input type="hidden" name={`voluntario_id_${index}`} value={voluntario.id}/>
            <input type="hidden" name={`voluntario_email_${index}`} value={voluntario.email}/>
            <input type="hidden" name={`voluntario_nuevo_estado_${index}`} id={`voluntario_nuevo_estado_${index}`} />
            <input type="hidden" name={`img-voluntario_${index}`} class="w-14" id={`img-voluntario_${index}`} value={voluntario.validar_img} value={`${voluntario.img ? (""): ("foto-denegada")}`}/>
