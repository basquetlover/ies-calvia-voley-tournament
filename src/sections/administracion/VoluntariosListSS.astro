                </div>
                {voluntario.observacion !== "" || voluntario.observacion === null  ? (<>
          <textarea disabled class="w-full bg-orange-500 rounded-md px-3 py-2 text-gris">{voluntario.observacion}</textarea>
          </>):(<></>)}
                <div id={`probl-voluntario_${index}`} class="max-w-full w-full">
                    <h3 class="text-2xl text-naranja font-semibold">¿Problemas en el Voluntario?</h3>
                    <textarea name={`probl_voluntario_${index}`} class="w-full bg-gris-claro rounded-md px-3 py-2 text-blanco" placeholder="Añadir información al jugador"></textarea>
                </div>
                
                <div id={`boton_enviar_${index}`}  class="mx-auto ocultar">
                    <button class="px-3 my-auto py-2 flex flex-row items-center place-content-center font-semibold w-max h-auto fill-blanco text-blanco bg-aceptar cursor-pointer rounded-full text-lg hover:scale-110  duration-300 transition-all transform">
                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" >
                        <path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z"/>
                    </svg>
                    Evaluar Voluntario
                    </button>
                </div>
            </div>

            {voluntario.estado !== "Revisant"?(<>
    <div id={`advertencia_${index}`} class="w-full h-full bg-gris-claro absolute top-0 left-0 rounded-md">
      <h2 class="text-4xl text-amarillo font-bold text-center mt-4">⚠️ ADVERTENCIA ⚠️</h2>
      <p class="w-[80%] mx-auto mt-10 text-lg text-blanco text-center">El voluntario <span class="text-accent">{voluntario.email}</span> no ha realizado ningun cambio desde la ultima revision.</p>
      <p class="w-[80%] mx-auto mt-10 text-xl text-blanco text-center">¿Estas seguro que quieres continuar con una nueva revision?</p>
      <div class="w-[50%] mx-auto flex flex-wrap px-4 text-xl items-center place-content-around mt-4">
        <span id={`advertencia-si_${index}`} class="w-14 h-14 px-2 py-1 rounded-xl bg-verde-claro text-verde text-xl flex items-center place-content-center uppercase font-semibold cursor-pointer">Si</span>
        <span id={`advertencia-no_${index}`} class="w-14 h-14 px-2 py-1 rounded-xl bg-rojo-claro text-rojo text-xl flex items-center place-content-center uppercase font-semibold cursor-pointer">No</span>
    </div>
    </div>
    </>):(
      <>
      
      </>)}
        </div>
      </div>
    ))}


</form>
  </div>
<!-- Errores -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        console.log('Script Errores cargado');
    document.getElementById('equipo-form')?.addEventListener('submit', async (event) => {
        event.preventDefault(); // Evita el envío del formulario por defecto
  
        const form = event.target as HTMLFormElement; // Asegúrate de que sea un HTMLFormElement
        const formData = new FormData(form); // Ahora TypeScript sabe que 'form' es un HTMLFormElement
  
  
        // const espera = document.getElementById('espera');
        // espera?.classList.add("centrar");
        // espera?.classList.remove("oculto");
  
        const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
        });
  
        const contentType = response.headers.get("Content-Type");
        if (contentType && contentType.includes("text/html")) {
            const html = await response.text();
            document.getElementById('errorbox')!.innerHTML = html; // Usa el operador de aserción no nula
            // Desplazarse hacia el div de error
          //   espera?.classList.remove("centrar");
          // espera?.classList.add("oculto");
            document.getElementById('errorbox')?.scrollIntoView({ behavior: 'smooth' });
        } else if (contentType && contentType.includes("application/json")) {
            const jsonResponse = await response.json();
            if (jsonResponse.success) {
                // Redirigir a la página principal
                window.location.href = '/admin/voluntarios'; // Redirige al usuario
            } else {
                // Manejo de errores si es necesario
                document.getElementById('errorbox')!.innerHTML = `<div class="bg-red-600 bg-opacity-30 border-3 border-red-700 text-white rounded-lg p-2 my-2 flex items-center">Error al iniciar sesión</div>`;
            }
        }
    });
  });
  </script>

<script>
    let index = 0;
  while (document.querySelectorAll("[id^='btn_evaluar_']")) {
    const btn_evaluar = document.getElementById(`btn_evaluar_${index}`)!;
    const evaluar = document.getElementById(`evaluar_${index}`)!;
    const si = document.getElementById(`img-voluntario-si-${index}`)!;
    const no = document.getElementById(`img-voluntario-no-${index}`)!;
    const aceptar = document.getElementById(`aceptar_${index}`)!;
    const denegar = document.getElementById(`denegar_${index}`)!;
    const estado = document.getElementById(`voluntario_nuevo_estado_${index}`)! as HTMLInputElement;
    const boton_enviar = document.getElementById(`boton_enviar_${index}`)!;
    const advertencia_no = document.getElementById(`advertencia-no_${index}`);
    const advertencia_si = document.getElementById(`advertencia-si_${index}`);
    const advertencia = document.getElementById(`advertencia_${index}`);

    const foto = document.getElementById(`img-voluntario_${index}`)! as HTMLInputElement;

    btn_evaluar?.addEventListener('click', function(){
        // if(boton_enviar.classList.contains('ocultar')){
        //     evaluar?.classList.remove("ocultar");
        // }
        // if(boton_enviar.classList.toggle('ocultar')){
        //     evaluar?.classList.remove("ocultar");
        // }
        evaluar?.classList.toggle("ocultar");
    })

    

    advertencia_no?.addEventListener('click', function(){
    evaluar?.classList.add("ocultar");
  })
  advertencia_si?.addEventListener('click', function(){
    advertencia?.classList.add("ocultar");
  })
    aceptar.addEventListener('click', function(){
        estado.value = "Acceptat";
        denegar.classList.add('desactivado');
        aceptar.classList.remove('desactivado');
        if(boton_enviar.classList.contains('ocultar')){
            boton_enviar.classList.remove('ocultar');
        }

    })

    denegar.addEventListener('click', function(){
        estado.value = "Denegat";
        aceptar.classList.add('desactivado');
        denegar.classList.remove('desactivado');
        if(boton_enviar.classList.contains('ocultar')){
            boton_enviar.classList.remove('ocultar');
        }
    })

    si.addEventListener('click',  function(){
        
            foto.value = "foto-aceptada";
            si.classList.add("si_foto");
            si.classList.remove("desactivado");
            no.classList.remove("no_foto");
            no.classList.add("desactivado");
    });
    no.addEventListener('click',  function(){
        
        foto.value = "foto-denegada";
        no.classList.add("no_foto");
        no.classList.remove("desactivado");
        si.classList.remove("si_foto");
        si.classList.add("desactivado");
});
    index++;
}
</script>

<style>
      .ocultar{
    display: none;
  }

  .equipo-denegado{
    display: block;
  }
    .si_foto {
    background: rgba(20, 156, 2, 0.75);
    /* background: rgb(255, 199, 0.75); */
     /* Color para hombre */
}

.no_foto {
    background-color: rgba(150, 1, 1, 0.75);
    /* background: rgb(255, 199, 0.75); */
    
}

.desactivado{
    background-color: rgba(39, 39, 39, 0.75);
}
</style>