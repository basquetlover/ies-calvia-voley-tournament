<div class="max-w-2xl  w-auto mx-auto h-auto content-center">
    <div class="flex flex-col relative w-full mx-auto ">
        <h3 class="text-amarillo text-center text-3xl my-5">Añadir acceso</h3>
        <form id="add-acceso-form" class="w-full rounded-lg p-4 text-blanco text-lg bg-gris-claro" method="POST" action="/api/anadir-acceso">
             
                    <div class="flex flex-row w-full place-content-between my-2">
                        <input type="text" name="pagina_nueva" class="bg-transparent text-blanco" placeholder="URL pagina    ej:/pagina"/>
                                                 
                        
                        <label class="switch">
                            <input 
                                type="checkbox" 
                                name={`acceso_nuevo`} 
                                value="true" 
                            />
                            <span class="slider round"></span>
                        </label>
                    </div>
                    <hr class="border-accent"/>
                    <div id="errorbox" class="text-red-500"></div>
                    
            
            <div class="w-full h-auto flex my-5 flex-row items-center place-content-around">
                <button class="px-3 py-2 flex flex-row items-center place-content-center font-semibold w-32 h-12 fill-blanco text-blanco bg-aceptar rounded-full text-xl hover:scale-110 duration-300 transition-all transform">
                    <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960">
                        <path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z"/>
                    </svg>
                    Añadir
                </button>
            </div>
       </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        console.log('Script cargado');
    document.getElementById('add-acceso-form')?.addEventListener('submit', async (event) => {
        event.preventDefault(); // Evita el envío del formulario por defecto

        const form = event.target as HTMLFormElement; // Asegúrate de que sea un HTMLFormElement
        const formData = new FormData(form); // Ahora TypeScript sabe que 'form' es un HTMLFormElement

        const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
        });

        const contentType = response.headers.get("Content-Type");
        if (contentType && contentType.includes("text/html")) {
            const html = await response.text();
            document.getElementById('errorbox')!.innerHTML = html; // Usa el operador de aserción no nula
        } else if (contentType && contentType.includes("application/json")) {
            const jsonResponse = await response.json();
            if (jsonResponse.success) {
                // Redirigir a la página principal
                window.location.href = '/admin/acceso-usuarios'; // Redirige al usuario
            } else {
                // Manejo de errores si es necesario
                document.getElementById('errorbox')!.innerHTML = `<div class="bg-red-600 bg-opacity-30 border-3 border-red-700 text-white rounded-lg p-2 my-2 flex items-center">Error al iniciar sesión</div>`;
            }
        }
    });
});
</script>

<style>
    .centrar {
        z-index: 0;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .formulario {
        z-index: 10000;
    }
    .form {
        position: absolute;
        top: -20px;
        left: 20px;
    }
    
    .switch {
        position: relative;
        display: inline-block;
        width: 50px;
        height: 25px;
    }

    /* Hide default HTML checkbox */
    .switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    /* The slider */
    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #0E347D;
        -webkit-transition: .4s;
        transition: .4s;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 18px;
        width: 18px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        -webkit-transition: .4s;
        transition: .4s;
    }

    input:checked + .slider {
        background-color: #34A853;
    }

    input:checked + .slider:before {
        -webkit-transform: translateX(22px);
        -ms-transform: translateX(22px);
        transform: translateX(22px);
    }

    /* Rounded sliders */
    .slider.round {
        border-radius: 34px;
    }

    .slider.round:before {
        border-radius: 50%;
    }
</style>