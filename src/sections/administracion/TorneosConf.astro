                      <span class="peer-checked:text-accent">CURSO_1B</span>
                    </label>

                    <label class="flex items-center gap-2">
                      <input type="checkbox" name={`cursos_${index}[]`} value="CURSO_2B"  class="peer hidden" />
                      <span class="peer-checked:text-accent">CURSO_2B</span>
