<script>
  const habilitarEdicion = (index: number) => {
    const fields = [
      `nombre_${index}`,
      `fecha_${index}`,
      `estado_${index}`,
      `in_inicio_${index}`,
      `in_fin_${index}`,
      `vo_inicio_${index}`,
      `vo_fin_${index}`,
      `min_jugadores_${index}`,
      `max_jugadores_${index}`,
      `min_staff_${index}`,
      `max_staff_${index}`,
      `entrenador_${index}`,
      `profesor_${index}`,
      `foto_${index}`,
      `cursos_${index}`
    ];
    fields.forEach(fieldId => {
      const field = document.getElementById(fieldId) as HTMLInputElement;
      if (field) field.disabled = false;
    });

    document.getElementById(`habilitar_${index}`)?.classList.add("oculto");
    document.getElementById(`habilitado_${index}`)?.classList.remove("oculto");
  };

  const deshabilitarEdicion = (index: number) => {
    const fields = [
      `nombre_${index}`,
      `fecha_${index}`,
      `estado_${index}`,
      `in_inicio_${index}`,
      `in_fin_${index}`,
      `vo_inicio_${index}`,
      `vo_fin_${index}`,
      `min_jugadores_${index}`,
      `max_jugadores_${index}`,
      `min_staff_${index}`,
      `max_staff_${index}`,
      `entrenador_${index}`,
      `profesor_${index}`,
      `cursos_${index}`
    ];
    fields.forEach(fieldId => {
      const field = document.getElementById(fieldId) as HTMLInputElement;
      if (field) field.disabled = true;
    });

    document.getElementById(`habilitar_${index}`)?.classList.remove("oculto");
    document.getElementById(`habilitado_${index}`)?.classList.add("oculto");
  };

  const asociarEventos = () => {
    // Botones para habilitar
    const habilitarBotones = document.querySelectorAll("[id^='habilitar_']");
    habilitarBotones.forEach(boton => {
      boton.addEventListener("click", () => {
        const index = boton.getAttribute("data-index");
        habilitarEdicion(Number(index));
      });
    });

    // Botones para deshabilitar (si existen)
    const deshabilitarBotones = document.querySelectorAll("[id^='habilitado_']");
    deshabilitarBotones.forEach(boton => {
      boton.addEventListener("click", () => {
        const index = boton.getAttribute("data-index");
        deshabilitarEdicion(Number(index));
      });
    });
  };

  document.addEventListener('DOMContentLoaded', () => {
    console.log('Script Errores cargado');

    document.getElementById('ConfTorneo')?.addEventListener('submit', async (event) => {
      event.preventDefault();

      const form = event.target as HTMLFormElement;
      const formData = new FormData(form);

      const espera = document.getElementById('espera');
      espera?.classList.add("fijo");
      espera?.classList.remove("oculto");

      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
      });

      const contentType = response.headers.get("Content-Type");
      if (contentType && contentType.includes("text/html")) {
        const html = await response.text();
        document.getElementById('errorbox')!.innerHTML = html;

        espera?.classList.remove("fijo");
        espera?.classList.add("oculto");
        document.getElementById('errorbox')?.scrollIntoView({ behavior: 'smooth' });

        // Reasociar eventos a los nuevos botones después de insertar el HTML
        asociarEventos();

        // Eliminar el div de respuesta tras 15 segundos
        setTimeout(() => {
          const respuestaDiv = document.getElementById('respuesta');
          if (respuestaDiv) {
            respuestaDiv.remove();
          }
        }, 15000);
      }
    });

    // Asociar eventos al cargar la página
    asociarEventos();
  });
</script>

