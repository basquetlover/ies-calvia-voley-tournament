                      <input type="checkbox" name={`cursos_${index}[]`} value="CURSO_FP"  class="peer hidden" />
                      <span class="peer-checked:text-accent">CURSO_FP</span>
                    </label>
                </div>
            </td>
            <td class="py-3 px-6 border-b border-gray-700">
              <div
