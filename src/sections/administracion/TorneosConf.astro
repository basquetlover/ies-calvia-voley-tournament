                      <input type="checkbox" name={`cursos_${index}[]`} value="CURSO_2E"  class="peer hidden" />
                      <span class="peer-checked:text-accent">CURSO_2E</span>
                    </label>

                    <label class="flex items-center gap-2">
                      <input type="checkbox" name={`cursos_${index}[]`} value="CURSO_3E"  class="peer hidden" />
                      <span class="peer-checked:text-accent">CURSO_3E</span>
                    </label>

                    <label class="flex items-center gap-2">
                      <input type="checkbox" name={`cursos_${index}[]`} value="CURSO_4E"  class="peer hidden" />
