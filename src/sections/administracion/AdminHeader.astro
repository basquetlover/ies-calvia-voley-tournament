---
import Equipos from "@icons/administracion/Equipos.svg"
// const user = Astro.locals.user
// console.log(user)

const ACC_GENERAL = [
    {
        nombre: "Equipos",
        href: "equipos",
        icon: "M0 30v-4c0-2 1-3 3-5l7-1a36 36 0 0 1 3 0 10 10 0 0 0-2 6v4H0Zm15 0v-4l1-4 3-3 4-2a27 27 0 0 1 12 0l5 2 2 3 2 4v4H15Zm32 0v-7l-1-3h2l7 1c2 2 3 3 3 5v4H47Zm-27-5h18c0-1-1-2-3-2l-6-1-6 1c-2 0-3 1-3 2Zm-10-8-4-1-1-3 1-4 4-1 3 1 2 4-2 3-3 1Zm38 0-3-1-1-3 1-4 3-1 4 1 1 4-1 3-4 1Zm-19-2-5-2c-2-2-2-3-2-5s0-4 2-5c1-2 3-2 5-2s4 0 5 2c2 1 2 3 2 5s0 3-2 5l-5 2Zm0-5 2-1V6l-2-1-2 1v3l2 1Z",
    },
    {
        nombre: "Añadir Equipos",
        href: "",
        icon: "M13 17H0v-4h13V0h4v13h13v4H17v13h-4V17Z",
    },
    {
        nombre: "Modificar Equipos",
        href: "",
        icon: "M3 27h3l16-17-2-2L3 24v3Zm-3 3v-7L22 1l1-1h3l1 1 2 2 1 1a4 4 0 0 1 0 3l-1 1L7 30H0ZM21 9l-1-1 2 2-1-1Z",
    }
];

const ACC_SEMIGENERAL = [
    {
        nombre: "B. Competición",
        href: "",
    },
    {
        nombre: "Normativa",
        href: "",
    }
]

const OWNER = [
    {
        nombre: "Usuarios",
        href: "lista-administradores",
        icon: "m16 16-6-2-2-6 2-6 6-2 6 2 2 6-2 6-6 2ZM0 32v-5l1-4 2-2 6-2 7-1h1a14 14 0 0 0-1 4l-6 1-5 2a2 2 0 0 0-1 2v1h13a13 13 0 0 0 2 4H0Zm28 2v-3a14 14 0 0 1-3-1l-3 1-2-3 3-3a9 9 0 0 1 0-2l-3-2 2-4 3 1a9 9 0 0 1 3-1v-3h4l1 3a10 10 0 0 1 2 1l3-1 2 4-2 2a8 8 0 0 1 0 2l2 3-2 3-3-1a9 9 0 0 1-2 1l-1 3h-4Zm2-6 3-1 1-3-1-3-3-1-3 1-1 3 1 3 3 1ZM16 12l3-1 1-3-1-3-3-1-3 1-1 3 1 3 3 1Z",
    },
]

//const user = Astro.locals.user;

import { supabaseAdmin } from "../../lib/supabase";

// Verifica si hay un usuario autenticado
const user = Astro.locals.user;

let userWithRango = {
    email: user?.email || "Desconocido",
    rango: "Sin rango"
};

try {
    // Obtén el rango del usuario autenticado
    if (user?.email) {
        const { data: adminData, error } = await supabaseAdmin
            .from("Administradores")
            .select("rango")
            .eq("user_email", user.email)
            .single(); // Obtiene un único registro

        if (error) {
            console.error("Error al obtener rango:", error.message);
        } else if (adminData) {
            userWithRango.rango = adminData.rango || "Sin rango";
        }
    }
} catch (err) {
    console.error("Error al obtener datos del usuario:", err);
}

---
<header class="bg-gris-claro w-80 h-screen flex overflow-x-hidden no-scrollbar flex-col items-center">
    <a href="/admin" class="w-32 h-32">
        <img class="w-32 h-32" src="/img/logo_torneo.png" />
    </a>
    <h1 class="text-center text-accent text-3xl font-semibold uppercase">panel administración</h1>
    <div>
        <div class="mt-5 flex flex-row items-center">
            <span class="w-5 h-5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 40 40">
                    <path fill="#E8EAED" d="M20 20c-3 0-5-1-7-3s-3-4-3-7 1-5 3-7 4-3 7-3 5 1 7 3 3 4 3 7-1 5-3 7-4 3-7 3ZM0 40v-7l1-4 3-3a37 37 0 0 1 16-3 34 34 0 0 1 16 3l3 3 1 4v7H0Z"/>
                  </svg>
            </span>
            <p class="text-blanco ml-1">{userWithRango.email}</p>
        </div>
        <div class="mt-5 flex flex-row items-center">
            <span class="w-5 h-5">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="w-5 h-5" viewBox="0 0 40 44">
                    <path fill="#F7F7F7" d="M13 0C9 2 6 5 6 9c0 3 1 5 3 7a10 10 0 0 0 6 3h-1C8 20 4 24 1 29l-1 5 1 2h20l1-2 1-4 4-4 1-2-1-1-8-4h-1l4-2 3-3c2-4 1-8-2-11l-5-3h-5ZM30 27c-3 1-5 3-6 6l1 6 4 4a8 8 0 1 0 1-16Zm5 4c1 1 2 3 1 4l-2 1-3 2-1 2h-2v-3h1v-1h1v-1l1-1v-1l1-3 3 1Z"/>
                    <path fill="#F7F7F7" d="M33 32c0 1 1 2 2 1v-1h-2Z"/>
                  </svg>
            </span>
            <p class="text-blanco ml-1">{userWithRango.rango}</p>
        </div>
    </div>
    <nav class="w-full h-auto mt-5 flex flex-col items-center">
        {
            ACC_GENERAL.map(({nombre, href, icon}) => (
                <a href={`/admin/${href}`} class="w-[95%] h-14 py-2 px-3 my-2 grid grid-rows-1 grid-cols-[max-content_1fr] gap-2 items-center rounded-full bg-azul text-2xl text-amarillo ">
                     <svg xmlns="http://www.w3.org/2000/svg" class="fill-amarillo w-8 h-8" viewBox="0 0 58 30">
                        <path fill="#FFC700" d={icon}/>
                    </svg>
                    {nombre}
                </a>
            ))
        }
    </nav>

    <div class="w-[95%] h-[2px] my-10 border-none block rounded-full bg-accent select-none" > &nbsp;</div>

    <nav class="w-full h-auto flex flex-col items-center">
        {
            ACC_SEMIGENERAL.map(({nombre, href}) => (
                <a class="w-[95%] h-14 py-2 px-3 my-2 grid grid-rows-1 grid-cols-[max-content_1fr] gap-2 items-center rounded-full bg-azul text-2xl text-amarillo ">
                    {nombre}
                </a>
            ))
        }
    </nav>
    {userWithRango.rango === "Owner" && (
         <>
            <div class="w-[95%] h-[2px] my-10 border-none block rounded-full bg-accent select-none" > &nbsp; </div>

            <nav class="w-full h-auto flex flex-col items-center">
                {
                    OWNER.map(({nombre, href, icon}) => (
                        <a href={`/admin/${href}`} class="w-[95%] h-14 py-2 px-3 my-2 grid grid-rows-1 grid-cols-[max-content_1fr] gap-2 items-center rounded-full bg-azul text-2xl text-amarillo ">
                            <svg xmlns="http://www.w3.org/2000/svg" class="fill-amarillo w-6 h-6" viewBox="0 0 40 35">
                                <path fill="#FFC700" d={icon}/>
                            </svg>
                            {nombre}
                        </a>
                    ))
                }
            </nav>
         </>
    )}

    <!-- {user && ( -->
    <form action="/api/auth/signout">
        <button class="text-center text-lg text-blanco hover:text-amarillo duration-300 transition-all group my-10 flex flex-row items-center place-content-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 30 31">
                <path class="fill-blanco group-hover:fill-amarillo duration-300 transition-all"  d="m27 1 2 1 1 2v24l-1 2-2 1H15v-3h12V4H15V1h12ZM8 8l3 2-5 4h14v4H6l5 4-3 2-8-8 8-8Z"/>
            </svg>
            Cerrar Sesión
        </button>
    </form>
    <!-- )} -->

    
</header>
