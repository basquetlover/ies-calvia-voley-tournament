            {OwnerData ? (
                   OwnerData.map((user) => (
                <tr >
                    <td class="xs:max-w-[150px] sm:max-w-[150px] md:w-auto w-auto no-scrollbar overflow-x-auto" translate="no">
                        <a href={`/usuario/staff/${user.user_email}`} target="_blank">{user.user_email}</a>
                    </td>
                    
                    <td class="text-center">
                        {user.rango}
                    </td>

