---
import { supabaseAdmin } from "../../lib/supabase";

// Define una estructura para los usuarios con rango
interface UserWithRango {
    email: string;
    rango: string;
}

let error = null;
let usersWithRangos: UserWithRango[] = [];

try {
    // Paso 1: Obtener los correos electrónicos desde auth.users
    const { data: userData, error: fetchUsersError } = await supabaseAdmin.auth.admin.listUsers();

    if (fetchUsersError) {
        throw new Error(`Error al obtener usuarios: ${fetchUsersError.message}`);
    }

    const users = userData?.users
        ?.map((user) => user.email)
        .filter((email): email is string => email !== undefined); // Filtrar emails undefined

    // Paso 2: Obtener los rangos desde la tabla Administradores
    const { data: administradoresData, error: fetchAdminError } = await supabaseAdmin
        .from("Administradores")
        .select("rango, user_email");

    if (fetchAdminError) {
        throw new Error(`Error al obtener rangos: ${fetchAdminError.message}`);
    }

    // Paso 3: Crear un mapa para asociar emails con sus rangos
    const rangosMap = new Map(
        administradoresData?.map((admin) => [admin.user_email, admin.rango])
    );

    // Paso 4: Combinar los usuarios con sus rangos
    usersWithRangos = users.map((email) => ({
        email,
        rango: rangosMap.get(email) || "Sin Rango", // "Sin Rango" si no está en la tabla Administradores
    }));
}  catch (err) {
    console.error("Error al procesar los datos:", err);

    // Verifica el tipo del error
    if (err instanceof Error) {
        error = err.message; // Accede al mensaje del error
    } else {
        error = "Error desconocido"; // Mensaje genérico para casos no esperados
    }
} 
---

<section class="max-w-4xl w-full h-auto p-10 mx-auto my-auto">
    {error ? (
        <p class="text-red-500 text-center text-2xl">Ocurrió un error al obtener los datos: {error}</p>
    ) : (
        <>
            <h2 class="text-center text-accent font-bold text-5xl">
                Usuarios Registrados
            </h2>  
            <table class="text-xl text-blanco font-normal max-w-3xl w-full h-auto my-2 border-spacing-y-8">
            <tr><td><h4 class="text-amarillo font-bold text-3xl my-2">Email</h4></td>    <td><h4 class="text-amarillo font-bold text-3xl my-2">Curs</h4></td> <td></td></tr>
            {usersWithRangos.map((user) => (
                <tr >
                    <td translate="no">
                        {user.email}
                    </td>
                    
                    <td>
                        {user.rango}
                    </td>

                    <td>
                        <a>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 60 60">
                                <circle cx="30" cy="30" r="27.5" stroke="#1666FF" stroke-width="5"/>
                                <path fill="#1666FF" d="M20 40h2l14-14-2-2-14 14v2Zm-3 3v-6l19-19h1l1-1 1 1h1l2 2v1a3 3 0 0 1 0 2v1L23 43h-6Zm18-18-1-1 2 2-1-1Z"/>
                            </svg>
                        </a>
                    </td>
                </tr>
                 
            ))}
            </table>
                
        </>
    )}
</section>
