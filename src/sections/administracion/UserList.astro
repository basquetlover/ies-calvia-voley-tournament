---
import { supabaseAdmin } from "../../lib/supabase";

// Define una estructura para los usuarios con rango
interface UserWithRango {
    email: string;
    rango: string;
}

let error = null;
let usersWithRangos: UserWithRango[] = [];
let Owners: UserWithRango[] = [];



const { data: OwnerData, error: fetchOwnerError } = await supabaseAdmin
        .from("Administradores")
        .select("rango, user_email")
        .eq('rango', 'Owner');
const { data: CoOwnerData, error: fetchCoOwnerError } = await supabaseAdmin
        .from("Administradores")
        .select("rango, user_email")
        .eq('rango', 'Co-Owner');
const { data: StaffData, error: fetchStaffError } = await supabaseAdmin
        .from("Administradores")
        .select("rango, user_email")
        .eq('rango', 'Staff');
const { data: OfMesaData, error: fetchOfMesaError } = await supabaseAdmin
        .from("Administradores")
        .select("rango, user_email")
        .eq('rango', 'Oficial de Mesa');
const { data: ArbitrosData, error: fetchArbitrosError } = await supabaseAdmin
        .from("Administradores")
        .select("rango, user_email")
        .eq('rango', 'Arbitro');
        const { data: ProfesorData, error: fetchProfesorError } = await supabaseAdmin
        .from("Administradores")
        .select("rango, user_email")
        .eq('rango', 'Professor');
const { data: SinRangoData, error: fetchSinRangoError } = await supabaseAdmin
        .from("Administradores")
        .select("rango, user_email")
        .eq('rango', '');
