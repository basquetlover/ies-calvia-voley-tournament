---
import { supabaseAdmin } from "src/lib/supabase";

let { data: Usuarios, error } = await supabaseAdmin
  .from('Usuarios')
  .select('nombre, curso, email')
  .order('id', { ascending: false });

  // Verifica que Usuarios no sea null
if (!Usuarios) {
    return console.log("no hay usuarios")
}

// Define el número inicial de usuarios a mostrar
const initialCount = 10;
const totalUsuarios = Usuarios.length;

// Obtén el número de usuarios a mostrar desde la URL
const url = new URL(Astro.request.url);
const countParam = url.searchParams.get('count');
const count = countParam ? parseInt(countParam) : initialCount; // Maneja el caso de null
const minimo = count - 10
// Calcula los usuarios a mostrar
const usuariosToShow = Usuarios.slice(minimo, count);
---
<div class="max-w-2xl w-auto mx-auto h-auto content-center mb-10">
    <div class="flex flex-col relative w-full mx-auto ">
        <h3 class="text-amarillo text-center text-3xl my-5">Lista Usuarios</h3>
        <div class="w-full h-[500px] rounded-lg p-4 text-blanco text-lg bg-gris-claro overflow-x-scroll flex flex-col items-center ">
            
                <table class="w-full font-normal gap-2">
                    <tr class="w-full text-amarillo">
                        <th><p>Nombre</p></th>
                        <th><p>Curso</p></th>
                        <th><p>Email</p></th>
                    </tr>
                    <tbody>
                        {usuariosToShow.map((usuario) => (
                            <tr class="font-normal text-center gap-y-2" >
                                        <td><p>{usuario.nombre}</p></td>
                                        <td><p>{usuario.curso}</p></td>
                                        <td><p>{usuario.email}</p></td>
                                        <td>
                                        <a href={`/admin/usuario/${usuario.email}`} class="group">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 group-hover:fill-amarillo" fill="none" viewBox="0 0 60 60">
                                                <circle cx="30" cy="30" r="27.5" stroke="#1666FF" stroke-width="5"/>
                                                <path fill="#1666FF" d="M20 40h2l14-14-2-2-14 14v2Zm-3 3v-6l19-19h1l1-1 1 1h1l2 2v1a3 3 0 0 1 0 2v1L23 43h-6Zm18-18-1-1 2 2-1-1Z"/>
                                            </svg>
                                        </a>
                                    </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
                <div class="w-full flex flex-row items-center place-content-around">
                {count !== 10 && ( // Mostrar botón si hay más usuarios
                    <a href={`?count=${count - 10}`} class="mt-6 mx-auto w-max h-max bg-accent px-3 py-3 rounded-full">
                        Anterior
                    </a>
                )}
                {count < totalUsuarios && ( // Mostrar botón si hay más usuarios
                    <a href={`?count=${count + 10}`} class="mt-6 mx-auto w-max h-max bg-accent px-3 py-3 rounded-full">
                        Siguiente
                    </a>
                )}
                </div>
            
        </div>
    </div>
</div>




