import { supabaseAdmin } from "src/lib/supabase";

interface Equipo {
  nombre_equipo: string;
  escudo: string;
}

interface Partido {
  equipo_a: string;
  equipo_b: string;
  id: string;
  arbitro: string;
  oficial_mesa_1: string;
  oficial_mesa_2: string;

}

let pista1: Partido[] = [];
let escudosMapPista1: Record<string, string> = {}; // Mapa para guardar escudos por nombre de equipo

let pista2: Partido[] = [];
let escudosMapPista2: Record<string, string> = {}; // Mapa para guardar escudos por nombre de equipo


try {
  // Obtener partidos de la pista 1
  const { data, error } = await supabaseAdmin
    .from('ResultadoNavidad')
    .select('equipo_a, equipo_b, id, oficial_mesa_1, arbitro, oficial_mesa_2')
    .eq('pista', 'Pista 1')
    .order('id', { ascending: true });

  if (error) {
    console.error(`Error al buscar partido 1`, error.message);
  } else {
    pista1 = data || []; // Asignar data a pista1
  }

  // Obtener todos los nombres de los equipos
  const equiposNombres = [...new Set(pista1.flatMap(partido => [partido.equipo_a, partido.equipo_b]))];

  // Obtener escudos de los equipos
  const { data: equipos, error: errorEquipos } = await supabaseAdmin
    .from('Equipos')
    .select('nombre_equipo, escudo')
    .in('nombre_equipo', equiposNombres);

  if (errorEquipos) {
    console.error(`Error al buscar escudos de equipos`, errorEquipos.message);
  } else {
    // Crear un mapa de escudos
    escudosMapPista1 = equipos.reduce((acc: Record<string, string>, equipo: Equipo) => {
      acc[equipo.nombre_equipo] = equipo.escudo;
      return acc;
    }, {});
  }
} catch (err) {
  console.error('Error al obtener rango:', err);
}

try {
  // Obtener partidos de la pista 1
  const { data, error } = await supabaseAdmin
    .from('ResultadoNavidad')
    .select('equipo_a, equipo_b, id, oficial_mesa_1, arbitro, oficial_mesa_2')
    .eq('pista', 'Pista 2')
    .order('id', { ascending: true });

  if (error) {
    console.error(`Error al buscar partido 1`, error.message);
  } else {
    pista2 = data || []; // Asignar data a pista2
  }

  // Obtener todos los nombres de los equipos
  const equiposNombres = [...new Set(pista2.flatMap(partido => [partido.equipo_a, partido.equipo_b]))];

  // Obtener escudos de los equipos
  const { data: equipos, error: errorEquipos } = await supabaseAdmin
    .from('Equipos')
    .select('nombre_equipo, escudo')
    .in('nombre_equipo', equiposNombres);

  if (errorEquipos) {
    console.error(`Error al buscar escudos de equipos`, errorEquipos.message);
  } else {
    // Crear un mapa de escudos
    escudosMapPista2 = equipos.reduce((acc: Record<string, string>, equipo: Equipo) => {
      acc[equipo.nombre_equipo] = equipo.escudo;
      return acc;
    }, {});
  }
} catch (err) {
  console.error('Error al obtener rango:', err);
}

interface UserEmail {
    email: string;
}

let users: UserEmail[] = []; // Especifica que es un array de UserEmail
let error: string | null = null; // Manejo de errores

async function listarUsuarios() {
    const { data, error: fetchError } = await supabaseAdmin.auth.admin.listUsers();

    if (fetchError) {
        console.error("Error fetching usuarios:", fetchError);
        error = fetchError.message; // Almacena el mensaje del error
        return;
    }

    // Verifica si 'data.users' es un array antes de mapear
    if (Array.isArray(data.users)) {
        // Extrae solo los correos electrónicos de los usuarios, asegurando que no sean undefined
        users = data.users
            .map((user) => {
                return { email: user.email }; // Crea un objeto UserEmail
            })
            .filter((user): user is UserEmail => user.email !== undefined); // Filtra los correos no definidos

        // Imprime solo los correos electrónicos en la consola
        // console.log("Correos de usuarios:", users.map(user => user.email));
    } else {
        // Si 'data.users' no es un array, imprime su contenido para depuración
        console.error("La respuesta no es un array:", data);
        error = "La respuesta no es un array.";
    }
}

// Llama a la función
await listarUsuarios();
