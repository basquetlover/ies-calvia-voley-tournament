---
import { supabaseAdmin } from '../../lib/supabase';

interface Torneo {
  id_torneo: string;
  nombre: string;
  equipos: Equipo[];
}

interface Equipo {
  id: number;
  id_equipo: string;
  nombre_equipo: string;
  capitan: string;
  entrenador: string;
  escudo: string | null;
  inscrito: number;
  estado: string | null;
  aceptado: string | null;
  numero?: number;
}

let torneosConEquipos: Torneo[] = [];

const { data: torneos, error: errorTorneos } = await supabaseAdmin
  .from('Configuracion')
  .select('id_torneo, nombre')
  .order('id', { ascending: false });

if (errorTorneos) {
  console.error('Error al obtener los torneos:', errorTorneos);
}

if (torneos) {
  for (const torneo of torneos) {
    const tablaEquipos = `Equipos${torneo.id_torneo}`;
    const tablaJugadores = `Jugadores${torneo.id_torneo}`;

    const { data: equipos, error: errorEquipos } = await supabaseAdmin
      .from(tablaEquipos)
      .select(
        'id_equipo, nombre_equipo, capitan, entrenador, escudo, inscrito, estado, aceptado, id'
      )
      .order('id', { ascending: true });

    if (errorEquipos || !equipos) continue;

    const equiposConNumero = await Promise.all(
      equipos.map(async (equipo) => {
        const { data: jugadores, error } = await supabaseAdmin
          .from(tablaJugadores)
          .select('id')
          .eq('pertenece_equipo', equipo.id);

        if (error) {
          console.warn(
            `Error jugadores equipo ${equipo.nombre_equipo}:`,
            error.message
          );
        }

        

           const numero = jugadores ? jugadores.length : 0;

    // 👇 CONSOLE LOG AQUÍ
    // console.log(
    //   `Equipo: ${equipo.nombre_equipo} → ${numero} jugadores`
    // );

    return {
      ...equipo,
      numero,
    };
        
      })
    );
      
    torneosConEquipos.push({
      id_torneo: torneo.id_torneo,
      nombre: torneo.nombre,
      equipos: equiposConNumero,
    });
  }
}
---


{torneosConEquipos.map((torneo) => (
  <section class="my-16">
    <h2 class="ml-10 text-accent font-bold text-5xl">
      Equipos {torneo.nombre}
      <span class="text-amarillo">
  {torneo.equipos.filter(e => e.aceptado === "Inscrit").length}
  <span class="text-3xl"> / {torneo.equipos.length}</span>
</span>
    </h2>

    {torneo.equipos.length === 0 ? (
      <div class="w-full h-auto mt-10 flex items-center place-content-center">
        <section class="max-w-2xl w-full h-max p-0 mx-auto my-auto">
          <h2 class="w-full text-center text-amarillo uppercase font-bold text-4xl">No se encontraron equipos</h2>
          <p class="text-blanco text-xl text-center my-2">
            Aún no hay equipos introducidos en la base de datos.
          </p>
        </section>
      </div>
    ) : (
      <div class="max-w-7xl my-10 w-auto mx-auto flex flex-wrap gap-4 items-center place-content-center">
        {torneo.equipos.map((equipo) => (
          <a href={`/admin/equiposSS/${equipo.id_equipo}?torneoID="${torneo.id_torneo}"`} class="w-80 h-80 p-4 relative rounded-lg bg-azul-suave group transition-all duration-300">
            <div class="w-full h-full grid grid-cols-1 grid-rows-[auto_1fr_auto_auto]">
              <p class="text-blanco text-lg font-semibold" translate="no">{equipo.nombre_equipo} — {equipo.numero}</p>
              <div class="flex items-center justify-center w-full h-full">
                {equipo.escudo && equipo.escudo.trim() !== "" ? (
                  <img 
                    class="w-36 h-36 rounded-lg" 
                    src={equipo.escudo} 
                    alt={`escudo equipo ${equipo.nombre_equipo}`} 
                  />
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-36 h-36" fill="none" viewBox="0 0 650 650">
                    <circle cx="325" cy="325" r="315" stroke="#313131" stroke-width="20"/>
                    <rect width="450" height="20" x="100" y="315" fill="#313131" rx="10"/>
                  </svg>
                )}
              </div>
              <p class="text-blanco text-base"><span class="font-semibold">Capità:</span> {equipo.capitan}</p>
              <div class="flex flex-row items-center place-content-around">
                <p class={`w-max h-max px-2 py-1 rounded-lg ${equipo.estado ===  "Revisant" ? "bg-naranja-claro text-naranja text-base uppercase font-semibold" : ""} ${equipo.estado ===  "Acceptat" ? "bg-verde-claro text-verde text-base uppercase font-semibold" : ""} ${equipo.estado ===  "Denegat" ? "bg-rojo-claro text-rojo text-base uppercase font-semibold" : ""}`}>{equipo.estado}</p>
                <p class={`w-max h-max px-2 py-1 rounded-lg ${equipo.aceptado ===  "Llista d'espera" ? "bg-rojo-claro text-rojo text-base uppercase font-semibold" : ""} ${equipo.aceptado ===  "Inscrit" ? "bg-verde-claro text-verde text-base uppercase font-semibold" : ""} ${equipo.aceptado === "Pendent" ? "text-blanco bg-gris-claro":""}`}>{equipo.aceptado}</p>
              </div>
            </div>
            <div class="group-hover:opacity-100 opacity-0 absolute top-0 left-0 flex items-center place-content-center rounded-lg w-full h-full bg-amarillo bg-opacity-60 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="w-52 h-52" viewBox="0 0 200 200">
                <circle cx="100" cy="100" r="95" stroke="#0E347D" stroke-width="10"/>
                <path fill="#0E347D" d="M67 133h7l46-46-7-7-46 46v7Zm-9 9v-20l62-61 3-2 3-1 4 1 3 2 6 6 2 3a10 10 0 0 1 0 7l-2 4-61 61H58Zm58-58-3-4 7 7-4-3Z"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
))}