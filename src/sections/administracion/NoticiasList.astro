---

import { supabaseAdmin } from '../../lib/supabase';
interface Noticia {
    id: number;
  id_noticia: string;
  titulo: string;
  category: string;
  fecha: string;
  imagen_noticia: string | null; // o string dependiendo de si puede ser nulo
}
// Obtener los equipos de la base de datos
const { data: equipos, error } = await supabaseAdmin
  .from('Noticias')
  .select('titulo, category, fecha, id_noticia, id, imagen_noticia ')
  .order('id', { ascending: true });


if (error) {
  console.error('Error al obtener los equipos:', error);
} else if (!equipos || equipos.length === 0) {
  console.log('No se encontraron equipos');
} else {
  console.log(`Se encontraron ${equipos.length} equipos`);
}
---
{!equipos || equipos.length === 0  && (
  <>
  <div class="w-full h-auto mt-10 flex items-center place-content-center">
  <section class="max-w-2xl w-full h-max p-0 mx-auto my-auto">
      <h2 class=" w-full text-center text-amarillo uppercase font-bold text-4xl">No se encontraron equipos</h2>
      
      <p class="text-blanco text-xl text-center my-2">
      Aun no hay equipos introducidos en la base de datos.
      </p>
      
          
  
      </section>
  </div>
  </>
  )}
<div class="max-w-7xl my-10 w-auto mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-3 gap-4 place-items-center">
    {equipos && equipos.map((noticia) => (
      <a class="w-80 h-96 relative rounded-lg bg-gris-claro group transition-all duration-300">
        <div class="w-full h-full flex flex-col">
          
          <div class="flex items-center justify-center w-auto h-auto max-h-44 overflow-hidden">
            {noticia.imagen_noticia && noticia.imagen_noticia.trim() !== "" ? (
              <img 
                transition:name="noticia-escudo" 
                class="w-full h-full rounded-lg" 
                src={noticia.imagen_noticia} 
                alt={`escudo noticia ${noticia.imagen_noticia}`} 
              />
            ) : (
              <svg xmlns="http://www.w3.org/2000/svg" class="w-40 h-w-40" fill="none" viewBox="0 0 650 650">
                <circle cx="325" cy="325" r="315" stroke="#313131" stroke-width="20"/>
                <rect width="450" height="20" x="100" y="315" fill="#313131" rx="10"/>
              </svg>
            )}
          </div>
          <div class="w-full h-auto flex flex-row items-center px-3 my-2 place-content-between">
            <p class="text-accent text-2xl underline ">{noticia.category}</p>
            <p class="text-amarillo text-xl  ">{noticia.fecha}</p>
          </div>
          <p class="text-accent text-4xl font-semibold px-2" translate="no">{noticia.titulo}</p>
          
        </div>

        {/* <div class="group-hover:opacity-100 opacity-0 absolute top-0 left-0 flex items-center place-content-center rounded-lg w-full h-full bg-amarillo bg-opacity-60 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="w-52 h-52" viewBox="0 0 200 200">
            <circle cx="100" cy="100" r="95" stroke="#0E347D" stroke-width="10"/>
            <path fill="#0E347D" d="M67 133h7l46-46-7-7-46 46v7Zm-9 9v-20l62-61 3-2 3-1 4 1 3 2 6 6 2 3a10 10 0 0 1 0 7l-2 4-61 61H58Zm58-58-3-4 7 7-4-3Z"/>
          </svg>
        </div> */}
      </a>
    ))}


    
  </div>