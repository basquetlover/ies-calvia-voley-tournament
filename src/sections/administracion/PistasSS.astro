<section class="max-w-full w-full flex flex-wrap gap-5  items-center place-content-center mt-5">
<div class="w-max h-auto bg-gris-claro p-2 rounded-lg">
  <h2 class="text-2xl text-accent font-semibold text-center">Pista 1</h2>
<ul class="flex flex-col gap-2">
  {pista1.map(partido => (
    <li class="bg-amarillo w-[400px] text-center grid grid-cols-[60px_1fr_30px_1fr_60px] items-center px-2 py-1 gap-2 rounded-lg"> 
