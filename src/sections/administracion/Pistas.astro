<section class="max-w-full w-full flex flex-wrap gap-10  items-center place-content-center">
<div class="w-max h-auto">
  <h2 class="text-2xl text-accent font-semibold text-center">Pista 1</h2>
<ul class="flex flex-col gap-2">
  {pista1.map(partido => (
    <li class="bg-amarillo w-[400px] text-center grid grid-cols-[60px_1fr_30px_1fr_60px] items-center px-2 py-1 gap-2 rounded-lg"> 
    <div>
      {escudosMapPista1[partido.equipo_a] && escudosMapPista1[partido.equipo_a].trim() !== "" ?  (
          <img src={escudosMapPista1[partido.equipo_a]} class="w-14 h-14" alt={partido.equipo_a} />
