---

<div>
    <form id="team-form" method="POST" class="space-y-4">
        <!-- Nombre del Equipo -->
        <div>
          <label for="nombre_equipo" class="block font-medium">Nombre del equipo:</label>
          <input
            type="text"
            id="nombre_equipo"
            name="nombre_equipo"
            placeholder="Nombre del equipo"
            required
            class="border rounded p-2 w-full"
          />
        </div>
      
        <!-- Imagen del Equipo -->
        <div>
            <label for="imagen" class="block font-medium">Sube la imagen del equipo:</label>
            <input
              type="file"
              id="imagen"
              name="imagen"
              accept="image/*"
              
              class="border rounded p-2 w-full"
            />
          </div>
      
        <!-- Capitán -->
        <div>
          <label for="capitan" class="block font-medium">Nombre del capitán:</label>
          <input
            type="text"
            id="capitan"
            name="capitan"
            placeholder="Nombre del capitán"
            required
            class="border rounded p-2 w-full"
          />
        </div>
      
        <!-- Entrenador -->
        <div>
          <label for="entrenador" class="block font-medium">Nombre del entrenador:</label>
          <input
            type="text"
            id="entrenador"
            name="entrenador"
            placeholder="Nombre del entrenador"
            required
            class="border rounded p-2 w-full"
          />
        </div>


         
  
  
