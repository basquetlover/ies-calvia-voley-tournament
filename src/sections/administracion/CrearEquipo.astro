---
import { CURSOS } from "@const/rangos";
export const jugadores = Array.from({ length: 6 }, () => ({ nombre: "", curso: "" }));
export const jugadores_extra = Array.from({ length: 4 }, () => ({ nombre: "", curso: "" }));

interface Jugador {
  nombre: string;
  curso: string;
}

---
<!-- Preview IMG escudo -->
<script>
const file = document.getElementById('foto') as HTMLInputElement;
const img = document.getElementById('img') as HTMLImageElement;
const defaultFile = 'Vector.png'; // Asegúrate de definir defaultFile

file.addEventListener('change', (e: Event) => {
  const target = e.target as HTMLInputElement;
  const files = target.files;
  
  if (files && files[0]) {
    const reader = new FileReader();
    reader.onload = function(e: ProgressEvent<FileReader>) {
      if (e.target && img) {
        img.src = e.target.result as string;
      }
    };
    reader.readAsDataURL(files[0]);
  } else {
    if (img) {
      img.src = defaultFile;
    }
  }
});
</script>


<div class="max-w-3xl mx-auto my-10">
  <form id="team-form" method="POST" class="space-y-4" action="/api/addequipo" enctype="multipart/form-data">
    <div class="mx-auto w-max">
      <input
        type="text"
        id="nombre_equipo"
        name="nombre_equipo"
        placeholder="Nombre del equipo"
        required
        class="mx-auto text-4xl xs:text-3xl sm:text-3xl md:text-4xl text-center border-none bg-transparent rounded text-accent py-2 px-3 w-auto"
      />
    </div>

    <!--Imagen Escudo -->
    <div class="w-60 h-60 p-10 border-8 rounded-xl border-[#787777] relative mx-auto">
      <img src="/img/Vector.png" class="w-full h-full" alt="avatar" id="img" />
      <input class="centrar w-full h-full cursor-pointer text-transparent select-none bg-transparent" type="file" name="escudo" id="foto" accept="image/*" />
      <label class="hidden" for="escudo"></label>
    </div>

    <div class="flex flex-row items-center ml-2">
      <label for="capitan" class="block text-amarillo text-2xl font-medium">Capitán</label>
      <input
        type="text"
        id="capitan"
        name="capitan"
        placeholder="Nombre del Capitán"
        required
        class="border-none ml-2 text-lg text-blanco bg-transparent rounded py-2 px-3 w-auto"
      />
    </div>

    <div class="flex flex-row items-center ml-2">
      <label for="entrenador" class="block text-amarillo text-2xl font-medium">Entrenador</label>
      <input
        type="text"
        id="entrenador"
        name="entrenador"
        placeholder="Nombre del entrenador"
        
        class="border-none ml-2 text-lg text-blanco bg-transparent rounded py-2 px-3 w-auto"
      />
    </div>
    <div class="w-max flex flex-row gap-2">
      <div class="px-3 py-2 w-96 h-12  text-2xl text-amarillo border-none"><h4>Jugadores</h4></div>
      <div class="px-3 py-2 w-96 h-12  text-2xl text-amarillo border-none"><h4>Curso</h4></div>
    </div>
    {jugadores.map((jugador, index) => (
      <div class="w-[95%] h-[2px] my-10 mx-auto border-none block rounded-full bg-accent select-none">&nbsp;</div>
      <div class="flex  flex-wrap items-stretch gap-6 space-x-2">
        <input
          type="text"
          name={`player_${index + 1}_name`}
          placeholder="Nombre del jugador"
          class="px-3 py-2 w-96 h-12 bg-gris-claro rounded-full text-base text-blanco border-none"
          required
          value={jugador.nombre}
         
        />
        <select
          name={`player_${index + 1}_curso`}
          class="px-3 py-2 w-72 h-12 bg-gris-claro rounded-full text-base text-blanco border-none"
          required
          value={jugador.curso}
          
        >
          <option value="" disabled selected={!jugador.curso}>Selecciona un curso</option>
          {CURSOS.map(({ label }) => (
            <option value={label}>
              {label}
            </option>
          ))}
        </select>
      </div>
    ))}

{jugadores_extra.map((jugador, index) => (
  <div class="w-[95%] h-[2px] my-10 mx-auto border-none block rounded-full bg-accent select-none">&nbsp;</div>
  <div class="flex  flex-wrap items-stretch gap-6 space-x-2">
    <input
      type="text"
      name={`extra_player_${index + 1}_name`}
      placeholder="Nombre del jugador"
      class="px-3 py-2 w-96 h-12 bg-gris-claro rounded-full text-base text-blanco border-none"
      value={jugador.nombre}
     
    />
    <select
      name={`extra_player_${index + 1}_curso`}
      class="px-3 py-2 w-72 h-12 bg-gris-claro rounded-full text-base text-blanco border-none"
      value={jugador.curso}
      
    >
      <option value="" selected={!jugador.curso}>Selecciona un curso</option>
      {CURSOS.map(({ label }) => (
        <option value={label}>
          {label}
        </option>
      ))}
    </select>
  </div>
))}

    

   
    <div class="w-full h-auto flex flex-wrap items-stretch gap-6 place-content-around">
      <a href="/admin/equipos" rel="noreferrer" class="px-3 py-2 flex flex-row items-center place-content-center font-semibold w-52 h-12 fill-blanco text-blanco bg-cancelar rounded-full text-xl hover:scale-110 duration-300 transition-all transform"> Cancelar </a>
      <button class="px-3 py-2 flex flex-row items-center place-content-center font-semibold w-52 h-12 fill-blanco text-blanco bg-aceptar rounded-full text-xl hover:scale-110 duration-300 transition-all transform">
          <svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" >
              <path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z"/>
          </svg>
          Guardar Equipo
      </button>
  </div>
  </form>
</div>


