---
import { BASES_COMPETICION } from "@const/base-competicion"
---
<section class="max-w-5xl h-auto m-auto my-10">
        {
            BASES_COMPETICION.map(({titulo, articulos, numero}) => (
                <h3 class="text-accent text-3xl font-bold mt-10">{numero}. {titulo}</h3>
                <ul class="text-blanco flex flex-col text-base ml-6 mt-4 custom-punto my-2">
                    {
                        articulos.map(({texto, numero}) => (
                            <li class="my-2 inline-flex items-start gap-2">
                                <span class="text-amarillo font-bold">
                                    {numero}
                                </span>
                                <p>
                                 {texto}
                                </p>
                            </li>
                        ))
                    }
                    
                </ul>
            ))
        }
    
    
</section>
