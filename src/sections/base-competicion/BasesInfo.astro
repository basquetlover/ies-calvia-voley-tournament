---
import { BASES_COMPETICION } from "@const/base-competicion"
---
<section class="max-w-[1600px] h-auto m-auto my-10">
        {
            BASES_COMPETICION.map(({titulo, articulos}) => (
                <h3 class="text-accent text-4xl font-bold mt-10">{titulo}</h3>
                <ul class="text-blanco text-lg ml-6 mt-4 custom-punto my-2">
                    {
                        articulos.map(({texto}) => (
                            <li class="my-2">
                                <p>
                                 {texto}
                                </p>
                            </li>
                        ))
                    }
                    
                </ul>
            ))
        }
    
    
</section>
<style>
    .custom-punto li {
    position: relative;
    padding-left: 1rem; /* Espacio para el nuevo "bullet" */
}

.custom-punto li::before {
    content: '•'; /* El símbolo del "bullet" */
    color: #FFC700; /* Color amarillo */
    position: absolute;
    left: 0;
    font-size: 1.125em; /* Tamaño del punto similar al texto */
}

</style>