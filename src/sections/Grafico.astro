---
// src/sections/Grafico.astro


// Extraer los años y los conteos

---
<h3 class="text-4xl text-accent font-semibold text-center">Evolució</h3>
<div class="my-10 mx-auto max-w-3xl w-full p-2">
    <canvas id="acquisitions"  style="height: 400px;"></canvas>
</div>

<script >
  import Chart from 'chart.js/auto';
  //const data = [{x: 'Jan', net: 100, }, {x: 'Feb', net: 120, cogs: 55, gm: 75}];
    

    const ctx = document.getElementById('acquisitions') as HTMLCanvasElement;
    new Chart(ctx, {
      type: 'line',
    data: {
    labels: ['TORNEIG ESTIU 2024','TORNEIG NADAL 2024', 'TORNEIG SETMANA SANTA 2025'],
    datasets: [{
    label: 'Jugadors',
    data: [112, 152, 174],
    fill: true,
    borderColor: 'rgb(22, 102, 255)',
    backgroundColor: 'rgb(22, 102, 255, .1)',
    tension: 0.1
  },
  {
    label: 'Equips',
    data: [11, 16, 14],
    fill: true,
    borderColor: 'rgb(255, 199, 0)',
    backgroundColor: 'rgb(255, 199, 0, .1)',
    tension: 0.1
  }]
  },
  options: {
      plugins: {
        legend: {
          labels: {
            color: 'white' // Cambia el color del texto de la leyenda
          }
        },
        tooltip: {
          titleColor: 'white', // Cambia el color del texto del título del tooltip
          bodyColor: 'white' // Cambia el color del texto del cuerpo del tooltip
        }
      },
      scales: {
        x: {
          ticks: {
            color: 'white' // Cambia el color del texto del eje X
          }
        },
        y: {
          ticks: {
            color: 'white' // Cambia el color del texto del eje Y
          }
        }
      }
    }
    });
</script>