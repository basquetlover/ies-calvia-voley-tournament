<script>
//SubMenu desktop
const boton_subemnu_desktop = document.getElementById('bot-noimp-desk')!;
const boton_subemnu_desktop_icon = document.getElementById('bot-noimp-desk-icon')!;
const submenu_desktop = document.getElementById('noimp-desk')!;

boton_subemnu_desktop.addEventListener('click', function() {
    if (submenu_desktop.classList.contains('active')) {
        submenu_desktop.classList.remove('active');
        boton_subemnu_desktop_icon.classList.remove('rotate');
    } else {
        submenu_desktop.classList.add('active');
        boton_subemnu_desktop_icon.classList.add('rotate');
    }
});




//Menu movil
const abrir_menu_movil = document.getElementById('menu-boton-abrir')!;
const cerrar_menu_movil = document.getElementById('menu-boton-cerrar')!;
const menu_movil = document.getElementById('menu-content')!;

abrir_menu_movil.addEventListener('click', function() {
  menu_movil.classList.add('active-flex');
});
cerrar_menu_movil.addEventListener('click', function() {
  menu_movil.classList.remove('active-flex');
});

//SubMenu movil
const boton_subemnu_movil = document.getElementById('bot-noimp-movil')!;
const boton_subemnu_movil_icon = document.getElementById('bot-noimp-movil-icon')!;
const submenu_movil = document.getElementById('noimp-movil')!;

boton_subemnu_movil.addEventListener('click', function() {
    if (submenu_movil.classList.contains('active-flex')) {
        submenu_movil.classList.remove('active-flex');
        boton_subemnu_movil_icon.classList.remove('rotate');
    } else {
        submenu_movil.classList.add('active-flex');
        boton_subemnu_movil_icon.classList.add('rotate');
    }
});

</script>
<script>
    //Menu Usuario
const usuario = document.getElementById('usuario')!;
const user_menu = document.getElementById('user-menu')!;
const cerrar_user_menu = document.getElementById('cerrar-user-menu')!;

usuario.addEventListener('click', function() {
    if (user_menu.classList.contains('desactivado')) {
        user_menu.classList.remove('desactivado');
        user_menu.classList.add('active-flex');
    }else{
        console.log("Error")
    }
});

cerrar_user_menu.addEventListener('click', function() {
    if (user_menu.classList.contains('active-flex')) {
        user_menu.classList.add('desactivado');
        user_menu.classList.remove('active-flex'); 
    }else{
        console.log("Error")
    }
});
</script>

