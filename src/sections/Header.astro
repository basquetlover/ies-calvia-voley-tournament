---


const { pathname } = Astro.url;
const normalizedPathName =
    pathname.length > 1 && pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;

// Define las páginas del menú y agrega la clase 'actual' si corresponde
const paginas_importantes = [
    { name: "Inicio", 
      href: "/" 
    },
    { name: "Normativa", 
      href: "/normativa" 
    },
    { name: "Clasificación",
      href: "" 
    },
    { name: "Inscripción",
      href: "" 
    },
].map((page) => ({
    ...page,
    isActive: normalizedPathName === page.href,
}));

const  paginas_secundarias = [
    {
        name: "Equipos",
        href: "/equipos",
    },
    {
        name: "Bases de Competición",
        href: "",
    },
    {
        name: "Contacto",
        href: "/contacto",
    }
]




---
<script>
//SubMenu desktop
const boton_subemnu_desktop = document.getElementById('bot-noimp-desk')!;
const boton_subemnu_desktop_icon = document.getElementById('bot-noimp-desk-icon')!;
const submenu_desktop = document.getElementById('noimp-desk')!;

boton_subemnu_desktop.addEventListener('click', function() {
    if (submenu_desktop.classList.contains('active')) {
        submenu_desktop.classList.remove('active');
        boton_subemnu_desktop_icon.classList.remove('rotate');
    } else {
        submenu_desktop.classList.add('active');
        boton_subemnu_desktop_icon.classList.add('rotate');
    }
});




//Menu movil
const abrir_menu_movil = document.getElementById('menu-boton-abrir')!;
const cerrar_menu_movil = document.getElementById('menu-boton-cerrar')!;
const menu_movil = document.getElementById('menu-content')!;

abrir_menu_movil.addEventListener('click', function() {
  menu_movil.classList.add('active-flex');
});
cerrar_menu_movil.addEventListener('click', function() {
  menu_movil.classList.remove('active-flex');
});

//SubMenu movil
const boton_subemnu_movil = document.getElementById('bot-noimp-movil')!;
const boton_subemnu_movil_icon = document.getElementById('bot-noimp-movil-icon')!;
const submenu_movil = document.getElementById('noimp-movil')!;

boton_subemnu_movil.addEventListener('click', function() {
    if (submenu_movil.classList.contains('active-flex')) {
        submenu_movil.classList.remove('active-flex');
        boton_subemnu_movil_icon.classList.remove('rotate');
    } else {
        submenu_movil.classList.add('active-flex');
        boton_subemnu_movil_icon.classList.add('rotate');
    }
});
</script>

<header class=" w-full flex flex-row content-center justify-center  ">
    <!-- Menu Desktop -->
    <section class="py-2 w-full h-auto flex flex-col content-center relative xs:hidden sm:hidden md:flex ">
        <nav class="w-[90%] h-auto mb-2 grid grid-cols-5 grid-rows-1 place-items-center justify-center m-auto">
            {paginas_importantes.slice(0, 2).map((page) => (
                
                <a
                    href={page.href}
                    class={`redirect ${page.isActive ? 'actual' : ''} group relative flex flex-col items-center w-max text-center text-2xl text-white transition-all hover:text-amarillo ${!page.href ? 'pointer-events-none ' : ''}`}
                    title={`Página ${page.name.toLowerCase()}`}
                >
                    {page.name}
                    {!page.href && <p class="text-base text-accent">Próximamente</p>}
                    <span class="absolute top-[-5px] left-[-10px] w-[40px] h-[20px] border-[2px] border-accent border-r-0 border-b-0 rounded-tl-[10px] opacity-0 transform scale-100 transition-all duration-300 group-hover:opacity-100 group-hover:scale-[1.2]"></span>
                    <span class="absolute bottom-[-5px] right-[-10px] w-[40px] h-[20px] border-[2px] border-accent border-t-0 border-l-0 rounded-br-[10px] opacity-0 transform scale-100 transition-all duration-300 group-hover:opacity-100 group-hover:scale-[1.2]"></span>
                </a>
                
            ))}
        
        <a href="/" class="btn-principal relative flex items-center justify-center w-max text-center text-[40px] group cursor-pointer">
            <img src="img/logo_torneo.png" alt="logo web" class="w-[80px] h-auto group-hover:scale-125 transform transition-transform duration-300" />
            <span class="absolute top-[2.5px] left-[2.5px] w-[70px] h-[70px] rounded-full border-[2px] border-accent opacity-0 transition-all duration-300 transform scale-100 rotate-[-45deg] btn-principal-hover"></span>
        </a>
        
        
            {paginas_importantes.slice(2).map((page) => (
                <a
                    href={page.href}
                    class={`redirect ${page.isActive ? 'actual' : ''} group relative flex flex-col items-center w-max text-center text-2xl text-white transition-all hover:text-amarillo ${!page.href ? 'pointer-events-none ' : ''}`}
                    title={`Página ${page.name.toLowerCase()}`}
                >
                    {page.name}
                    {!page.href && <p class="text-base text-accent">Próximamente</p>}
                    <span class="absolute top-[-5px] left-[-10px] w-[40px] h-[20px] border-[2px] border-accent border-r-0 border-b-0 rounded-tl-[10px] opacity-0 transform scale-100 transition-all duration-300 group-hover:opacity-100 group-hover:scale-[1.2]"></span>
                    <span class="absolute bottom-[-5px] right-[-10px] w-[40px] h-[20px] border-[2px] border-accent border-t-0 border-l-0 rounded-br-[10px] opacity-0 transform scale-100 transition-all duration-300 group-hover:opacity-100 group-hover:scale-[1.2]"></span>
                </a>
                
            ))}
        </nav>

        <!--Menu enlaces no importantes -->
        <!--Boton -->
        <div class="w-12 h-12 fill-blanco hover:fill-amarillo hover:cursor-pointer duration-300 transition-all flex content-center justify-center absolute right-10 top-5 md:right-[3%]" id="bot-noimp-desk">
            <svg class="w-12 h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" id="bot-noimp-desk-icon">
                <path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z"/>
            </svg>
        </div>
        <!--Enlaces -->
        <nav class="w-[90%] h-auto mb-2 hidden grid-cols-3 grid-rows-1 place-items-center justify-center m-auto border-t-2 border-accent rounded-1 p-2" id="noimp-desk">
            
            {
                paginas_secundarias.map(({name, href}) => (
                <a
                    href={href}
                    class={` group relative flex flex-col items-center w-max text-center text-2xl text-white transition-all hover:text-amarillo ${!href ? 'pointer-events-none ' : ''}`}
                    title={`Página ${name}`}
                >
                    {name}
                    {!href && <p class="text-base text-accent">Próximamente</p>}
                    <span class="absolute top-[-5px] left-[-10px] w-[40px] h-[20px] border-[2px] border-accent border-r-0 border-b-0 rounded-tl-[10px] opacity-0 transform scale-100 transition-all duration-300 group-hover:opacity-100 group-hover:scale-[1.2]"></span>
                    <span class="absolute bottom-[-5px] right-[-10px] w-[40px] h-[20px] border-[2px] border-accent border-t-0 border-l-0 rounded-br-[10px] opacity-0 transform scale-100 transition-all duration-300 group-hover:opacity-100 group-hover:scale-[1.2]"></span>
                </a>
                ))
            }
        </nav>
        
        <div class="mt-3 w-[95%] h-[2px] bg-amarillo mx-auto"></div>
    </section>
    
   <!-- Menu Movil -->

    <!--Menu desactivado -->
   <section class="shadow hidden xs:flex sm:flex md:hidden w-full max-h-25 h-full flex-col  relative ">
        <div class="w-[95%] h-auto flex flex-row justify-between py-5 mx-auto">
            <a href="/" title="Pàgina actual" class="relative w-16 flex place-content-center justify-center cursor-pointer group">
                <img src="img/logo_torneo.png" alt="logo torneo" class="w-16 h-16 group-hover:scale-125 transform transition-transform duration-300"/>
            </a>
            <div class="w-16 h-16 fill-blanco hover:fill-amarillo duration-300 transition-all" id="menu-boton-abrir">
                <svg class="w-16 h-16" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z"/></svg>
            </div>
        </div>
        <div class="mt-3 w-[95%] h-[2px] bg-amarillo mx-auto"></div>
    </section>

<!--Menu activado -->
<div class="menu hidden flex-col gap-3 bg-gris w-full h-full fixed overflow-y-auto barra-overflow z-10 grid-cols-1 grid-rows-[100px_1fr_1fr]  place-items-center m-0 py-10" id="menu-content">
    
  <div class="w-[95%] py-3 h-auto flex flex-row justify-around content-center">
