const { pathname } = Astro.url;
const normalizedPathName =
    pathname.length > 1 && pathname.endsWith("/") ? pathname.slice(0, -1) : pathname;

// Define las páginas del menú y agrega la clase 'actual' si corresponde
const paginas_importantes = [
    { name: "Inici", 
      href: "/" 
    },
    { name: "Normativa", 
      href: "/normativa",
    },
    { name: "Clasificació",
      href: "/clasificacion" 
    },
    { name: "Notícies",
      href: "/noticias" 
    },
].map((page) => ({
    ...page,
    isActive: normalizedPathName === page.href,
}));

const paginas_secundarias = [
    { name: "Equips", href: "/equipos" },
    { name: "Bases de Competició", href: "/bases-de-competicion" },
    { name: "Contacte", href: "/contacto" },
    { name: "Informació", href: "/informacion" },
    { name: "Inscripció", href: "/inscripcion" },
].map((page) => ({
    ...page,
    isActive: normalizedPathName === page.href,
}));


import { supabaseAdmin } from 'src/lib/supabase';
import { verificarSesion } from '../lib/session'; // Asegúrate de que la ruta sea correcta
import UserLogo from '@components/UserLogo.astro';
import UserMenu from '@components/UserMenu.astro';

// Verifica la sesión y obtiene el usuario
const usuario = await verificarSesion(Astro.request);

let equipo = "Sense Equip"
let escudo = "/img/escudos/sin-escudo-blanco.png"

if(usuario){
    const usuario_nombre = usuario.nombre;

    

    let { data: Jugador, error: errorJ } = await supabaseAdmin
    .from('Jugadores')
    .select('pertenece_equipo')
    .eq('nombre', usuario_nombre)
    .single(); // Use .single() to get a single record

    if (errorJ) {
    console.error('Jugador sin equipo',);
    // Handle the error appropriately
    }

    if (!Jugador) {
    console.error('No Jugador found for the given nombre');
    // Handle the case where no Jugador is found
    } else {
    let { data: Equipos, error: errorE } = await supabaseAdmin
        .from('Equipos')
        .select('nombre_equipo, escudo')
        .eq('id', Jugador.pertenece_equipo)
        .single(); // Use .single() to get a single record

    if (errorE) {
        console.error('Error fetching Equipos:', errorE);
        // Handle the error appropriately
    }
    if(Equipos){
        equipo = Equipos.nombre_equipo
        escudo = Equipos.escudo
    }
    }
}

