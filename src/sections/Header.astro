                    <hr class="h-[2px] border-none bg-amarillo rounded-full w-[75%] my-2" />    
                    <a
                    href={href}
                    class={`redirect ${isActive ? 'actual' : 'hover:text-amarillo'} group relative flex flex-col place-content-center items-center w-max h-16   text-center text-2xl text-white transition-all ${!href ? 'pointer-events-none' : ''}`}
                    title={`Página ${name.toLowerCase()}`}
                  >
                    {name}
                    
                    {/* Span superior izquierdo */}
                    <span class={`absolute top-[-5px] left-[-10px] w-[40px] h-[20px] border-[2px] border-accent border-r-0 border-b-0 rounded-tl-[10px] 
                      ${isActive ? 'opacity-100 scale-[1.2]' : 'opacity-0 scale-100 group-hover:opacity-100 group-hover:scale-[1.2]'} 
                      transition-all duration-300`}>
                    </span>
                    
                    {/* Span inferior derecho */}
                    <span class={`absolute bottom-[-5px] right-[-10px] w-[40px] h-[20px] border-[2px] border-accent border-t-0 border-l-0 rounded-br-[10px] 
                      ${isActive ? 'opacity-100 scale-[1.2]' : 'opacity-0 scale-100 group-hover:opacity-100 group-hover:scale-[1.2]'} 
                      transition-all duration-300`}>
                    </span>
              
                    {!href && <p class="text-base text-accent">Pròximament</p>}
                  </a>
                ))
            }
        </nav>
</div>
</header>




