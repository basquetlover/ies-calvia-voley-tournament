<style>
    .active{
        display: grid;
    }
    .active-flex{
        display: flex;
    }
    .shadow{
        box-shadow: 10px 0 0 #1B1D20;
    }
    .rotate {
    transform: rotate(180deg);
    animation: rotacion 0.3s ease-in-out;
    }
    .barra-overflow::-webkit-scrollbar {
    display: none; 
}
@keyframes rotacion {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(180deg); }
}

</style>
