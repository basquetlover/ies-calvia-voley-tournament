          <span class="absolute bottom-[-5px] right-[-10px] w-[40px] h-[20px] border-[2px] border-accent border-t-0 border-l-0 rounded-br-[10px] opacity-0 transform scale-100 transition-all duration-300 group-hover:opacity-100 group-hover:scale-[1.2]"></span>
      </a>
      
  ))}

  </nav>
   <!--Menu enlaces no importantes -->
        <!--Boton -->
        <hr class="h-[2px] border-none bg-azul rounded-full w-[75%] m-0" />
        <div class="w-12 h-12 fill-blanco hover:fill-amarillo hover:cursor-pointer duration-300 transition-all flex content-center justify-center " id="bot-noimp-movil">
            <svg class="w-12 h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" id="bot-noimp-movil-icon">
                <path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z"/>
