<style>
    .desactivado{
        display: none;
    }
    .active{
        display: grid;
    }
    .active-flex{
        display: flex;
    }
    .shadow{
        box-shadow: 10px 0 0 #1B1D20;
    }
    .rotate {
    transform: rotate(180deg);
    animation: rotacion 0.3s ease-in-out;
    }
    .actual{
        color: #FFC700;
        pointer-events: none;
    }
    .barra-overflow::-webkit-scrollbar {
    display: none; 
}
