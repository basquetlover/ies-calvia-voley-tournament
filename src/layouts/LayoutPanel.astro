---
import Footer from '@components/panel/Footer.astro';
import Hero from '@components/panel/Hero.astro';
import Nav from '@components/panel/Nav.astro';
import NivelSeguridad from '@components/panel/NivelSeguridad.astro';
import Notificaciones from '@components/panel/Notificaciones.astro';
import { verificarAdminSesion } from 'src/lib/usuario_panel';
import "../styles/global.css";
const url = new URL(Astro.request.url);
const redirect = url.pathname + url.search;

interface Props {
	title: string;
}

const { title } = Astro.props;

// const usuario = {
//     nombre: "Admin",
// 	email: "admin@example.com",
//     nivel_seguridad: 3 as 1 | 2 | 3
// };
// const usuario = null

const usuario = await verificarAdminSesion(Astro.request);

if(usuario && usuario.rango !== "") {
	var usuario_admin = usuario;
} else {
	var usuario_admin = null;
}


//  usuario_admin = null;

---


<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Panel de Administración de IES Calvià Voley Tournament." />
		<meta name="viewport" content="width=device-width" />
		<meta name="keywords" content="torneo, tournament, volleyball, galatzo, santa ponsa, santa, ponsa, voleibol, voley, navidad, ies, calvia, TEAM Teto, deportes, Calvià" />
		<meta name="generator" content={Astro.generator} />
		
		<meta name="author" content="Pere Alemany Tomàs">
		<title>{title} | IES Calvià Voley Tournament</title>


		<link rel="icon" type="image/png" href="/logo_32x32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/logo_16x16.png" sizes="16x16" />
		<link rel="icon" type="image/svg+xml" sizes="any" href="/Group-110.svg" /> 
 		<link rel="shortcut icon" href="/Group-110-_2_.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" /> 
		<!-- <script src="/scripts/analytics.js" defer></script> -->

		<!-- Fuentes de Google -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-gris overflow-hidden text-blanco fill-blanco">
		
        {
            usuario_admin ? (<>
                <div id="layout" class="h-dvh grid grid-cols-[auto_1fr] overflow-hidden">
					<div>
						<div id="MenuDesktop" class="overflow-hidden max-md:absolute max-md:bg-gris/60 max-md:z-50 max-md:w-0 w-56 transition-all duration-300 ease-in-out">
							<div class="h-[98%]">
								<Nav usuario={usuario_admin} />
							</div>
						</div>
					</div>

					<div class="grid grid-rows-[auto_auto_1fr_auto] overflow-hidden h-dvh">
						<div class="flex  items-center gap-x-4 w-full border-b border-gris-claro">
							<span class="btn-MenuDesktop w-max h-max p-2 hover:bg-rosa/50 rounded-full cursor-pointer">
								
								<svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9" viewBox="0 -960 960 960">
									<path d="M120-240v-80h720v80H120Zm0-200v-80h720v80H120Zm0-200v-80h720v80H120Z"/>
								</svg>
							</span>
							<Hero />
						</div>
						<!-- NOTIFICACIONES -->
						<Notificaciones usuario={usuario} />

						<!-- CONTENIDO (ÚNICO SCROLL) -->
						<NivelSeguridad usuario={usuario_admin}>
						<main class="w-full mx-auto h-full overflow-y-auto p-2">
							<slot />
						</main>
						</NivelSeguridad>

						<!-- FOOTER -->
						{/* <Footer /> */}

					</div>
					</div>

            </>):(<>
                
				<main class="mx-auto w-full h-screen grid grid-rows-[1fr_auto]">
					<div class="w-full h-full flex flex-col items-center place-content-center text-center ">
						<h1 class="text-4xl font-bold text-blanco">Sessió requerida</h1>
						<div class="h-1 w-20 mt-4 rounded-full bg-accent">&nbsp;</div>

						<div class="h-96 max-w-xl mx-5 flex flex-col items-center bg-gris-claro px-10 py-5 rounded-xl border border-gray-400 gap-y-2 mt-10">
							<span class="p-4 bg-azul-claro/40 w-max h-max rounded-full flex items-center place-content-center">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 fill-azul-claro" viewBox="0 -960 960 960">
									<path d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920t141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80zm0-80h480v-400H240zm296.5-143.5Q560-327 560-360t-23.5-56.5T480-440t-56.5 23.5T400-360t23.5 56.5T480-280t56.5-23.5M360-640h240v-80q0-50-35-85t-85-35-85 35-35 85zM240-160v-400z"/>
								</svg>
							</span>
							<p class="text-2xl font-bold text-blanco">Has d'iniciar sessió</p>
							<p>Per accedir al panell d'administració necessites iniciar sessió amb el teu compte autoritzat.</p>
							<a href={`/iniciar-sesion?redirect=${redirect}`} class="flex items-center place-content-center w-full py-3 bg-azul-suave hover:bg-azul-suave/50 rounded-2xl text-blanco text-xl uppercase font-bold fill-blanco">
								Iniciar sessió
							</a>
							<div class="w-full h-0.5 my-2 bg-gray-600">&nbsp;</div>
							<p class="text-xs max-sm:text-[10px] text-gray-400 mb-1 fill-gray-400 font-semibold flex flex-row items-center place-content-center gap-x-1">
								<span class="w-max h-max">
									<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 -960 960 960">
										<path d="M480-80q-139-35-229.5-159.5T160-516v-244l320-120 320 120v244q0 10-.5 20t-1.5 20q-9-2-18.5-3t-19.5-1q-11 0-21 1t-21 3q1-10 1.5-19.5t.5-20.5v-189l-240-90-240 90v189q0 121 68 220t172 132q21-7 41-17t39-23v94q-19 10-39 17.5T480-80m194 0q-14 0-24-10t-10-24v-132q0-14 10-24t24-10h6v-40q0-33 23.5-56.5T760-400t56.5 23.5T840-320v40h6q14 0 24 10t10 24v132q0 14-10 24t-24 10zm46-200h80v-40q0-17-11.5-28.5T760-360t-28.5 11.5T720-320z"/>
									</svg>
								</span>
								Accés restringit només a personal autoritzat
							</p>
						</div>
					</div>
					<Footer />
				</main>	
            </>)
        }
        
	</body>
</html>
<style>
	
* {
	font-family: "Lexend", sans-serif;
	font-optical-sizing: auto;
	font-weight: <weight>;
	font-style: normal;
}
</style>
<script>
const btnsMenuDesktop = document.querySelectorAll('.btn-MenuDesktop');
const menuDesktop = document.getElementById('MenuDesktop');

let abierto = true;

btnsMenuDesktop.forEach(btn => {
    btn.addEventListener('click', () => {
        abierto = !abierto;

        if (abierto) {
            menuDesktop?.classList.remove('w-0');
            menuDesktop?.classList.add('w-56');

            menuDesktop?.classList.remove('max-md:w-0');
            menuDesktop?.classList.add('max-md:w-full');
        } else {
            menuDesktop?.classList.remove('w-56');
            menuDesktop?.classList.add('w-0');

            menuDesktop?.classList.remove('max-md:w-full');
            menuDesktop?.classList.add('max-md:w-0');
        }
    });
});
</script>