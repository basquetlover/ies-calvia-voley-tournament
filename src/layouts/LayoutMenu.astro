---
import Header from '@sections/Header.astro';
import Footer from '@sections/Footer.astro';

import SchemaMarkup from '@components/SchemaMarkup.astro';
import Loading from '@components/Loading.astro';

interface Props {
	title: string;
	descripcion: string;
}

const { title, descripcion } = Astro.props;



// import { ViewTransitions } from 'astro:transitions';

const images = [
  '/img/og.png',
  '/img/fondo2-enlaces.png',
];

const randomImage = images[Math.floor(Math.random() * images.length)];
const usuario = await verificarSesion(Astro.request);
if(usuario){
	console.log("Usuario:", usuario.email, usuario.nombre, usuario.curso )
}

import Analytics from '@vercel/analytics/astro'
import CookiesAlert from '@components/CookiesAlert.astro';
import { verificarSesion } from 'src/lib/session';

