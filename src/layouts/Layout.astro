---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Torneo de Voleyball del IES Calvià. Organizado por el TEAM Teto" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/img/logo_torneo.png"  />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>

	<body class="bg-gris ">


		<main class="flex-col items-center justify-center p-3">
			<slot />
		</main>


	</body>

</html>

