---
import Signin from '@components/admin/signin.astro';
import AdminHeader from '@sections/administracion/AdminHeader.astro';
import Footer from '@sections/Footer.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;

const user = Astro.locals.user
// console.log(user)

// const user = (Astro.locals as Locals).user;
// console.log(user)

---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Torneo de Voleyball del IES Calvià - Edicion Navidad. Organizado por el TEAM Teto" />
		<meta name="viewport" content="width=device-width" />
		
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>


		<link rel="icon" type="image/png" href="/logo_32x32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/logo_16x16.png" sizes="16x16" />
		<link rel="icon" type="image/svg+xml" sizes="any" href="/Group-110.svg" /> 
 		<link rel="shortcut icon" href="/Group-110-_2_.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />  
	</head>

	<body class="bg-gris ">
		
		{user && (
		<div class="grid grid-cols-[max-content_1fr] grid-rows-1 gap-0">
		
		
			<AdminHeader />
		

		<main class="flex-col items-center justify-center p-0">
			<slot />
		</main>
	</div>
		
			 <Footer /> 
		
		)} 

		<Signin />
    
	
		

	
		
	</body>

</html>

