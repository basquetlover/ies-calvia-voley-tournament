---
import AdminHeader from '@sections/administracion/AdminHeader.astro';
import Footer from '@sections/Footer.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Torneo de Voleyball del IES Calvià - Edicion Navidad. Organizado por el TEAM Teto" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon"  href="img/logo_torneo.png" sizes="16x16"/>
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>

	<body class="bg-gris ">

	<div class="grid grid-cols-[max-content_1fr] grid-rows-1 gap-0">
		
			<AdminHeader />
		

		<main class="flex-col items-center justify-center p-0">
			<slot />
		</main>
	</div>
		
			<!-- <Footer /> -->
		

	
		
	</body>

</html>

