---

import ControlStaff from '@components/ControlStaff.astro';
import SinSession from '@sections/errores/SinSession.astro';


interface Props {
	title: string;
}

const { title } = Astro.props;
const usuario = await verificarSesion(Astro.request);
if(usuario){
	console.log("Usuario:", usuario.email, usuario.nombre, usuario.curso )
}

const user = Astro.locals.StaffUser
import Analytics from '@vercel/analytics/astro'
import { verificarSesion } from 'src/lib/session';
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="es">
	<head>
		<script src="/scripts/analytics.js" defer></script>
		<meta charset="UTF-8" />
		<meta name="description" content="Panel de Administración de IES Calvià Voley Tournament." />
		<meta name="viewport" content="width=device-width" />
		<meta name="keywords" content="torneo, tournament, volleyball, galatzo, santa ponsa, santa, ponsa, voleibol, voley, navidad, ies, calvia, TEAM Teto, deportes, Calvià" />
		<meta name="generator" content={Astro.generator} />
		
		<meta name="author" content="Pere Alemany Tomàs">
		<title>{title} | IES Calvià Voley Tournament</title>


		<link rel="icon" type="image/png" href="/logo_32x32.png" sizes="32x32" />
		<link rel="icon" type="image/png" href="/logo_16x16.png" sizes="16x16" />
		<link rel="icon" type="image/svg+xml" sizes="any" href="/Group-110.svg" /> 
 		<link rel="shortcut icon" href="/Group-110-_2_.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" /> 

			 <!-- Google tag (gtag.js) -->
			 <script type="text/partytown" async src="https://www.googletagmanager.com/gtag/js?id=G-W6R732RQ9Q"></script>
			 <script type="text/partytown">
				 window.dataLayer = window.dataLayer || [];
				 function gtag(){dataLayer.push(arguments);}
				 gtag('js', new Date());
		
				 gtag('config', 'G-W6R732RQ9Q');
			 </script>
	</head>

	<body class="bg-gris ">
		<Analytics />
		{usuario ? (
					<ControlStaff>
		
		
		
			{/* <AdminHeader /> */}
		

		<main class="p-0 w-full m-0  ">
			        <slot />

		</main>
	
		
			{/* //<!-- <Footer /> --> */}
		
		</ControlStaff>
		) : (
					
					<SinSession />
				)}

		
    
	
		

	
		
	</body>

</html>
