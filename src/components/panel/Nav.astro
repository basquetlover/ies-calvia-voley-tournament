---
import { Menu } from 'src/const/menuPanel';
type Nivel =  0 | 1 | 2 | 3;

type MenuItem = {
    nombre: string;
    id: string;
    ruta: string;
    nivel_seguridad: Nivel;
    icono: string;
};


interface Props{
    usuario: {
        nombre: string;
        email: string;
        nivel_seguridad: 0 | 1 | 2 | 3;
    };
}   

const usuario = Astro.props.usuario;


const url = new URL(Astro.request.url);
const urlSearch = `?torneoID=${url.searchParams.get("torneoID")}`;


// Tipar secciones correctamente
const secciones: Record<Nivel, { titulo: string; items: MenuItem[] }> = {
    0: { titulo: "Funciones básicas", items: [] },
    1: { titulo: "Funciones básicas", items: [] },
    2: { titulo: "Gestión", items: [] },
    3: { titulo: "Administración", items: [] }
};

// Agrupar
Menu.forEach((item: MenuItem) => {
    if (item.nivel_seguridad <= usuario.nivel_seguridad) {
        secciones[item.nivel_seguridad].items.push(item);
    }
});

// Orden personalizado
const orden: Nivel[] = [0, 2, 1, 3];

const urlActual = new URL(Astro.request.url);
const pathname = urlActual.pathname;
---

<div class="w-56 h-screen overflow-x-hidden no-scrollbar flex flex-col bg-gris-claro">
    <div class="w-full  p-4">
        <!-- <img src="/img/logo_torneo.png" alt="Logo" class="w-28 h-28 mx-auto my-4" /> -->
        <h2 class="text-azul-claro text-3xl font-semibold text-center">Zona Staff</h2>
    </div>
    {orden.map((nivel, index) => {
        const seccion = secciones[nivel];

        if (seccion.items.length === 0) return null;

        return (
            <nav class=" p-2">
                <div class={`bg-gray-500 mb-2 h-px w-full `}>&nbsp;</div>
                <div class="flex flex-col gap-y-2">
                    {seccion.items.map((item) => (
                        <a 
                            href={item.ruta + urlSearch} 
                            class={`px-4 py-2 font-semibold relative flex flex-row items-center gap-2 transition hover:bg-azul-claro/50 ${pathname === item.ruta ? 'bg-azul-claro/15 text-azul-claro' : ''}`}
                        >
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" class={`w-6 h-6 bg-transparent ${pathname === item.ruta ? 'fill-azul-claro' : 'fill-blanco'}`} viewBox="0 -960 960 960" set:html={item.icono}>
                                    
                                </svg>
                            </span>
                            {item.nombre}
                            <span class={`w-1 h-full absolute top-0 right-0 bg-azul-claro ${pathname === item.ruta ? 'block' : 'hidden'}`}>&nbsp;</span>
                        </a>
                    ))}
                </div>
            </nav>
        );
    })}

</div>

