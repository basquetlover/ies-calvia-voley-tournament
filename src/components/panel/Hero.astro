---
import { supabaseAdmin } from "src/lib/supabase";

const { data: ConfTorneo } = await supabaseAdmin
  .from('Configuracion')
  .select('id_torneo, fecha, nombre, estado')
  .order('fecha', { ascending: false });

// URL actual
const url = new URL(Astro.request.url);
const torneoID = url.searchParams.get('torneoID');

// torneo por defecto (más reciente)
const torneoSeleccionado =
  ConfTorneo?.find(t => t.id_torneo === torneoID) ?? ConfTorneo?.[0];
---

<div class="flex items-center max-md:justify-end md:justify-between mr-2 w-full">
  
  <!-- TÍTULO -->
  <h2 class="text-azul-claro max-md:hidden text-2xl font-semibold">
    Tauler de Control
  </h2>

  <!-- DROPDOWN -->
  <div class="relative">

    <!-- BOTÓN -->
    <button
      id="torneoBtn"
      data-id={torneoSeleccionado?.id_torneo}
      class="px-4 py-2 bg-gris-claro rounded flex items-center gap-2"
    >
      <span id="torneoText" class="flex flex-row">
        {
            torneoSeleccionado?.estado === "Finalitzat" && (
              <>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#e3e3e3" viewBox="0 -960 960 960">
                <path d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920t141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80zm0-80h480v-400H240zm296.5-143.5Q560-327 560-360t-23.5-56.5T480-440t-56.5 23.5T400-360t23.5 56.5T480-280t56.5-23.5M360-640h240v-80q0-50-35-85t-85-35-85 35-35 85zM240-160v-400z"/>
              </svg>
              </>
            )
          }
        {torneoSeleccionado?.nombre ?? "Selecciona torneig"}
      </span>

      <!-- Flecha -->
      <svg
        id="arrowIcon"
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4 transition-transform duration-200"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M6 9l6 6 6-6" />
      </svg>
    </button>

    <!-- LISTA -->
    <div
      id="torneoList"
      class="hidden absolute right-0 mt-2 w-64 bg-gris-claro shadow-lg rounded z-50 overflow-hidden"
    >
      {ConfTorneo?.map(t => (
        <button
          data-id={t.id_torneo}
          class="w-full flex flex-row text-left px-4 py-2 hover:bg-azul-claro/20 cursor-pointer"
        >
          {
            t.estado === "Finalitzat" && (
              <>
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#e3e3e3" viewBox="0 -960 960 960">
                <path d="M240-80q-33 0-56.5-23.5T160-160v-400q0-33 23.5-56.5T240-640h40v-80q0-83 58.5-141.5T480-920t141.5 58.5T680-720v80h40q33 0 56.5 23.5T800-560v400q0 33-23.5 56.5T720-80zm0-80h480v-400H240zm296.5-143.5Q560-327 560-360t-23.5-56.5T480-440t-56.5 23.5T400-360t23.5 56.5T480-280t56.5-23.5M360-640h240v-80q0-50-35-85t-85-35-85 35-35 85zM240-160v-400z"/>
              </svg>
              </>
            )
          }
          {t.nombre}
        </button>
      ))}
    </div>

  </div>


</div>

<script>
const btn = document.getElementById('torneoBtn');
const list = document.getElementById('torneoList');
const arrow = document.getElementById('arrowIcon');

let open = false;

// abrir / cerrar dropdown
btn?.addEventListener('click', (e) => {
  e.stopPropagation();

  open = !open;
  list?.classList.toggle('hidden');
  arrow?.classList.toggle('rotate-180');
});

// cerrar al click fuera
document.addEventListener('click', () => {
  if (!open) return;

  open = false;
  list?.classList.add('hidden');
  arrow?.classList.remove('rotate-180');
});

// seleccionar torneo
list?.querySelectorAll('button[data-id]').forEach((item) => {
  const el = item as HTMLElement;

  el.addEventListener('click', () => {
    const id = el.dataset.id!;

    const url = new URL(window.location.href);
    url.searchParams.set('torneoID', id);

    window.location.href = url.toString();
  });
});

// asegurar torneo por defecto en URL
const params = new URLSearchParams(window.location.search);
const hasTorneo = params.get('torneoID');

if (!hasTorneo && btn?.dataset.id) {
  const url = new URL(window.location.href);
  url.searchParams.set('torneoID', btn.dataset.id);
  window.location.replace(url.toString());
}
</script>