---
import { supabaseAdmin } from "src/lib/supabase";
import { Paginas } from "src/const/menuPanel";

const url = new URL(Astro.request.url);
const torneoID = url.searchParams.get('torneoID');
const pathname = url.pathname;
const accion = url.searchParams.get("accio")
const usuario_admin = Astro.props;
const usuario = usuario_admin.usuario;

const { data: ConfTorneo } = await supabaseAdmin
  .from('Configuracion')
  .select('fecha, nombre, estado')
  .eq('id_torneo', torneoID)
  .single();

let estadoTorneo;

if(ConfTorneo){
    if(ConfTorneo.estado === "Finalitzat" ){
        estadoTorneo = ConfTorneo.estado
    }
}


const menuItem = Paginas.find((item) => item.ruta === pathname);

if (!menuItem) {
throw new Error("Ruta no encontrada: " + pathname);
}

// 🔥 FIX JSONB STRING/OBJECT
const permisos_panel =
typeof usuario.permisos_panel === "string"
    ? JSON.parse(usuario.permisos_panel)
    : usuario.permisos_panel;

const tieneNivel =
usuario.nivel_seguridad >= (menuItem.nivel_seguridad ?? 0);
// permisos base de la página
const permisosPagina = permisos_panel?.[menuItem.id] || {};
let puedeVer = true;
let puedeEditar = true;
if(accion){
// permiso VER
 puedeVer =
  tieneNivel &&
  permisosPagina?.ver === true;

  // permiso EDITAR
 puedeEditar =
  tieneNivel &&
  permisosPagina?.editar === true;
}





---
<div class="w-full">
{
    estadoTorneo === "Finalitzat" && (
        <div class="w-full bg-azul-claro/40 text-blanco text-sm max-md:text-xs flex flex-row items-center place-content-center gap-x-1 font-extralight py-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-blanco" viewBox="0 -960 960 960">
                <path d="M440-280h80v-240h-80zm68.5-331.5Q520-623 520-640t-11.5-28.5T480-680t-28.5 11.5T440-640t11.5 28.5T480-600t28.5-11.5M480-80q-83 0-156-31.5T197-197t-85.5-127T80-480t31.5-156T197-763t127-85.5T480-880t156 31.5T763-763t85.5 127T880-480t-31.5 156T763-197t-127 85.5T480-80m0-80q134 0 227-93t93-227-93-227-227-93-227 93-93 227 93 227 227 93m0-320"/>
            </svg>
            Aquest torneig està finalitzat i no es poden fer modificacions. Per continuar editant la informació, cal canviar l'estat del torneig.
        </div>
    )
}

{
!puedeEditar && (
    <div class="w-full bg-orange-500/20 text-orange-300 text-sm max-md:text-xs flex flex-row items-center place-content-center gap-x-1 font-extralight py-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-orange-300" viewBox="0 -960 960 960">
            <path d="m40-120 440-760 440 760zm138-80h604L480-720zm330.5-51.5Q520-263 520-280t-11.5-28.5T480-320t-28.5 11.5T440-280t11.5 28.5T480-240t28.5-11.5M440-360h80v-200h-80zm40-100"/>
        </svg>
        Només tens permisos de visualització en aquesta secció.
    </div>
)
}
</div>