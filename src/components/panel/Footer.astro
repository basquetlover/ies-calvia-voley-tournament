---
import { verificarAdminSesion } from "src/lib/usuario_panel";

const usuario_admin = await verificarAdminSesion(Astro.request);
---
<footer class="w-full border-t border-gray-800 bg-[#1B1D20] text-white px-6 py-3 text-sm">
<div class="flex flex-col md:flex-row items-center justify-between gap-2">

    <!-- IZQUIERDA -->
    <div class="flex flex-col md:flex-row md:items-center gap-1 md:gap-4 text-gray-400">
    <span class="text-white font-medium">
        IES Calvià Voley Tournament
    </span>
    <span class="hidden md:inline">·</span>
    <span>Versió v1.0.0</span>
    <span class="hidden md:inline">·</span>
    <span>Edició activa: Nadal 2024</span>
    </div>

    <!-- CENTRO (STATUS SISTEMA) -->
    <!-- <div class="flex items-center gap-2 text-gray-300">
    <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
    <span>Sistema operatiu</span>
    </div> -->

    <!-- DERECHA (USUARIO) -->
    <div class="flex items-center gap-3 text-gray-400">
    <span>
        Usuari: <span class="text-white">{usuario_admin?.email}</span>
    </span>
    <span class="hidden md:inline">·</span>
    <span class="text-gray-300">Rol: <span class="text-blanco">{usuario_admin?.rango}</span></span>
    </div>

</div>
</footer>