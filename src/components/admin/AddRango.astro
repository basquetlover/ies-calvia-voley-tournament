<style>
    .centrar {
        z-index: 0;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .formulario{
        z-index: 10000;
    }
    .form{
        
        position: absolute;
        top: -20px;
        left: 20px;
    }
    
    .div {
	
	width: max-content;
    max-width: 350px;
	min-height: 80px;
	height: max-content;
    margin: 5px auto;
   
	border-radius: 10px;
	display: grid;
	grid-template-columns: max-content 1fr;
	grid-template-rows: 1fr;
	align-items: center;
	gap: 10px;
	padding: 5px 10px;

  }

  .error {
 	background-color: rgba(168, 52, 52, 0.6);
 	border: 3px solid #A83434;
  }

  .fill-error {
 	fill: #BA3A3A;
  }

  .warning {
	background-color: rgba(237, 102, 19, 0.5);
 	border: 3px solid #ED6613;
    color: white;
  }

  .fill-warning {
    height: 30px;
    width: 30px;
 	fill: #ED6613;
  }

    
</style>
