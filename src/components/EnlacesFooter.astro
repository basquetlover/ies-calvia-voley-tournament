---
import { ENLACES } from "@const/enlaces"
---

<section class=" w-full h-max xs:row-start-2 sm:row-start-2  md:row-start-1 md:col-start-2 flex flex-col place-items-center justify-center transform transition-transform duration-300 ease-in-out scale-100 xs:scale-90 sm:scale-90 md:scale-90 ">
    <h4 class="text-accent text-3xl font-semibold uppercase my-2">Enllaços</h4>
    <nav class="flex flex-col h-max">
        {
            ENLACES.map(({nombre, href}) => (
                <a href={href} class={`text-blanco text-2xl max-h-13 my-1 h-auto p-1 group hover:text-amarillo flex flex-row content-center items-center duration-300 ${!href ? ' hover:text-red-700' : ''}`}>
                    {nombre}
                    <span class="w-6 h-6 ml-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                        {href && href.trim() !== "" ?  (
                            <svg class="w-6 h-6 fill-amarillo" xmlns="http://www.w3.org/2000/svg"  viewBox="0 -960 960 960" >
                                 <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"/>
                            </svg>
                    
                        ) : (
                            <svg class="w-5 h-5 fill-red-700" xmlns="http://www.w3.org/2000/svg"  viewBox="0 -960 960 960">
                                 <path d="M480-80q-83 0-156-31t-127-86q-54-54-85-127T80-480q0-83 32-156t85-127q54-54 127-85t156-32q83 0 156 32t127 85q54 54 86 127t31 156q0 83-31 156t-86 127q-54 54-127 86T480-80Zm0-80q54 0 104-17t92-51L228-676q-33 42-50 92t-18 104q0 134 93 227t227 93Zm252-124q33-42 51-92t17-104q0-134-93-227t-227-93q-54 0-104 18t-92 50l448 448Z"/>
                            </svg>
                         )}
                    
                    </span>
                </a>
                
            ))
        }
        <a href="/cookies" target="_blank" class="text-blanco text-2xl max-h-13 my-1 h-auto p-1 group hover:text-amarillo flex flex-row content-center items-center duration-300">
            Avís Legal
            <span class="w-6 h-6 ml-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300"> 
                <svg class="w-6 h-6 fill-amarillo" xmlns="http://www.w3.org/2000/svg"  viewBox="0 -960 960 960" >
                        <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"/>
                </svg>
            </span>
        </a>
        <div id="conf_cookies" class="text-blanco text-2xl max-h-13 my-1 h-auto p-1 group hover:text-amarillo flex flex-row content-center cursor-pointer items-center duration-300">
            Gestionar Cookies
            <span class="w-6 h-6 ml-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300"> 
                <svg class="w-6 h-6 fill-amarillo" xmlns="http://www.w3.org/2000/svg"  viewBox="0 -960 960 960" >
                        <path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"/>
                </svg>
            </span>
        </div>
    </nav>
</section>
<!--Mensaje cookies -->
<div id="CookiesAlert" class="max-w-xl desaparecido w-auto min-h-60 h-auto fixed bottom-2 left-2 rounded-lg z-50 bg-azul grid grid-cols-[200px_1fr] place-items-center p-2">
    <img src="/img/cookies.png" class="w-48 h-auto" alt="Imatge avis cookies" />
    <div>
        <h2 class="text-4xl text-amarillo font-bold">Cookies</h2>
        <p class="text-base text-blanco">Utilitzem cookies pròpies i de tercers per a millorar els nostres serveis.</p>
        <div class="flex flex-wrap gap-1 items-center place-content-center">
            <div id="todas" class="cursor-pointer text-center px-2 py-1 text-gris font-semibold bg-amarillo rounded-md text-base">
                Acceptar Totes
            </div>
            <div id="esenciales" class="cursor-pointer text-center px-2 py-1 text-gris font-semibold bg-amarillo rounded-md text-base">
                Acceptar les Essencials
            </div>
            <a href="/cookies" target="_blank" class="cursor-pointer text-center px-2 py-1 text-gris font-semibold bg-amarillo rounded-md text-base">
                Avís de cookies
            </a>
        </div>
    </div>
    </div>

    <style>
        .desaparecido{
            display: none;
        }
    </style>
    <script>
         function eliminarAllCookie() {
            // Establece la cookie con el mismo nombre y una fecha de expiración en el pasado
            const nombre = "all_cookies";
            document.cookie = nombre + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
            location.reload();
}
    function eliminarEssencialCookie() {
            // Establece la cookie con el mismo nombre y una fecha de expiración en el pasado
            const nombre = "essencial_cookies";
            document.cookie = nombre + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
            location.reload();
}

        console.log("Script cargado!")
        const CookiesAlert = document.getElementById('CookiesAlert');
        const todas = document.getElementById('todas');
        const esenciales = document.getElementById('esenciales');
    
        todas?.addEventListener('click', function() {
            CookiesAlert?.classList.add('desaparecido');
            
            const cookies = document.cookie;
            if(cookies === "all_cookies=aceptadas"){
                eliminarAllCookie();
            }
            if(cookies === "essencial_cookies=aceptadas"){
                eliminarEssencialCookie();
            }

            document.cookie = "all_cookies=aceptadas; expires=Fri, 31 Dec 2026 23:59:59 GMT; path=/";
        })

        esenciales?.addEventListener('click', function() {
            CookiesAlert?.classList.add('desaparecido');
            
            const cookies = document.cookie;
            if(cookies === "all_cookies=aceptadas"){
                eliminarAllCookie();
            }
            if(cookies === "essencial_cookies=aceptadas"){
                eliminarEssencialCookie();
            }

            document.cookie = "essencial_cookies=aceptadas; expires=Fri, 31 Dec 2026 23:59:59 GMT; path=/";
        })
        
        const btn_conf_cookies = document.getElementById("conf_cookies");
        btn_conf_cookies?.addEventListener('click', function(){
            CookiesAlert?.classList.remove('desaparecido');
            // eliminarAllCookie();
        })

        
    </script>
