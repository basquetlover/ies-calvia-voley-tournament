---
import { ENLACES } from "@const/enlaces"
---

<section class=" w-full h-max flex flex-col place-items-center justify-center transform transition-transform duration-300 ease-in-out scale-100 xs:scale-90 sm:scale-90 md:scale-90 ">
    <h4 class="text-accent text-3xl font-semibold uppercase my-2">Enlaces</h4>
    <nav class="flex flex-col">
        {
            ENLACES.map(({nombre, href}) => (
                <a href={href} class="text-blanco text-2xl max-h-6 my-1 p-1 group hover:text-amarillo duration-300 flex flex-row content-center">
                    {nombre}
                    <span class="w-6 h-6 ml-1 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                    <svg class="w-6 h-6 fill-amarillo" xmlns="http://www.w3.org/2000/svg"  viewBox="0 -960 960 960" ><path d="M647-440H160v-80h487L423-744l57-56 320 320-320 320-57-56 224-224Z"/></svg>
                </span>
                </a>
                
            ))
        }
    </nav>
</section>