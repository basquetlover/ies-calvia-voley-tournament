---
const email = "voley_tournament@iescalvia.com"
---
<section class=" w-full h-max flex flex-col place-items-center justify-center transform transition-transform duration-300 ease-in-out scale-100 xs:scale-75 sm:scale-75 md:scale-90 xs:col-span-2 sm:col-span-2 md:col-span-1 ">
    <h4 class="text-accent text-3xl whitespace-nowrap font-semibold uppercase my-2">Organitzat per </h4>
    <div class="max-w-[500px] w-full h-auto grid grid-cols-2 grid-rows-1 gap-1">
        <a>
            <img src="/img/team-teto.png" loading="lazy" alt="TEAM Teto" />
        </a>
        <a href="https://sites.google.com/iescalvia.com/iescalvia/inici" target="_blank" class="hover:cursor-pointer">
            <img src="/img/ies-calvia.png" loading="lazy" alt="IES Calvià" />
        </a>
    </div>
    <a href={`https://mail.google.com/mail/?view=cm&fs=1&to=${email}`} target="_blank"  class="flex flex-row place-content-center items-center m-2 relative">
        <!-- <svg class="fill-blanco w-[30px] h-auto"  viewBox="0 -960 960 960">
            <path d="M160-160q-33 0-56-23t-24-57v-480q0-33 24-56t56-24h640q33 0 57 24t23 56v480q0 33-23 57t-57 23H160Zm320-280L160-640v400h640v-400L480-440Zm0-80 320-200H160l320 200ZM160-640v-80 480-400Z"/>
        </svg> -->
        <p class="text-blanco  text-lg ">{email}</p>
        
        <div class="tooltip">Enviar email</div>
    </a>
</section>

<style>
    .tooltip {
  position: absolute;
  top: -30px;
  left: 50%;
  transform: translateX(-50%);
  background-color: #313131; /* White background */
  color: #1666FF; /* Black text */
  padding: 6px 10px;
  border-radius: 5px;
  opacity: 0;
  visibility: hidden;
  font-size: 14px;
  transition: all 0.3s ease;
  font-weight: normal; /* Made bolder */
}
    a:hover .tooltip {
  opacity: 1;
  visibility: visible;
  top: -50px;
}
</style>