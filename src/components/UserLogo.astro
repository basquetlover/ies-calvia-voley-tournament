---
import { verificarSesion } from 'src/lib/session';

const usuario = await verificarSesion(Astro.request);
const nombre = usuario.nombre;
const color =  usuario.logo;
let img = "";
img = usuario.admin_perfil;
console.log(img)
let primeraLetra = ""
if (nombre) {
     primeraLetra = nombre.charAt(0); // O también puedes usar nombre[0]
    
} else {
    console.log("El nombre está vacío");
}
---
<div class={`w-full h-full flex items-center place-content-center relative uppercase p-2 text-xl text-blanco rounded-full ${img != "" ? `bg-[url(${img})]` : `${color}` } `}>
    {img != "" ?
    (<>
    <img src={img} class="w-full h-full rounded-full scale-125"/>
    </>):(
        <>
        <p>{primeraLetra}</p>
        </>
    )}
    
    
</div>
