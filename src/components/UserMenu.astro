---
import { verificarSesion } from "src/lib/session";
import { supabaseAdmin } from "src/lib/supabase";

const usuario = await verificarSesion(Astro.request);
let equipo = "Sense Equip"
let escudo = "/img/escudos/sin-escudo-blanco.png"
let inscripcion = false;
let admin = false;
let profesor = false;
let equipo_id = "";
let modificar = false;
let accesoModificar = true;
let voluntario = false;
const usuario_email = usuario.email;
if (usuario) {

    // =========================
    // VARIABLES
    // =========================

    // =========================
    // PROFESOR
    // =========================
    if (usuario.curso === "Professor") {
        profesor = true;
    }

    // =========================
    // ADMIN (desde usuario.rango)
    // =========================
    if (usuario.rango) {
        admin = true;

        console.log(`👑 Usuario con rango: ${usuario.rango}`);
    }

    // =========================
    // ACCESO INSCRIPCIÓN
    // =========================
    const { data: accesoInscripcion } = await supabaseAdmin
        .from('AccesoUsuarios')
        .select('acceso')
        .eq('pagina', '/usuario/inscripcion')
        .single();

    if (accesoInscripcion?.acceso) {
        inscripcion = true;
    }

    // =========================
    // ACCESO MODIFICACIÓN
    // =========================
    const { data: accesoModificar } = await supabaseAdmin
        .from('AccesoUsuarios')
        .select('acceso')
        .eq('pagina', '/usuario/modificar')
        .single();

    if (accesoModificar?.acceso) {
        modificar = true;
    }

    // =========================
    // VOLUNTARIO
    // =========================
    const { data: voluntarioData } = await supabaseAdmin
        .from('Voluntarios')
        .select('tipo, estado')
        .eq('email', usuario_email)
        .single();

    if (voluntarioData) {
        voluntario = true;
    }

    // =========================
    // JUGADOR
    // =========================
    const { data: jugador } = await supabaseAdmin
        .from('JugadoresSS')
        .select('pertenece_equipo')
        .eq('email', usuario_email)
        .single();

    // =========================
    // SI NO ES JUGADOR
    // =========================
    if (!jugador) {

        if (admin) {
            equipo = "IES Calvià Voley Team";
            escudo = "/web-app-manifest-192x192.png";
        }

    } else {

        // =========================
        // EQUIPO
        // =========================
        const { data: equipoData } = await supabaseAdmin
            .from('EquiposSS')
            .select(`
                nombre_equipo,
                escudo,
                id_equipo,
                inscrito,
                estado,
                email_capitan,
                capitan_edit
            `)
            .eq('id', jugador.pertenece_equipo)
            .single();

        if (equipoData) {

            equipo_id = equipoData.id_equipo;
            equipo = equipoData.nombre_equipo;
            escudo = equipoData.escudo;
            inscripcion = true;

            // =========================
            // PERMISOS DE MODIFICACIÓN
            // =========================
            if (
                equipoData.inscrito === usuario.id ||
                (
                    equipoData.capitan_edit === "si_edit" &&
                    equipoData.email_capitan === usuario.email
                )
            ) {
                modificar = true;
            }
        }
    }
}
